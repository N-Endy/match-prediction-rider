@page "/valuebets"
@model MatchPredictor.Web.Pages.ValueBetsModel
@{
    ViewData["Title"] = "Tennis Value Bets";
}

<div class="mp-container">
    <div class="mp-header-area">
        <h1 class="mp-page-title">🎯 Tennis Value Bets</h1>
        <h3 class="mp-page-subtitle">Model-vs-market edges for bookable tennis selections with matched live pricing.</h3>
    </div>

    <!-- AI Loading State -->
    <div id="aiLoadingState" style="text-align: center; padding: 4rem 1rem;">
        <div style="display: flex; justify-content: center; margin-bottom: 1.5rem;">
            <div class="mp-spinner"></div>
        </div>
        <h3>Comparing calibrated tennis probabilities against live market pricing...</h3>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Only markets with a matched SportyBet price make it into the report.</p>
    </div>

    <!-- No Bets State -->
    <div id="noBetsState" style="display: none; text-align: center; padding: 4rem 1rem; background: var(--card-bg); border-radius: 12px; border: 1px solid var(--border-color);">
        <h3 style="margin-bottom: 0.5rem;">No Value Bets Right Now</h3>
        <p style="color: var(--text-muted);">We only show tennis selections where the calibrated model clears its threshold and still beats the matched live market by a real edge.</p>
    </div>

    <div id="valueBetsSummary" style="display: none; margin-bottom: 1.5rem;"></div>
    <div id="valueBetsWarnings" style="display: none; margin-bottom: 1rem;"></div>

    <!-- Error State -->
    <div id="errorState" style="display: none; text-align: center; padding: 4rem 1rem; background: #fff3f3; color: #dc3545; border-radius: 12px; border: 1px solid #ffdcdc;">
        <h3 id="errorMessage" style="margin-bottom: 0.5rem; color: #dc3545;">Failed to load Value Bets</h3>
        <p id="errorDescription">There was an error loading value bets. Please refresh the page to try again.</p>
    </div>

    <!-- Results Grid -->
    <div id="valueBetsGrid" style="display: none;" class="mp-grid">
        <!-- Rendered via JS -->
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const loadingState = document.getElementById('aiLoadingState');
            const noBetsState = document.getElementById('noBetsState');
            const errorState = document.getElementById('errorState');
            const errorMessage = document.getElementById('errorMessage');
            const errorDescription = document.getElementById('errorDescription');
            const grid = document.getElementById('valueBetsGrid');
            const warnings = document.getElementById('valueBetsWarnings');

            try {
                const response = await fetch('/api/valuebets');
                
                if (!response.ok) {
                    let serverMessage = 'Failed to load Value Bets data from the server.';
                    try {
                        const errorPayload = await response.json();
                        if (errorPayload?.message) {
                            serverMessage = errorPayload.message;
                        }
                    } catch {
                        // ignore JSON parse failures and use the fallback message
                    }

                    throw new Error(serverMessage);
                }

                const report = await response.json();
                const valueBets = Array.isArray(report?.bets) ? report.bets : [];
                
                loadingState.style.display = 'none';
                renderSummary(report);
                renderWarnings(report);

                if (!valueBets || valueBets.length === 0) {
                    noBetsState.style.display = 'block';
                    return;
                }

                grid.style.display = 'grid';
                grid.style.gap = '1.5rem';
                grid.innerHTML = valueBets.map(bet => {
                    const modelProbString = (bet.mathematicalProbability * 100).toFixed(1) + '%';
                    const marketProbString = (bet.marketProbability * 100).toFixed(1) + '%';
                    const impliedProbString = (bet.impliedProbability * 100).toFixed(1) + '%';
                    const decimalOddsString = Number(bet.decimalOdds || 0).toFixed(2);
                    const expectedValueValue = (bet.expectedValuePercent || 0) * 100;
                    const expectedValueString = `${expectedValueValue >= 0 ? '+' : ''}${expectedValueValue.toFixed(1)}%`;
                    const edgeString = '+' + (bet.edge * 100).toFixed(1) + ' pts';
                    const thresholdString = (bet.thresholdUsed * 100).toFixed(1) + '%';
                    const thresholdSource = (bet.thresholdSource || 'Configured').toLowerCase();
                    const marketKey = bet.predictionCategory || 'MatchWinner';
                    const badgeClass = getBadgeClass(bet.predictionCategory, bet.predictedOutcome);
                    const badgeLabel = getBadgeLabel(bet.predictionCategory);

                    const insightChips = [
                        bet.pricingSource ? `<span class="mp-insight-chip">${escapeHtml(bet.pricingSource)}</span>` : '',
                        bet.oddsFreshness ? `<span class="mp-insight-chip">${escapeHtml(bet.oddsFreshness)}</span>` : '',
                        bet.oddsDerivationSource ? `<span class="mp-insight-chip">${escapeHtml(bet.oddsDerivationSource)}</span>` : '',
                        bet.edgeSource ? `<span class="mp-insight-chip">${escapeHtml(bet.edgeSource)}</span>` : ''
                    ].filter(Boolean).join('');

                    return `
                        <div class="mp-prediction-card" style="flex-direction: column; align-items: stretch; gap: 1rem; position: relative; overflow: hidden; border-top: 4px solid var(--accent-blue);">
                            
                            <!-- Top Row: Standard Match Info -->
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; width: 100%; gap: 1rem;">
                                <div class="mp-match-info">
                                    <div class="mp-match-league">
                                        ${bet.league}
                                        <span class="mp-time">${bet.kickoffTime}</span>
                                    </div>
                                    <div class="mp-match-teams" style="font-size: 1.15rem; margin-top: 4px;">
                                        ${escapeHtml(bet.homeTeam)}
                                        <span class="mp-vs">vs</span>
                                        ${escapeHtml(bet.awayTeam)}
                                    </div>
                                </div>
                                
                                <div class="mp-card-badges" style="display: flex; flex-direction: column; align-items: flex-end; gap: 10px;">
                                    <span class="mp-prediction-badge ${badgeClass}">${escapeHtml(badgeLabel)}</span>
                                    <button class="mp-add-cart-btn" title="Add Bet"
                                            data-home="${escapeHtml(bet.homeTeam)}"
                                            data-away="${escapeHtml(bet.awayTeam)}"
                                            data-league="${escapeHtml(bet.league)}"
                                            data-market="${escapeHtml(marketKey)}"
                                            data-prediction="${escapeHtml(bet.predictedOutcome)}"
                                            data-prediction-id="${bet.predictionId ? escapeHtml(bet.predictionId) : ''}"
                                            data-match-datetime-utc="${bet.matchDateTimeUtc ? escapeHtml(bet.matchDateTimeUtc) : ''}">
                                        Add Bet
                                    </button>
                                </div>
                            </div>

                            <!-- Bottom Row: AI Insights -->
                            <div style="background: rgba(59, 130, 246, 0.05); border: 1px solid rgba(59, 130, 246, 0.15); border-radius: 8px; padding: 1.25rem; margin-top: 0.5rem;">
                                ${insightChips ? `<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">${insightChips}</div>` : ''}
                                
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); margin-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 1rem; gap: 0.75rem;">
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Pick</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${escapeHtml(bet.predictedOutcome)}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">EV</div>
                                        <div style="color: #10b981; font-weight: 800; font-size: 1.1rem;">${expectedValueString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Odds</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${decimalOddsString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Model</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${modelProbString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Market</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${marketProbString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Implied</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${impliedProbString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Edge</div>
                                        <div style="color: #10b981; font-weight: 700; font-size: 1.05rem;">${edgeString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Threshold</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${thresholdString}</div>
                                        <div style="font-size: 0.8rem; color: var(--text-muted);">${thresholdSource}</div>
                                    </div>
                                </div>

                                <div style="font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary); display: flex; gap: 12px; align-items: flex-start;">
                                        <span style="font-size: 1.4rem; line-height: 1;">🎾</span>
                                        <em style="font-style: italic;">"${escapeHtml(bet.aiJustification || '')}"</em>
                                    </div>
                                </div>

                        </div>
                    `;
                }).join('');

            } catch (error) {
                console.error('Value Bets Error:', error);
                loadingState.style.display = 'none';
                errorMessage.textContent = 'Failed to load Value Bets';
                errorDescription.textContent = error?.message || 'There was an error loading value bets. Please refresh the page to try again.';
                errorState.style.display = 'block';
            }

            function renderWarnings(report) {
                const warningItems = Array.isArray(report?.warnings) ? report.warnings.filter(Boolean) : [];
                if (!warnings || warningItems.length === 0) {
                    return;
                }

                warnings.innerHTML = warningItems.map(message => `
                    <div class="mp-analytics-note" style="border-left: 4px solid #f59e0b; background: rgba(245, 158, 11, 0.08); margin-bottom: 0.75rem;">
                        ${escapeHtml(message)}
                    </div>
                `).join('');
                warnings.style.display = 'block';
            }
        });

        function escapeHtml(value) {
            return String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        function getBadgeLabel(predictionCategory) {
            switch (predictionCategory) {
                case 'MatchWinner':
                    return 'Match Winner';
                case 'OverUnderSets':
                    return 'Over / Under Sets';
                case 'SetHandicap':
                    return 'Set Handicap';
                default:
                    return predictionCategory || 'Selection';
            }
        }

        function getBadgeClass(predictionCategory, predictedOutcome) {
            if (predictionCategory === 'MatchWinner') {
                return predictedOutcome === 'Away Win' ? 'mp-badge-win-away' : 'mp-badge-win-home';
            }

            if (predictionCategory === 'OverUnderSets') {
                return predictedOutcome === 'Under 2.5 Sets' ? 'mp-badge-under' : 'mp-badge-over';
            }

            return 'mp-badge-combined';
        }

        function renderSummary(report) {
            const summary = document.getElementById('valueBetsSummary');
            if (!summary || !report) {
                return;
            }

            const generatedAt = report.generatedAtLocal
                ? new Date(report.generatedAtLocal).toLocaleString()
                : 'Awaiting fresh analysis';
            const exclusionCards = Array.isArray(report.exclusionBreakdown)
                ? report.exclusionBreakdown.map(item => `
                    <div class="mp-stat-card" style="text-align: left; padding: 1rem;">
                        <div class="mp-stat-label">${escapeHtml(item.label || 'Excluded')}</div>
                        <div class="mp-stat-value mp-stat-value-compact" style="justify-content: flex-start;">${Number(item.count || 0)}</div>
                        <div style="color: var(--text-muted); font-size: 0.82rem; line-height: 1.5;">${escapeHtml(item.description || '')}</div>
                    </div>
                `).join('')
                : '';

            summary.innerHTML = `
                <div class="mp-stat-grid" style="margin-bottom: 1rem;">
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">Markets Considered</div>
                        <div class="mp-stat-value mp-stat-figure">${Number(report.consideredCandidateCount || 0)}</div>
                    </div>
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">Value Bets Returned</div>
                        <div class="mp-stat-value mp-stat-figure">${Number(report.includedCandidateCount || 0)}</div>
                    </div>
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">Report Freshness</div>
                        <div class="mp-stat-value mp-stat-value-compact" style="font-size: 1.05rem;">${escapeHtml(generatedAt)}</div>
                    </div>
                </div>
                <div class="mp-analytics-note" style="margin-bottom: 1rem;">
                    We only surface tennis selections that clear the publish threshold and still beat the matched live market by a real edge. Markets only appear when the exact SportyBet fixture and line can be priced.
                </div>
                ${exclusionCards ? `<div class="mp-stat-grid">${exclusionCards}</div>` : ''}
            `;

            summary.style.display = 'block';
        }
    </script>
    
    <style>
        .mp-spinner {
            width: 3.5rem;
            height: 3.5rem;
            border: 0.25em solid rgba(59, 130, 246, 0.2);
            border-right-color: #3b82f6;
            border-radius: 50%;
            animation: mp-spin 0.8s linear infinite;
        }
        
        @@keyframes mp-spin {
            to { transform: rotate(360deg); }
        }
    </style>
}
