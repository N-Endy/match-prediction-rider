@page "/valuebets"
@model MatchPredictor.Web.Pages.ValueBetsModel
@{
    ViewData["Title"] = "AI Value Bets";
}

<div class="mp-container">
    <div class="mp-header-area">
        <h1 class="mp-page-title">🎯 AI Value Bets</h1>
        <h3 class="mp-page-subtitle">Calibrated model-vs-market edges, with short AI notes layered on top.</h3>
    </div>

    <section class="mp-valuebets-guide">
        <article class="mp-valuebets-guide-card">
            <h3>How to use this page</h3>
            <p>Start with the overall read. <strong>Strong</strong> means the recent sample and closing-line movement support normal-sized bets. <strong>Caution</strong> means lighter staking. <strong>Avoid</strong> means pass and let the evidence improve.</p>
        </article>
        <details class="mp-valuebets-guide-card" open>
            <summary>Common terms</summary>
            <div class="mp-valuebets-term-grid">
                <article class="mp-valuebets-term-card">
                    <strong>EV</strong>
                    <span>The model edge over the market price. Higher is better.</span>
                </article>
                <article class="mp-valuebets-term-card">
                    <strong>CLV</strong>
                    <span>How your publish price compared to the closing market price. Positive is usually a healthy sign.</span>
                </article>
                <article class="mp-valuebets-term-card">
                    <strong>ROI / Yield</strong>
                    <span>Profit per unit staked across settled bets. Positive is good, but sample size matters.</span>
                </article>
                <article class="mp-valuebets-term-card">
                    <strong>Max Drawdown</strong>
                    <span>The worst bankroll drop from a previous peak. It shows how rough the ride can get.</span>
                </article>
                <article class="mp-valuebets-term-card">
                    <strong>¼-Kelly</strong>
                    <span>Suggested stake as a share of your bankroll when the model has an edge. Same formula as Analytics quarter-Kelly ROI. Enter your bankroll below to see units.</span>
                </article>
                <article class="mp-valuebets-term-card">
                    <strong>Threshold</strong>
                    <span>The minimum model probability needed before a pick can be published.</span>
                </article>
                <article class="mp-valuebets-term-card">
                    <strong>Calibrator</strong>
                    <span>The probability-correction layer, such as Bucket or Beta, used before the pick is shown.</span>
                </article>
            </div>
        </details>
    </section>

    <!-- AI Loading State -->
    <div id="aiLoadingState" style="text-align: center; padding: 4rem 1rem;">
        <div style="display: flex; justify-content: center; margin-bottom: 1.5rem;">
            <div class="mp-spinner"></div>
        </div>
        <h3>🧠 AI is analyzing the top value plays...</h3>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Comparing calibrated model probabilities against source market pricing.</p>
    </div>

    <!-- No Bets State -->
    <div id="noBetsState" style="display: none; text-align: center; padding: 4rem 1rem; background: var(--card-bg); border-radius: 12px; border: 1px solid var(--border-color);">
        <h3 style="margin-bottom: 0.5rem;">No Value Bets Right Now</h3>
        <p style="color: var(--text-muted);">We only show markets where the calibrated model clears its threshold and still beats the source market by a real edge.</p>
    </div>

    <div id="valueBetsSummary" style="display: none; margin-bottom: 1.5rem;"></div>
    <div id="valueBetsWarnings" style="display: none; margin-bottom: 1rem;"></div>

    <div id="valueBetsBankrollBar" class="mp-valuebets-bankroll" style="display: none; margin-bottom: 1.25rem; padding: 1rem 1.15rem; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 10px;">
        <label for="valueBetsBankrollInput" style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.65rem; font-weight: 600; color: var(--text-primary);">
            Bankroll (units)
            <input id="valueBetsBankrollInput" type="number" min="1" step="1" value="100" inputmode="decimal"
                   style="width: 7rem; padding: 0.4rem 0.55rem; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-primary, #0f172a); color: var(--text-primary);" />
        </label>
        <p class="mp-switch-caption" style="margin: 0.4rem 0 0;">
            Suggested stakes use the same quarter-Kelly formula as Analytics. This number stays in your browser — it is not your bookmaker balance.
        </p>
    </div>

    <!-- Error State -->
    <div id="errorState" style="display: none; text-align: center; padding: 4rem 1rem; background: #fff3f3; color: #dc3545; border-radius: 12px; border: 1px solid #ffdcdc;">
        <h3 id="errorMessage" style="margin-bottom: 0.5rem; color: #dc3545;">Failed to load Value Bets</h3>
        <p id="errorDescription">There was an error loading value bets. Please refresh the page to try again.</p>
    </div>

    <!-- Results Grid -->
    <div id="valueBetsGrid" style="display: none;" class="mp-grid">
        <!-- Rendered via JS -->
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const BANKROLL_STORAGE_KEY = 'mp.valueBets.bankrollUnits';
            const DEFAULT_BANKROLL = 100;

            const loadingState = document.getElementById('aiLoadingState');
            const noBetsState = document.getElementById('noBetsState');
            const errorState = document.getElementById('errorState');
            const errorMessage = document.getElementById('errorMessage');
            const errorDescription = document.getElementById('errorDescription');
            const grid = document.getElementById('valueBetsGrid');
            const warnings = document.getElementById('valueBetsWarnings');
            const bankrollBar = document.getElementById('valueBetsBankrollBar');
            const bankrollInput = document.getElementById('valueBetsBankrollInput');

            let cachedValueBets = [];

            function readStoredBankroll() {
                const raw = localStorage.getItem(BANKROLL_STORAGE_KEY);
                const parsed = Number(raw);
                return Number.isFinite(parsed) && parsed > 0 ? parsed : DEFAULT_BANKROLL;
            }

            function writeStoredBankroll(value) {
                localStorage.setItem(BANKROLL_STORAGE_KEY, String(value));
            }

            function getBankrollUnits() {
                const parsed = Number(bankrollInput?.value);
                return Number.isFinite(parsed) && parsed > 0 ? parsed : DEFAULT_BANKROLL;
            }

            function formatKellyStake(bet, bankroll) {
                const fraction = Number(bet.kellyStakeFraction);
                if (!Number.isFinite(fraction) || fraction <= 0) {
                    return { percent: '0.0%', units: '0.00u', color: 'var(--text-muted)' };
                }

                const percent = (fraction * 100).toFixed(1) + '%';
                const units = (fraction * bankroll).toFixed(2) + 'u';
                return { percent, units, color: '#10b981' };
            }

            function renderValueBetCards(valueBets, bankroll) {
                grid.innerHTML = valueBets.map(bet => {
                    const modelProbString = formatRate(bet.mathematicalProbability);
                    const marketProbString = formatRate(bet.marketProbability);
                    const impliedProbString = formatRate(bet.impliedProbability);
                    const decimalOddsString = Number(bet.decimalOdds || 0).toFixed(2);
                    const expectedValueString = formatSignedPercent(bet.expectedValuePercent);
                    const edgeString = formatSignedPoints(bet.edge);
                    const kelly = formatKellyStake(bet, bankroll);
                    const thresholdString = formatRate(bet.thresholdUsed);
                    const thresholdSource = (bet.thresholdSource || 'Configured').toLowerCase();
                    const calibratorUsed = bet.calibratorUsed || 'Bucket';
                    const settledState = getSettledState(bet);
                    const realizedReturnString = bet.realizedReturnPercent == null
                        ? 'Open'
                        : formatSignedPercent(bet.realizedReturnPercent);
                    const clvString = bet.closingLineValuePercent == null
                        ? 'Pending'
                        : formatSignedPercent(bet.closingLineValuePercent);
                    const marketKey =
                        bet.predictionCategory === 'BothTeamsScore' ? 'BTTS' :
                        bet.predictionCategory === 'Over2.5Goals' ? 'Over2.5' :
                        bet.predictionCategory === 'Under2.5Goals' ? 'Under2.5' :
                        'StraightWin';

                    let badgeClass = 'mp-badge-combined';
                    if (bet.predictionCategory === 'BothTeamsScore') badgeClass = 'mp-badge-btts';
                    else if (bet.predictionCategory === 'Over2.5Goals') badgeClass = 'mp-badge-over';
                    else if (bet.predictionCategory === 'Under2.5Goals') badgeClass = 'mp-badge-under';
                    else if (bet.predictionCategory === 'StraightWin' && bet.predictedOutcome === 'Away Win') badgeClass = 'mp-badge-win-away';
                    else if (bet.predictionCategory === 'StraightWin') badgeClass = 'mp-badge-win-home';

                    const badgeLabel =
                        bet.predictionCategory === 'Over2.5Goals' ? 'Over 2.5' :
                        bet.predictionCategory === 'Under2.5Goals' ? 'Under 2.5' :
                        bet.predictionCategory === 'BothTeamsScore' ? 'BTTS' :
                        bet.predictionCategory === 'StraightWin' ? 'Straight Win' :
                        bet.predictionCategory;

                    const insightChips = [
                        bet.pricingSource ? `<span class="mp-insight-chip">${escapeHtml(bet.pricingSource)}</span>` : '',
                        bet.oddsFreshness ? `<span class="mp-insight-chip">${escapeHtml(bet.oddsFreshness)}</span>` : '',
                        bet.oddsDerivationSource ? `<span class="mp-insight-chip">${escapeHtml(bet.oddsDerivationSource)}</span>` : '',
                        bet.edgeSource ? `<span class="mp-insight-chip">${escapeHtml(bet.edgeSource)}</span>` : '',
                        `<span class="mp-insight-chip">${escapeHtml(calibratorUsed)} calibrator</span>`
                    ].filter(Boolean).join('');

                    return `
                        <div class="mp-prediction-card" style="flex-direction: column; align-items: stretch; gap: 1rem; position: relative; overflow: hidden; border-top: 4px solid var(--accent-blue);">

                            <!-- Top Row: Standard Match Info -->
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; width: 100%; gap: 1rem;">
                                <div class="mp-match-info">
                                    <div class="mp-match-league">
                                        ${bet.league}
                                        <span class="mp-time">${bet.kickoffTime}</span>
                                    </div>
                                    <div class="mp-match-teams" style="font-size: 1.15rem; margin-top: 4px;">
                                        ${escapeHtml(bet.homeTeam)}
                                        <span class="mp-vs">vs</span>
                                        ${escapeHtml(bet.awayTeam)}
                                    </div>
                                </div>

                                <div class="mp-card-badges" style="display: flex; flex-direction: column; align-items: flex-end; gap: 10px;">
                                    <span class="mp-prediction-badge ${badgeClass}">${escapeHtml(badgeLabel)}</span>
                                    <button class="mp-add-cart-btn" title="Add Bet"
                                            data-home="${escapeHtml(bet.homeTeam)}"
                                            data-away="${escapeHtml(bet.awayTeam)}"
                                            data-league="${escapeHtml(bet.league)}"
                                            data-market="${escapeHtml(marketKey)}"
                                            data-prediction="${escapeHtml(bet.predictedOutcome)}"
                                            data-prediction-id="${bet.predictionId ? escapeHtml(bet.predictionId) : ''}"
                                            data-match-datetime-utc="${bet.matchDateTimeUtc ? escapeHtml(bet.matchDateTimeUtc) : ''}">
                                        Add Bet
                                    </button>
                                </div>
                            </div>

                            <!-- Bottom Row: AI Insights -->
                            <div style="background: rgba(59, 130, 246, 0.05); border: 1px solid rgba(59, 130, 246, 0.15); border-radius: 8px; padding: 1.25rem; margin-top: 0.5rem;">
                                ${insightChips ? `<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">${insightChips}</div>` : ''}

                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); margin-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 1rem; gap: 0.75rem;">
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Pick</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${escapeHtml(bet.predictedOutcome)}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">EV</div>
                                        <div style="color: #10b981; font-weight: 800; font-size: 1.1rem;">${expectedValueString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">¼-Kelly</div>
                                        <div style="color: ${kelly.color}; font-weight: 800; font-size: 1.1rem;">${kelly.percent}</div>
                                        <div style="font-size: 0.8rem; color: var(--text-muted);">${kelly.units} suggested</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Odds</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${decimalOddsString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Model</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${modelProbString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Market</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${marketProbString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Implied</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${impliedProbString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Edge</div>
                                        <div style="color: #10b981; font-weight: 700; font-size: 1.05rem;">${edgeString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Threshold</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${thresholdString}</div>
                                        <div style="font-size: 0.8rem; color: var(--text-muted);">${thresholdSource}</div>
                                    </div>
                                </div>

                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; margin-bottom: 1rem;">
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Calibrator</div>
                                        <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;">${escapeHtml(calibratorUsed)}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Settled</div>
                                        <div style="font-weight: 700; color: ${settledState.color}; font-size: 1.05rem;">${settledState.label}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Return</div>
                                        <div style="font-weight: 700; color: ${settledState.returnColor}; font-size: 1.05rem;">${realizedReturnString}</div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">CLV</div>
                                        <div style="font-weight: 700; color: ${getSignedColor(bet.closingLineValuePercent)}; font-size: 1.05rem;">${clvString}</div>
                                    </div>
                                </div>

                                <div style="font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary); display: flex; gap: 12px; align-items: flex-start;">
                                    <span style="font-size: 1.4rem; line-height: 1;">🤖</span>
                                    <em style="font-style: italic;">"${escapeHtml(bet.aiJustification || '')}"</em>
                                </div>
                            </div>

                        </div>
                    `;
                }).join('');
            }

            if (bankrollInput) {
                bankrollInput.value = String(readStoredBankroll());
                bankrollInput.addEventListener('input', () => {
                    const bankroll = getBankrollUnits();
                    writeStoredBankroll(bankroll);
                    if (cachedValueBets.length > 0) {
                        renderValueBetCards(cachedValueBets, bankroll);
                    }
                });
            }

            try {
                const response = await fetch('/api/valuebets');

                if (!response.ok) {
                    let serverMessage = 'Failed to load Value Bets data from the server.';
                    try {
                        const errorPayload = await response.json();
                        if (errorPayload?.message) {
                            serverMessage = errorPayload.message;
                        }
                    } catch {
                        // ignore JSON parse failures and use the fallback message
                    }

                    throw new Error(serverMessage);
                }

                const report = await response.json();
                const valueBets = Array.isArray(report?.bets) ? report.bets : [];

                loadingState.style.display = 'none';
                renderSummary(report);
                renderWarnings(report);

                if (!valueBets || valueBets.length === 0) {
                    noBetsState.style.display = 'block';
                    return;
                }

                cachedValueBets = valueBets;
                if (bankrollBar) {
                    bankrollBar.style.display = 'block';
                }
                grid.style.display = 'grid';
                grid.style.gap = '1.5rem';
                renderValueBetCards(valueBets, getBankrollUnits());

            } catch (error) {
                console.error('Value Bets Error:', error);
                loadingState.style.display = 'none';
                errorMessage.textContent = 'Failed to load Value Bets';
                errorDescription.textContent = error?.message || 'There was an error loading value bets. Please refresh the page to try again.';
                errorState.style.display = 'block';
            }

            function renderWarnings(report) {
                const warningItems = Array.isArray(report?.warnings) ? report.warnings.filter(Boolean) : [];
                if (!warnings || warningItems.length === 0) {
                    return;
                }

                warnings.innerHTML = warningItems.map(message => `
                    <div class="mp-analytics-note" style="border-left: 4px solid #f59e0b; background: rgba(245, 158, 11, 0.08); margin-bottom: 0.75rem;">
                        ${escapeHtml(message)}
                    </div>
                `).join('');
                warnings.style.display = 'block';
            }
        });

        function escapeHtml(value) {
            return String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        function renderSummary(report) {
            const summary = document.getElementById('valueBetsSummary');
            if (!summary || !report) {
                return;
            }

            const performance = report.performanceSummary || {};
            const read = getPerformanceRead(performance);
            const generatedAt = report.generatedAtLocal
                ? new Date(report.generatedAtLocal).toLocaleString()
                : 'Awaiting fresh analysis';
            const exclusionCards = Array.isArray(report.exclusionBreakdown)
                ? report.exclusionBreakdown.map(item => `
                    <div class="mp-stat-card" style="text-align: left; padding: 1rem;">
                        <div class="mp-stat-label">${escapeHtml(item.label || 'Excluded')}</div>
                        <div class="mp-stat-value mp-stat-value-compact" style="justify-content: flex-start;">${Number(item.count || 0)}</div>
                        <div style="color: var(--text-muted); font-size: 0.82rem; line-height: 1.5;">${escapeHtml(item.description || '')}</div>
                    </div>
                `).join('')
                : '';

            summary.innerHTML = `
                <div class="mp-summary-read ${read.shellClass}">
                    <div>
                        <div class="mp-summary-read-label">Current Betting Read</div>
                        <div class="mp-summary-read-title">
                            <span class="mp-read-badge ${read.badgeClass}">${escapeHtml(read.label)}</span>
                        </div>
                        <p>${escapeHtml(read.summary)}</p>
                    </div>
                    <div class="mp-summary-read-meta">
                        <span>${Number(performance.settledBetCount || 0)} settled bets</span>
                        <span>${Number(performance.closingLineSamples || 0)} CLV samples</span>
                    </div>
                </div>
                <div class="mp-stat-grid" style="margin-bottom: 1rem;">
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">Markets Considered</div>
                        <div class="mp-stat-value mp-stat-figure">${Number(report.consideredCandidateCount || 0)}</div>
                    </div>
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">Value Bets Returned</div>
                        <div class="mp-stat-value mp-stat-figure">${Number(report.includedCandidateCount || 0)}</div>
                    </div>
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">Settled Bets</div>
                        <div class="mp-stat-value mp-stat-figure">${Number(performance.settledBetCount || 0)}</div>
                    </div>
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">Win Rate</div>
                        <div class="mp-stat-value mp-stat-figure">${formatRate(performance.winRate)}</div>
                    </div>
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">Net Units</div>
                        <div class="mp-stat-value mp-stat-figure" style="color: ${getSignedColor(performance.netProfitUnits)};">${formatSignedUnits(performance.netProfitUnits)}</div>
                    </div>
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">ROI</div>
                        <div class="mp-stat-value mp-stat-figure" style="color: ${getSignedColor(performance.roiPercent)};">${formatSignedPercent(performance.roiPercent)}</div>
                    </div>
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">Yield</div>
                        <div class="mp-stat-value mp-stat-figure" style="color: ${getSignedColor(performance.yieldPercent)};">${formatSignedPercent(performance.yieldPercent)}</div>
                    </div>
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">Max Drawdown</div>
                        <div class="mp-stat-value mp-stat-figure" style="color: ${Number(performance.maxDrawdownUnits || 0) > 0 ? '#f59e0b' : 'var(--text-primary)'};">${formatDrawdownUnits(performance.maxDrawdownUnits)}</div>
                    </div>
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">Avg CLV</div>
                        <div class="mp-stat-value mp-stat-figure" style="color: ${getSignedColor(performance.averageClosingLineValuePercent)};">${formatSignedPercent(performance.averageClosingLineValuePercent)}</div>
                    </div>
                    <div class="mp-stat-card">
                        <div class="mp-stat-label">Report Freshness</div>
                        <div class="mp-stat-value mp-stat-value-compact" style="font-size: 1.05rem;">${escapeHtml(generatedAt)}</div>
                    </div>
                </div>
                <div class="mp-analytics-note" style="margin-bottom: 1rem;">
                    We only surface picks that clear the publish threshold and still beat the source market by a real edge. Performance figures assume flat 1-unit stakes across the recent settled sample, and CLV compares the publish price against the captured closing price. Use <strong>Strong</strong> for normal-sized plays, <strong>Caution</strong> for reduced exposure, and <strong>Avoid</strong> as a pass.
                </div>
                ${exclusionCards ? `<div class="mp-stat-grid">${exclusionCards}</div>` : ''}
            `;

            summary.style.display = 'block';
        }

        function getPerformanceRead(performance) {
            const settledCount = Number(performance.settledBetCount || 0);
            const clvSamples = Number(performance.closingLineSamples || 0);
            const roi = Number(performance.roiPercent);
            const clv = Number(performance.averageClosingLineValuePercent);
            const drawdown = Number(performance.maxDrawdownUnits || 0);

            if (settledCount < 10) {
                return {
                    label: 'Avoid',
                    badgeClass: 'mp-read-badge-avoid',
                    shellClass: 'mp-summary-read-avoid',
                    summary: 'The settled sample is still too small to trust this page as a strong betting signal.'
                };
            }

            if (roi < -0.03 || clv < -0.005) {
                return {
                    label: 'Avoid',
                    badgeClass: 'mp-read-badge-avoid',
                    shellClass: 'mp-summary-read-avoid',
                    summary: 'Recent results or closing-line movement are working against the process, so this is a pass for now.'
                };
            }

            if (settledCount >= 40 && clvSamples >= 20 && clv >= 0.002 && roi >= 0 && drawdown <= Math.max(35, settledCount * 1.1)) {
                return {
                    label: 'Strong',
                    badgeClass: 'mp-read-badge-strong',
                    shellClass: 'mp-summary-read-strong',
                    summary: 'The sample is deep enough and prices are moving in our favor, so this is the healthiest betting environment on the page.'
                };
            }

            return {
                label: 'Caution',
                badgeClass: 'mp-read-badge-caution',
                shellClass: 'mp-summary-read-caution',
                summary: 'There is usable signal here, but the sample depth or market feedback is not clean enough for full confidence yet.'
            };
        }

        function formatRate(value) {
            const numeric = Number(value);
            return Number.isFinite(numeric) ? `${(numeric * 100).toFixed(1)}%` : '0.0%';
        }

        function formatSignedPercent(value) {
            const numeric = Number(value);
            if (!Number.isFinite(numeric)) {
                return '--';
            }

            const prefix = numeric >= 0 ? '+' : '';
            return `${prefix}${(numeric * 100).toFixed(1)}%`;
        }

        function formatSignedPoints(value) {
            const numeric = Number(value);
            if (!Number.isFinite(numeric)) {
                return '--';
            }

            const prefix = numeric >= 0 ? '+' : '';
            return `${prefix}${(numeric * 100).toFixed(1)} pts`;
        }

        function formatUnits(value) {
            const numeric = Number(value);
            if (!Number.isFinite(numeric)) {
                return '--';
            }

            const prefix = numeric >= 0 ? '+' : '';
            return `${prefix}${numeric.toFixed(2)}u`;
        }

        function formatSignedUnits(value) {
            return formatUnits(value);
        }

        function formatDrawdownUnits(value) {
            const numeric = Math.abs(Number(value));
            if (!Number.isFinite(numeric)) {
                return '--';
            }

            return `${numeric.toFixed(2)}u worst drop`;
        }

        function getSignedColor(value) {
            const numeric = Number(value);
            if (!Number.isFinite(numeric)) {
                return 'var(--text-muted)';
            }

            if (numeric > 0) {
                return '#10b981';
            }

            if (numeric < 0) {
                return '#ef4444';
            }

            return 'var(--text-primary)';
        }

        function getSettledState(bet) {
            if (bet.isSettledWin === true) {
                return {
                    label: 'Win',
                    color: '#10b981',
                    returnColor: '#10b981'
                };
            }

            if (bet.isSettledWin === false) {
                return {
                    label: 'Loss',
                    color: '#ef4444',
                    returnColor: '#ef4444'
                };
            }

            return {
                label: 'Open',
                color: 'var(--text-muted)',
                returnColor: 'var(--text-muted)'
            };
        }
    </script>
    
