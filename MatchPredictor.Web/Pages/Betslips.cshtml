@page "/betslips"
@model MatchPredictor.Web.Pages.BetslipsModel
@using MatchPredictor.Domain.Models
@{
    ViewData["Title"] = "Pre-booked Betslips";
}

<div class="mp-container">
    <div class="mp-page-header">
        <div>
            <p class="mp-page-kicker">Today’s tickets</p>
            <div class="mp-page-title">
                <h1>Pre-booked Betslips</h1>
            </div>
            <p class="mp-page-subtext">
                Ready-to-play SportyBet slips from today’s analysed Straight Win, BTTS, Over 2.5, and Under 2.5 picks.
            </p>
        </div>
        @if (Model.CurrentSet is not null)
        {
            <span class="mp-date-badge">@Model.GeneratedLocalLabel</span>
        }
    </div>

    @if (Model.CurrentSet is null || Model.CurrentSet.Slips.Count == 0)
    {
        <div class="mp-empty-state">
            <div class="mp-empty-state-icon">🎫</div>
            <h2>No betslips yet</h2>
            <p>Slips appear after the next scheduled generation run (5:00 AM or 1:00 PM WAT).</p>
        </div>
    }
    else
    {
        <div class="mp-page-meta-strip">
            <span>@Model.CurrentSet.DayKind · @BetslipsModel.FormatRunLabel(Model.CurrentSet.RunLabel) run</span>
            <span>@Model.CurrentSet.SlipCount slip@(Model.CurrentSet.SlipCount == 1 ? "" : "s")</span>
            <span>@Model.CurrentSet.SlipLocalDate.ToString("dddd d MMMM")</span>
            <span>2:00 AM and 1:00 PM WAT</span>
        </div>

        @if (Model.RolloverSlip is not null)
        {
            <section class="mp-betslip-board-section" aria-label="Rollover">
                <h2 class="mp-betslip-board-label">Rollover</h2>
                <div class="mp-betslip-banker-wrap">
                    <partial name="_BetslipCard" model="Model.RolloverSlip" />
                </div>
            </section>
        }

        <section class="mp-betslip-board-section" aria-label="Banker">
            <h2 class="mp-betslip-board-label">Banker</h2>
            @if (Model.BankerSlip is null)
            {
                <div class="mp-betslip-no-banker">
                    No banker today — no combination met the quality and odds bar.
                </div>
            }
            else
            {
                <div class="mp-betslip-banker-wrap">
                    <partial name="_BetslipCard" model="Model.BankerSlip" />
                </div>
            }
        </section>

        @if (Model.OtherSlips.Count > 0)
        {
            <section class="mp-betslip-board-section" aria-label="Ladder">
                <h2 class="mp-betslip-board-label">Ladder</h2>
                <div class="mp-betslip-grid">
                    @foreach (var slip in Model.OtherSlips)
                    {
                        <partial name="_BetslipCard" model="slip" />
                    }
                </div>
            </section>
        }
    }

    <section class="mp-betslip-records"
             aria-labelledby="betslip-records-heading"
             data-betslip-records
             data-record-section="@Model.RecordSectionSlug"
             data-record-month="@Model.CalendarMonth.ToString("yyyy-MM")">
        <header class="mp-betslip-records-header">
            <h2 id="betslip-records-heading" class="mp-betslip-records-title">
                <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                Records
            </h2>
            <nav class="mp-betslip-record-tabs" aria-label="Betslip type">
                <a class="mp-tab-btn @(Model.RecordSection == BetslipRecordSection.Rollover ? "active" : "")"
                   data-record-section="rollover"
                   href="@BetslipsModel.RecordUrl(BetslipRecordSection.Rollover)">Rollover</a>
                <a class="mp-tab-btn @(Model.RecordSection == BetslipRecordSection.Banker ? "active" : "")"
                   data-record-section="banker"
                   href="@BetslipsModel.RecordUrl(BetslipRecordSection.Banker)">Banker</a>
                <a class="mp-tab-btn @(Model.RecordSection == BetslipRecordSection.Ladder ? "active" : "")"
                   data-record-section="ladder"
                   href="@BetslipsModel.RecordUrl(BetslipRecordSection.Ladder)">Ladder</a>
                <a class="mp-tab-btn @(Model.RecordSection == BetslipRecordSection.AiDraws ? "active" : "")"
                   data-record-section="draws"
                   href="@BetslipsModel.RecordUrl(BetslipRecordSection.AiDraws)">AI Draws</a>
            </nav>
        </header>

        <div class="mp-betslip-records-body">
            <div id="betslip-record-calendar">
                <partial name="_BetslipCalendar" model="Model.Calendar" />
            </div>
            <div id="betslip-record-results">
                <partial name="_BetslipRecordResults" model="Model.Results" />
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            const root = document.querySelector('[data-betslip-records]');
            if (!root) return;

            const calendarHost = document.getElementById('betslip-record-calendar');
            const resultsHost = document.getElementById('betslip-record-results');
            const emptyResults = '<p class="mp-betslip-records-empty">Pick a highlighted date to see booked slips.</p>';
            let section = root.getAttribute('data-record-section') || 'banker';
            let month = root.getAttribute('data-record-month') || '';

            function bindCopyButtons(scope) {
                (scope || document).querySelectorAll('[data-copy-target]').forEach(button => {
                    if (button.dataset.copyBound === '1') return;
                    button.dataset.copyBound = '1';
                    button.addEventListener('click', async () => {
                        const targetId = button.getAttribute('data-copy-target');
                        const codeEl = targetId ? document.getElementById(targetId) : null;
                        const text = codeEl?.textContent?.trim() ?? '';
                        if (!text) return;
                        try {
                            await navigator.clipboard.writeText(text);
                            const original = button.textContent;
                            button.textContent = 'Copied';
                            setTimeout(() => { button.textContent = original; }, 1200);
                        } catch {
                            button.textContent = 'Failed';
                            setTimeout(() => { button.textContent = 'Copy'; }, 1200);
                        }
                    });
                });
            }

            function updateUrl(nextSection, nextMonth, nextDate) {
                const url = new URL(window.location.href);
                url.searchParams.set('record', nextSection);
                if (nextDate) {
                    url.searchParams.set('date', nextDate);
                    url.searchParams.delete('month');
                } else {
                    url.searchParams.delete('date');
                    if (nextMonth) {
                        url.searchParams.set('month', nextMonth);
                    } else {
                        url.searchParams.delete('month');
                    }
                }
                history.replaceState({}, '', url);
            }

            function setSelectedDate(date) {
                calendarHost.querySelectorAll('[data-record-date]').forEach(day => {
                    day.classList.toggle('is-selected', day.getAttribute('data-record-date') === date);
                });
            }

            async function fetchHtml(url) {
                const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!response.ok) throw new Error('Request failed');
                return await response.text();
            }

            async function loadDay(date) {
                resultsHost.innerHTML = await fetchHtml(
                    `/betslips?handler=RecordDay&record=${encodeURIComponent(section)}&date=${encodeURIComponent(date)}`);
                setSelectedDate(date);
                bindCopyButtons(resultsHost);
                updateUrl(section, month, date);
            }

            async function loadCalendar(nextSection, nextMonth) {
                section = nextSection;
                month = nextMonth;
                root.setAttribute('data-record-section', section);
                root.setAttribute('data-record-month', month);
                calendarHost.innerHTML = await fetchHtml(
                    `/betslips?handler=RecordCalendar&record=${encodeURIComponent(section)}&month=${encodeURIComponent(month)}`);
                resultsHost.innerHTML = emptyResults;
                bindCalendar();
                updateUrl(section, month, null);
            }

            function bindCalendar() {
                calendarHost.querySelectorAll('[data-record-date]').forEach(link => {
                    link.addEventListener('click', async event => {
                        event.preventDefault();
                        const date = link.getAttribute('data-record-date');
                        if (!date) return;
                        try { await loadDay(date); } catch { window.location.href = link.href; }
                    });
                });
                calendarHost.querySelectorAll('[data-record-month]').forEach(link => {
                    link.addEventListener('click', async event => {
                        event.preventDefault();
                        const nextMonth = link.getAttribute('data-record-month');
                        if (!nextMonth) return;
                        try { await loadCalendar(section, nextMonth); } catch { window.location.href = link.href; }
                    });
                });
            }

            root.querySelectorAll('[data-record-section]').forEach(tab => {
                tab.addEventListener('click', async event => {
                    event.preventDefault();
                    const nextSection = tab.getAttribute('data-record-section');
                    if (!nextSection) return;
                    root.querySelectorAll('.mp-tab-btn').forEach(btn => btn.classList.remove('active'));
                    tab.classList.add('active');
                    try { await loadCalendar(nextSection, month); } catch { window.location.href = tab.href; }
                });
            });

            bindCalendar();
            bindCopyButtons(document);
        })();
    </script>
}
