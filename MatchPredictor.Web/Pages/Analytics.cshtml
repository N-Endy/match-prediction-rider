@page
@model MatchPredictor.Web.Pages.AnalyticsModel

@{
    ViewData["Title"] = "Analytics Dashboard";
    var defaultTab = Model.DefaultTabId;
}

<div class="mp-container">
    <div class="mp-page-header">
        <div class="mp-page-title">
            <div class="mp-page-title-icon" style="background: rgba(139, 92, 246, 0.1);">📈</div>
            <div>
                <h1>Performance Analytics</h1>
                <p class="mp-page-subtext">Switch between published results, probability quality, and the live model settings currently driving the app.</p>
            </div>
        </div>
    </div>

    <div class="mp-analytics-mode-tabs">
        <button class="mp-mode-btn active" data-mode="published" onclick="switchAnalyticsMode(event, 'published')">Published Picks</button>
        <button class="mp-mode-btn" data-mode="calibration" onclick="switchAnalyticsMode(event, 'calibration')">Forecast Calibration</button>
        <button class="mp-mode-btn" data-mode="config" onclick="switchAnalyticsMode(event, 'config')">Current Live Config</button>
    </div>

    <div class="mp-analytics-tabs" id="analyticsDateTabs">
        <button class="mp-tab-btn @(defaultTab == "today" ? "active" : "")" onclick="switchAnalyticsTab(event, 'today')">Today</button>
        <button class="mp-tab-btn @(defaultTab == "yesterday" ? "active" : "")" onclick="switchAnalyticsTab(event, 'yesterday')">Yesterday</button>
        <button class="mp-tab-btn @(defaultTab == "3days" ? "active" : "")" onclick="switchAnalyticsTab(event, '3days')">Last 3 Days</button>
        <button class="mp-tab-btn @(defaultTab == "7days" ? "active" : "")" onclick="switchAnalyticsTab(event, '7days')">Last 7 Days</button>
    </div>

    <section id="published-view" class="mp-analytics-mode-view active">
        <div id="published-today" class="mp-analytics-section @(defaultTab == "today" ? "active" : "")" style="@(defaultTab == "today" ? "" : "display: none;")">
            <partial name="_PublishedPicksAnalytics" model="Model.TodayStats" />
        </div>
        <div id="published-yesterday" class="mp-analytics-section @(defaultTab == "yesterday" ? "active" : "")" style="@(defaultTab == "yesterday" ? "" : "display: none;")">
            <partial name="_PublishedPicksAnalytics" model="Model.YesterdayStats" />
        </div>
        <div id="published-3days" class="mp-analytics-section @(defaultTab == "3days" ? "active" : "")" style="@(defaultTab == "3days" ? "" : "display: none;")">
            <partial name="_PublishedPicksAnalytics" model="Model.Last3DaysStats" />
        </div>
        <div id="published-7days" class="mp-analytics-section @(defaultTab == "7days" ? "active" : "")" style="@(defaultTab == "7days" ? "" : "display: none;")">
            <partial name="_PublishedPicksAnalytics" model="Model.Last7DaysStats" />
        </div>
    </section>

    <section id="calibration-view" class="mp-analytics-mode-view" style="display: none;">
        <div id="calibration-today" class="mp-analytics-section @(defaultTab == "today" ? "active" : "")" style="@(defaultTab == "today" ? "" : "display: none;")">
            <partial name="_ForecastCalibrationAnalytics" model="Model.TodayStats" />
        </div>
        <div id="calibration-yesterday" class="mp-analytics-section @(defaultTab == "yesterday" ? "active" : "")" style="@(defaultTab == "yesterday" ? "" : "display: none;")">
            <partial name="_ForecastCalibrationAnalytics" model="Model.YesterdayStats" />
        </div>
        <div id="calibration-3days" class="mp-analytics-section @(defaultTab == "3days" ? "active" : "")" style="@(defaultTab == "3days" ? "" : "display: none;")">
            <partial name="_ForecastCalibrationAnalytics" model="Model.Last3DaysStats" />
        </div>
        <div id="calibration-7days" class="mp-analytics-section @(defaultTab == "7days" ? "active" : "")" style="@(defaultTab == "7days" ? "" : "display: none;")">
            <partial name="_ForecastCalibrationAnalytics" model="Model.Last7DaysStats" />
        </div>
    </section>

    <section id="config-view" class="mp-analytics-mode-view" style="display: none;">
        <partial name="_CurrentLiveConfigAnalytics" model="Model.CurrentLiveConfig" />
    </section>

    <section class="mp-guide-shell">
        <div class="mp-glossary-header">
            <h3>Quick Playbook</h3>
            <p>Read the dashboard in this order so the numbers turn into a cleaner betting decision.</p>
        </div>
        <div class="mp-guide-grid">
            <article class="mp-guide-card">
                <span class="mp-guide-step">1</span>
                <h4>Start with the read</h4>
                <p><strong>Strong</strong> means enough sample plus cleaner calibration. <strong>Caution</strong> means reduce stake size. <strong>Avoid</strong> means skip or wait for more evidence.</p>
            </article>
            <article class="mp-guide-card">
                <span class="mp-guide-step">2</span>
                <h4>Favor stronger environments</h4>
                <p>League and calibrator segments tell you where the model is behaving best. Trust those environments before trusting a single eye-catching edge.</p>
            </article>
            <article class="mp-guide-card">
                <span class="mp-guide-step">3</span>
                <h4>Use process metrics, not hot streaks</h4>
                <p>Positive CLV, lower Brier, and lower Log Loss are better signs of a repeatable edge than a short run of recent wins.</p>
            </article>
        </div>
    </section>

    <section class="mp-glossary-shell">
        <div class="mp-glossary-header">
            <h3>How To Read These Numbers</h3>
            <p>The goal here is to make the page self-explanatory, not force you to already know forecasting jargon.</p>
        </div>
        <div class="mp-glossary-grid">
            <article class="mp-glossary-card">
                <h4>Published Picks</h4>
                <p>These are the bets that actually made it onto the card. Win rate here answers “how often did the published pick land?”</p>
            </article>
            <article class="mp-glossary-card">
                <h4>Forecast Calibration</h4>
                <p>This is about probability quality, not just wins. A 70% forecast should land close to 70% over time.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>Brier Score</h4>
                <p>Lower is better. It rewards both being correct and being honest about uncertainty.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>Log Loss</h4>
                <p>Lower is better. It punishes overconfident wrong calls more heavily than Brier does, so it is a strong check on reckless forecasts.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>Precision / Recall / F1</h4>
                <p>Precision asks how often positive calls were right. Recall asks how many real wins the model found. F1 balances both into one score.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>REL / RES / UNC</h4>
                <p><strong>Reliability</strong> should be low, <strong>Resolution</strong> should be high, and <strong>Uncertainty</strong> describes how noisy the market is in the first place.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>Confidence Bands</h4>
                <p>These compare what the model predicted against what really happened in each probability bucket, such as 60-70% calls.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>League / Calibrator Segments</h4>
                <p>These isolate where the model is strongest or weakest by competition and by the active calibrator tag, so underperforming cohorts are easier to spot.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>Threshold Source</h4>
                <p><strong>Configured</strong> means the default setting is live. <strong>Tuned</strong> means a data-backed threshold has been promoted.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>Calibrator Era</h4>
                <p>This shows how forecasts performed while a specific calibrator was live, such as Bucket or Beta.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>CLV</h4>
                <p>Closing Line Value compares the price you got at publish time to the closing market price. Positive CLV is usually a healthy sign of process quality.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>ROI / Yield</h4>
                <p>Both tell you whether the strategy is making money per unit staked. Positive is good, but tiny values need a decent sample before you trust them.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>Max Drawdown</h4>
                <p>This is the worst bankroll drop from a previous peak. It tells you how rough the ride can get even when the strategy is profitable overall.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>Strong / Caution / Avoid</h4>
                <p>These labels are shorthand for action. <strong>Strong</strong> means usable evidence, <strong>Caution</strong> means lighter staking, and <strong>Avoid</strong> means pass or wait.</p>
            </article>
            <article class="mp-glossary-card">
                <h4>Promotion Timeline</h4>
                <p>This is the change log for live model decisions: when thresholds moved or calibrators got promoted.</p>
            </article>
        </div>
    </section>
</div>

@section Scripts {
<script>
    let currentAnalyticsMode = 'published';
    let currentAnalyticsTab = '@defaultTab';

    function setAnalyticsVisibility() {
        document.querySelectorAll('.mp-analytics-mode-view').forEach(view => {
            view.style.display = view.id === currentAnalyticsMode + '-view' ? 'block' : 'none';
        });

        const dateTabs = document.getElementById('analyticsDateTabs');
        if (dateTabs) {
            dateTabs.style.display = currentAnalyticsMode === 'config' ? 'none' : 'flex';
        }

        if (currentAnalyticsMode === 'config') {
            return;
        }

        document.querySelectorAll(`#${currentAnalyticsMode}-view .mp-analytics-section`).forEach(section => {
            section.style.display = section.id === `${currentAnalyticsMode}-${currentAnalyticsTab}` ? 'block' : 'none';
        });
    }

    function switchAnalyticsMode(event, mode) {
        currentAnalyticsMode = mode;
        document.querySelectorAll('.mp-mode-btn').forEach(button => button.classList.remove('active'));
        event.target.classList.add('active');
        setAnalyticsVisibility();
    }

    function switchAnalyticsTab(event, tabId) {
        currentAnalyticsTab = tabId;
        document.querySelectorAll('.mp-tab-btn').forEach(button => button.classList.remove('active'));
        event.target.classList.add('active');
        setAnalyticsVisibility();
    }

    document.addEventListener('DOMContentLoaded', setAnalyticsVisibility);
</script>

<style>
    .mp-analytics-mode-tabs,
    .mp-analytics-tabs {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .mp-analytics-mode-tabs {
        margin-bottom: 1rem;
    }

    .mp-analytics-tabs {
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 1rem;
    }

    .mp-mode-btn,
    .mp-tab-btn {
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        padding: 0.5rem 1rem;
        border-radius: var(--radius-md);
        cursor: pointer;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .mp-mode-btn:hover,
    .mp-tab-btn:hover {
        background: rgba(255, 255, 255, 0.05);
        color: white;
    }

    .mp-mode-btn.active,
    .mp-tab-btn.active {
        background: var(--bg-card);
        color: white;
        border-color: rgba(139, 92, 246, 0.5);
        box-shadow: 0 0 10px rgba(139, 92, 246, 0.1);
    }

    .mp-analytics-note {
        margin-bottom: 1.5rem;
        padding: 0.95rem 1rem;
        border-radius: var(--radius-md);
        background: rgba(148, 163, 184, 0.08);
        border: 1px solid rgba(148, 163, 184, 0.12);
        color: var(--text-secondary);
        line-height: 1.6;
    }

    .mp-note-with-read {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .mp-note-read {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.35rem;
    }

    .mp-note-caption {
        color: var(--text-muted);
        font-size: 0.78rem;
        max-width: 320px;
        text-align: right;
        line-height: 1.45;
    }

    .mp-read-strip {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.65rem;
        margin-top: -0.15rem;
    }

    .mp-read-detail {
        color: var(--text-muted);
        font-size: 0.82rem;
        line-height: 1.5;
    }

    .mp-read-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.32rem 0.7rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .mp-read-badge-strong {
        background: rgba(16, 185, 129, 0.14);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.18);
    }

    .mp-read-badge-caution {
        background: rgba(245, 158, 11, 0.14);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.18);
    }

    .mp-read-badge-avoid {
        background: rgba(244, 63, 94, 0.14);
        color: #fb7185;
        border: 1px solid rgba(244, 63, 94, 0.18);
    }

    .mp-stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .mp-stat-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.5rem;
        transition: transform 0.2s;
    }

    .mp-stat-card:hover {
        transform: translateY(-2px);
    }

    .mp-stat-value {
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0;
        font-family: monospace;
        line-height: 1;
    }

    .mp-stat-figure {
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1;
        min-height: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .mp-stat-value-compact {
        font-size: 2rem;
        min-height: 2rem;
    }

    .mp-stat-label {
        color: var(--text-muted);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .acc-high {
        color: #10b981;
    }

    .acc-med {
        color: #f59e0b;
    }

    .acc-low {
        color: #ef4444;
    }

    .mp-category-stats {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
    }

    .mp-category-row {
        margin-bottom: 1.5rem;
    }

    .mp-category-row:last-child {
        margin-bottom: 0;
    }

    .mp-cat-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: baseline;
        gap: 1rem;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .mp-cat-name {
        font-weight: 600;
        color: white;
    }

    .mp-cat-details {
        color: var(--text-muted);
        display: inline-flex;
        align-items: baseline;
        justify-content: flex-end;
        gap: 0.5rem;
        text-align: right;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1;
    }

    .mp-cat-metric {
        display: inline-flex;
        align-items: baseline;
    }

    .mp-progress-track {
        height: 8px;
        background: rgba(255,255,255,0.05);
        border-radius: 4px;
        overflow: hidden;
    }

    .mp-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #10b981, #3b82f6);
        border-radius: 4px;
        transition: width 1s ease-in-out;
    }

    .mp-progress-fill.acc-high {
        background: linear-gradient(90deg, #10b981, #34d399);
    }

    .mp-progress-fill.acc-med {
        background: linear-gradient(90deg, #f59e0b, #fbbf24);
    }

    .mp-progress-fill.acc-low {
        background: linear-gradient(90deg, #ef4444, #f87171);
    }

    .mp-market-analytics,
    .mp-switch-log {
        margin-top: 2rem;
    }

    .mp-switch-log-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        margin-bottom: 1.2rem;
    }

    .mp-switch-caption {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.84rem;
        line-height: 1.55;
    }

    .mp-switch-list {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        max-height: 480px;
        overflow-y: auto;
        padding-right: 0.25rem;
        scrollbar-width: thin;
    }

    .mp-switch-list::-webkit-scrollbar {
        width: 8px;
    }

    .mp-switch-list::-webkit-scrollbar-thumb {
        background: rgba(148, 163, 184, 0.18);
        border-radius: 999px;
    }

    .mp-switch-item {
        display: grid;
        grid-template-columns: 96px minmax(0, 1fr);
        gap: 1rem;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: 1rem 1.1rem;
    }

    .mp-switch-time {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        color: var(--text-muted);
        font-size: 0.78rem;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1;
    }

    .mp-switch-time strong {
        color: white;
        font-size: 0.9rem;
    }

    .mp-switch-body {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .mp-switch-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
    }

    .mp-switch-market {
        color: white;
        font-weight: 600;
    }

    .mp-switch-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.12);
        color: #10b981;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .mp-switch-summary {
        color: white;
        font-size: 0.92rem;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1;
    }

    .mp-switch-detail {
        color: var(--text-muted);
        font-size: 0.8rem;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1;
    }

    .mp-market-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
        gap: 1rem;
    }

    .mp-market-empty {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        color: var(--text-muted);
    }

    .mp-market-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .mp-market-header {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: flex-start;
    }

    .mp-market-header h4 {
        margin: 0;
        color: white;
        font-size: 1rem;
    }

    .mp-market-header p {
        margin: 0.25rem 0 0;
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    .mp-market-briers {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.25rem;
        color: var(--text-muted);
        font-size: 0.8rem;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1;
    }

    .mp-market-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
    }

    .mp-market-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.6rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: var(--text-muted);
        font-size: 0.78rem;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1;
    }

    .mp-market-pill strong {
        color: white;
        font-weight: 600;
    }

    .mp-market-pill em {
        font-style: normal;
    }

    .mp-market-metrics {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.65rem;
    }

    .mp-market-metric-block {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: var(--radius-md);
        padding: 0.85rem 0.8rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
    }

    .mp-market-metric-label {
        color: var(--text-muted);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .mp-market-metric-block strong {
        color: white;
        font-size: 0.95rem;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1;
    }

    .mp-market-beta {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: var(--radius-md);
        padding: 1rem;
    }

    .mp-market-beta-header {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 0.65rem;
        color: white;
    }

    .mp-market-beta-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.45rem 0.75rem;
        color: var(--text-secondary);
        font-size: 0.82rem;
    }

    .mp-market-beta-empty {
        margin: 0.5rem 0 0;
        color: var(--text-muted);
        font-size: 0.82rem;
        line-height: 1.55;
    }

    .mp-era-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 0.85rem;
    }

    .mp-era-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: var(--radius-md);
        padding: 1rem;
    }

    .mp-era-row {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
        gap: 0.55rem;
        padding: 0.35rem 0;
        color: var(--text-secondary);
        font-size: 0.82rem;
    }

    .mp-era-row-head {
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.7rem;
