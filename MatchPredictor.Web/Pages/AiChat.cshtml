@page
@model MatchPredictor.Web.Pages.AiChatModel

@{
    ViewData["Title"] = "AI Chat";
}

<div class="mp-container">
    <div class="mp-page-header">
        <div class="mp-page-title">
            <div class="mp-page-title-icon" style="background: rgba(99, 102, 241, 0.1);">🤖</div>
            <h1>AI Betting Companion</h1>
        </div>
        @if (Model.IsAuthenticated)
        {
            <form method="post" asp-page-handler="Logout">
                <button type="submit" class="mp-book-btn" style="width: auto; padding: 0.65rem 1rem; border-radius: var(--radius-md);">
                    Log Out
                </button>
            </form>
        }
    </div>

@if (!Model.IsAuthenticated)
{
    <div class="mp-ai-auth-container" style="max-width: 400px; margin: 4rem auto; text-align: center; padding: 2rem; background: var(--bg-card); border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
        <div style="font-size: 3rem; margin-bottom: 1rem;">🔒</div>
        <h2 style="margin-bottom: 0.5rem;">Access Restricted</h2>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem; font-size: 0.9rem;">
            Please enter the password to access the AI Prediction Advisor.
        </p>
        
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div style="color: var(--accent-rose); background: rgba(244, 63, 94, 0.1); padding: 0.75rem; border-radius: var(--radius-sm); margin-bottom: 1rem; font-size: 0.85rem;">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" style="display: flex; flex-direction: column; gap: 1rem;">
            <input type="password" asp-for="Password" 
                   class="mp-chat-input" 
                   style="text-align: center; border-radius: var(--radius-md);" 
                   placeholder="Enter Password" 
                   required autofocus />
            <button type="submit" class="mp-book-btn" style="width: 100%; border-radius: var(--radius-md); padding: 0.75rem;">
                Unlock Chat
            </button>
        </form>
    </div>
}
else
{
    <div class="mp-chat-container" id="chatContainer">
        <div class="mp-chat-messages" id="chatMessages">
            <div class="mp-chat-message mp-chat-ai">
                <div class="mp-chat-avatar">🤖</div>
                <div class="mp-chat-bubble">
                    <p>Hello! I'm Nelson, your grounded betting companion. I work from MatchPredictor's live card, recent published history, and the app's public analytics logic, so I can help you build slips, refine them, and explain what the app is showing without guessing.</p>
                    <p style="margin-top: 0.5rem; font-size: 0.85rem; opacity: 0.7;">Try asking:</p>
                    <ul style="font-size: 0.85rem; opacity: 0.7; margin: 0.25rem 0 0 1rem;">
                        <li>"Give me 10 of the best BTTS predictions"</li>
                        <li>"Give me a mixture of btts, over 2.5 and straight win"</li>
                        <li>"Which draw games would you recommend?"</li>
                        <li>"Which is riskiest?"</li>
                        <li>"Why isn't this in value bets?"</li>
                        <li>"What does reliability mean?"</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="mp-chat-input-area">
            <input type="text" id="chatInput" class="mp-chat-input"
                   placeholder="Ask about today's picks or a recent settled match..."
                   autocomplete="off" />
            <button id="chatSendBtn" class="mp-chat-send-btn" onclick="sendChatMessage()">
                Send
            </button>
        </div>
    </div>
}
</div>

@section Scripts {
<script>
    const chatMessages = document.getElementById('chatMessages');
    const chatInput = document.getElementById('chatInput');
    const chatSendBtn = document.getElementById('chatSendBtn');
    if (chatInput && chatSendBtn) {
        chatInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendChatMessage();
            }
        });
    }

    function appendTextMessage(role, text) {
        const div = document.createElement('div');
        div.className = `mp-chat-message mp-chat-${role}`;

        const avatar = document.createElement('div');
        avatar.className = 'mp-chat-avatar';
        avatar.textContent = role === 'ai' ? '🤖' : '👤';

        const bubble = document.createElement('div');
        bubble.className = 'mp-chat-bubble';
        bubble.innerHTML = formatMessageHtml(text);

        div.appendChild(avatar);
        div.appendChild(bubble);
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function appendAiResponse(response) {
        const div = document.createElement('div');
        div.className = 'mp-chat-message mp-chat-ai';

        const avatar = document.createElement('div');
        avatar.className = 'mp-chat-avatar';
        avatar.textContent = '🤖';

        const bubble = document.createElement('div');
        bubble.className = 'mp-chat-bubble';

        const message = document.createElement('div');
        message.innerHTML = formatMessageHtml(response.message || '');
        bubble.appendChild(message);

        if (response.workingSlipSummary) {
            bubble.appendChild(buildWorkingSlipSummary(response.workingSlipSummary));
        }

        if (Array.isArray(response.warnings) && response.warnings.length > 0) {
            const warnings = document.createElement('div');
            warnings.style.marginTop = '0.75rem';
            warnings.style.fontSize = '0.8rem';
            warnings.style.opacity = '0.75';
            warnings.innerHTML = response.warnings
                .map(warning => `<div>${escapeHtml(warning)}</div>`)
                .join('');
            bubble.appendChild(warnings);
        }

        if (Array.isArray(response.knowledgeCards) && response.knowledgeCards.length > 0) {
            bubble.appendChild(buildKnowledgeCards(response.knowledgeCards));
        }

        if (Array.isArray(response.actions) && response.actions.length > 0) {
            const actions = document.createElement('div');
            actions.style.display = 'grid';
            actions.style.gap = '0.75rem';
            actions.style.marginTop = '0.85rem';

            response.actions.forEach(action => {
                const card = document.createElement('div');
                card.style.padding = '0.85rem';
                card.style.borderRadius = '12px';
                card.style.border = '1px solid rgba(148, 163, 184, 0.16)';
                card.style.background = 'rgba(15, 23, 42, 0.35)';

                const title = document.createElement('div');
                title.style.fontWeight = '600';
                title.style.fontSize = '0.9rem';
                title.textContent = `${action.homeTeam} vs ${action.awayTeam}`;
                card.appendChild(title);

                const meta = document.createElement('div');
                meta.style.marginTop = '0.3rem';
                meta.style.fontSize = '0.75rem';
                meta.style.opacity = '0.72';
                const metaParts = [
                    action.matchDateLabel || 'Today',
                    action.league || 'Card',
                    action.market || 'Market',
                    action.prediction || 'Pick'
                ];
                if (action.kickoffTime) {
                    metaParts.push(action.kickoffTime);
                }
                if (action.status) {
                    metaParts.push(action.status);
                }
                if (Number.isFinite(Number(action.estimatedOdds))) {
                    metaParts.push(`~${Number(action.estimatedOdds).toFixed(2)} odds`);
                }
                meta.textContent = metaParts.join(' • ');
                card.appendChild(meta);

                const statParts = [];
                if (Number.isFinite(Number(action.modelProbability))) {
                    statParts.push(`Model ${(Number(action.modelProbability) * 100).toFixed(1)}%`);
                }
                if (Number.isFinite(Number(action.marketProbability))) {
                    statParts.push(`Market ${(Number(action.marketProbability) * 100).toFixed(1)}%`);
                }
                if (Number.isFinite(Number(action.edgePoints))) {
                    const edge = Number(action.edgePoints);
                    statParts.push(`Edge ${edge >= 0 ? '+' : ''}${edge.toFixed(1)} pts`);
                }

                if (statParts.length > 0) {
                    const stats = document.createElement('div');
                    stats.style.marginTop = '0.45rem';
                    stats.style.fontSize = '0.74rem';
                    stats.style.opacity = '0.78';
                    stats.textContent = statParts.join(' • ');
                    card.appendChild(stats);
                }

                if (action.explanation) {
                    const explanation = document.createElement('div');
                    explanation.style.marginTop = '0.55rem';
                    explanation.style.fontSize = '0.82rem';
                    explanation.style.lineHeight = '1.5';
                    explanation.innerHTML = formatMessageHtml(action.explanation);
                    card.appendChild(explanation);
                }

                if (action.actualScore) {
                    const settledScore = document.createElement('div');
                    settledScore.style.marginTop = '0.55rem';
                    settledScore.style.fontSize = '0.8rem';
                    settledScore.style.opacity = '0.82';
                    settledScore.textContent = `Final score: ${action.actualScore}`;
                    card.appendChild(settledScore);
                }

                if (action.canBook !== false) {
                    const btn = document.createElement('button');
                    btn.className = 'mp-add-cart-btn mp-btn-sm';
                    btn.style.display = 'inline-flex';
                    btn.style.alignItems = 'center';
                    btn.style.justifyContent = 'center';
                    btn.style.marginTop = '0.7rem';
                    btn.style.padding = '6px 12px';
                    btn.style.fontSize = '0.78rem';
                    btn.style.borderRadius = '8px';
                    btn.style.lineHeight = '1';
                    btn.textContent = `+ Add ${action.market}`;
                    btn.dataset.home = action.homeTeam || '';
                    btn.dataset.away = action.awayTeam || '';
                    btn.dataset.league = action.league || '';
                    btn.dataset.market = action.market || '';
                    btn.dataset.prediction = action.prediction || '';
                    card.appendChild(btn);
                }
                actions.appendChild(card);
            });

            bubble.appendChild(actions);
        }

        if (response.showBookAll && Array.isArray(response.actions) && response.actions.length > 1) {
            const footer = document.createElement('div');
            footer.style.marginTop = '12px';
            footer.style.paddingTop = '12px';
            footer.style.borderTop = '1px solid rgba(255,255,255,0.1)';

            const btn = document.createElement('button');
            btn.className = 'mp-book-btn';
            btn.style.fontSize = '0.85rem';
            btn.style.padding = '8px 16px';
            btn.style.width = 'auto';
            btn.style.borderRadius = '8px';
            btn.textContent = '🎫 Add All & Open Slip';
            btn.addEventListener('click', () => addAllAndBook(btn));

            footer.appendChild(btn);
            bubble.appendChild(footer);
        }

        if (Array.isArray(response.suggestedPrompts) && response.suggestedPrompts.length > 0) {
            bubble.appendChild(buildSuggestedPromptChips(response.suggestedPrompts));
        }

        div.appendChild(avatar);
        div.appendChild(bubble);
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function buildWorkingSlipSummary(summary) {
        const shell = document.createElement('div');
        shell.style.marginTop = '0.8rem';
        shell.style.padding = '0.85rem';
        shell.style.borderRadius = '12px';
        shell.style.border = '1px solid rgba(59, 130, 246, 0.2)';
        shell.style.background = 'rgba(59, 130, 246, 0.08)';

        const title = document.createElement('div');
        title.style.fontSize = '0.78rem';
        title.style.textTransform = 'uppercase';
        title.style.letterSpacing = '0.08em';
        title.style.opacity = '0.7';
        title.style.fontWeight = '700';
        title.textContent = 'Working Slip';
        shell.appendChild(title);

        const stats = document.createElement('div');
        stats.style.marginTop = '0.4rem';
        stats.style.fontSize = '0.84rem';
        stats.style.lineHeight = '1.5';
        const statParts = [
            `${Number(summary.count || 0)} leg${Number(summary.count || 0) === 1 ? '' : 's'}`,
            `${Number(summary.bookableCount || 0)} bookable`
        ];
        if (Array.isArray(summary.markets) && summary.markets.length > 0) {
            statParts.push(summary.markets.join(', '));
        }
        if (Number.isFinite(Number(summary.estimatedCombinedOdds))) {
            statParts.push(`~${Number(summary.estimatedCombinedOdds).toFixed(2)} combined odds`);
        }
        stats.textContent = statParts.join(' • ');
        shell.appendChild(stats);

        return shell;
    }

    function buildKnowledgeCards(cards) {
        const shell = document.createElement('div');
        shell.style.display = 'grid';
        shell.style.gap = '0.65rem';
        shell.style.marginTop = '0.8rem';

        cards.forEach(card => {
            const article = document.createElement('div');
            article.style.padding = '0.8rem';
            article.style.borderRadius = '12px';
            article.style.border = '1px solid rgba(148, 163, 184, 0.16)';
            article.style.background = 'rgba(15, 23, 42, 0.32)';

            const header = document.createElement('div');
            header.style.display = 'flex';
            header.style.justifyContent = 'space-between';
            header.style.alignItems = 'center';
            header.style.gap = '0.75rem';

            const title = document.createElement('div');
            title.style.fontWeight = '700';
            title.style.fontSize = '0.88rem';
            title.textContent = card.title || 'Knowledge';
            header.appendChild(title);

            if (card.kind) {
                const kind = document.createElement('span');
                kind.style.fontSize = '0.72rem';
                kind.style.opacity = '0.7';
                kind.style.textTransform = 'uppercase';
                kind.style.letterSpacing = '0.08em';
                kind.textContent = card.kind;
                header.appendChild(kind);
            }

            article.appendChild(header);

            const body = document.createElement('div');
            body.style.marginTop = '0.5rem';
            body.style.fontSize = '0.82rem';
            body.style.lineHeight = '1.55';
            body.innerHTML = formatMessageHtml(card.body || '');
            article.appendChild(body);

            shell.appendChild(article);
        });

        return shell;
    }

    function buildSuggestedPromptChips(prompts) {
        const shell = document.createElement('div');
        shell.style.display = 'flex';
        shell.style.flexWrap = 'wrap';
        shell.style.gap = '0.55rem';
        shell.style.marginTop = '0.9rem';

        prompts.forEach(prompt => {
            const button = document.createElement('button');
            button.type = 'button';
            button.style.border = '1px solid rgba(148, 163, 184, 0.18)';
            button.style.background = 'rgba(30, 41, 59, 0.5)';
            button.style.color = 'var(--text-primary)';
            button.style.borderRadius = '999px';
            button.style.padding = '0.45rem 0.75rem';
            button.style.fontSize = '0.78rem';
            button.style.cursor = 'pointer';
            button.textContent = prompt;
            button.addEventListener('click', () => sendSuggestedPrompt(prompt));
            shell.appendChild(button);
        });

        return shell;
    }

    function escapeHtml(text) {
        return String(text ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function formatMessageHtml(text) {
        const escaped = escapeHtml(text);
        return escaped
            .replace(/\n/g, '<br>')
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/`(.*?)`/g, '<code>$1</code>');
    }

    // Agentic UI Action
    function addAllAndBook(btn) {
        const bubble = btn.closest('.mp-chat-bubble');
        if (!bubble) return;
        
        const betBtns = bubble.querySelectorAll('.mp-add-cart-btn');
        if (betBtns.length === 0) return;
        
        let addedCount = 0;
        betBtns.forEach(b => {
            if (typeof addToCart === 'function') {
                addToCart({
                    homeTeam: b.dataset.home || '',
                    awayTeam: b.dataset.away || '',
                    league: b.dataset.league || '',
                    market: b.dataset.market || '',
                    prediction: b.dataset.prediction || ''
                });
                addedCount++;
            }
        });
        
        if (typeof openCartModal === 'function') {
            openCartModal();
        }
        
        btn.textContent = `Added ${addedCount} picks!`;
        btn.disabled = true;
        btn.style.opacity = '0.7';
    }

    function showTypingIndicator() {
        const div = document.createElement('div');
        div.className = 'mp-chat-message mp-chat-ai mp-chat-typing';
        div.id = 'typingIndicator';
        div.innerHTML = `
            <div class="mp-chat-avatar">🤖</div>
            <div class="mp-chat-bubble">
                <div class="mp-typing-dots">
                    <span></span><span></span><span></span>
                </div>
            </div>
        `;
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function removeTypingIndicator() {
        const indicator = document.getElementById('typingIndicator');
        if (indicator) indicator.remove();
    }

    function sendSuggestedPrompt(prompt) {
        if (!chatInput || !chatSendBtn) return;
        chatInput.value = prompt;
        sendChatMessage();
    }

    async function sendChatMessage() {
        const message = chatInput.value.trim();
        if (!message) return;

        // Show user message
        appendTextMessage('user', message);
        chatInput.value = '';
        chatSendBtn.disabled = true;

        showTypingIndicator();

        try {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 30000);

            const response = await fetch('/api/ai/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message }),
                signal: controller.signal
            });

            clearTimeout(timeoutId);
            removeTypingIndicator();

            if (response.ok) {
                const data = await response.json();
                appendAiResponse(data);
            } else {
                const errorData = await response.json().catch(() => null);
                const errorMsg = errorData?.message || 'Something went wrong. Please try again.';
                appendAiResponse({ message: `❌ ${errorMsg}`, actions: [], showBookAll: false, warnings: [] });
            }
        } catch (err) {
            removeTypingIndicator();
            if (err.name === 'AbortError') {
                appendAiResponse({ message: '⏳ Request timed out. The AI service may be busy — please try again in a moment.', actions: [], showBookAll: false, warnings: [] });
            } else {
                appendAiResponse({ message: '❌ Network error. Please check your connection and try again.', actions: [], showBookAll: false, warnings: [] });
            }
        } finally {
            chatSendBtn.disabled = false;
            chatInput.focus();
        }
    }
</script>
}
