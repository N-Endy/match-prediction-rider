@page
@model MatchPredictor.Web.Pages.AiChatModel

@{
    ViewData["Title"] = "AI Chat";
    ViewData["HideAds"] = true;
}

<div class="mp-chat-cockpit-page" id="chatCockpit">
    @if (!Model.IsAuthenticated)
    {
        <div class="mp-chat-auth">
            <h2 class="mp-chat-auth-title">Access restricted</h2>
            <p class="mp-chat-auth-copy">
                Enter the password to unlock Nelson, your AI prediction companion.
            </p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="mp-chat-auth-error" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" class="mp-chat-auth-form">
                @Html.AntiForgeryToken()
                <label class="mp-chat-auth-label" asp-for="Password">Companion Password</label>
                <input type="password" asp-for="Password"
                       class="mp-chat-input"
                       autocomplete="current-password"
                       required autofocus />
                <button type="submit" class="mp-chat-auth-submit">
                    Unlock AI Companion
                </button>
            </form>
        </div>
    }
    else
    {
        <!-- Immersive Cockpit Header -->
        <header class="mp-chat-topbar">
            <div class="mp-chat-topbar-left">
                <div class="mp-chat-status-pill">
                    <span class="mp-chat-pulse-dot" aria-hidden="true"></span>
                    <h1 class="mp-chat-title">Nelson AI</h1>
                </div>
                <span class="mp-chat-topbar-subtitle">
                    Live Odds &amp; Historical Grounding
                </span>
            </div>

            <div class="mp-chat-topbar-right">
                <button type="button" class="mp-chat-btn-ghost" id="newChatBtn" onclick="resetChatConversation()" title="Start a fresh conversation">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                    <span>New Chat</span>
                </button>

                @if (Model.ShowLogout)
                {
                    <form method="post" asp-page-handler="Logout" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="mp-chat-btn-ghost mp-chat-btn-danger" title="Lock AI Chat session">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <span>Lock</span>
                        </button>
                    </form>
                }
            </div>
        </header>

        <!-- Messages Region -->
        <div class="mp-chat-messages" id="chatMessages" role="log" aria-live="polite">
            <!-- Welcome Hero & Categorized Guidance -->
            <div class="mp-welcome-hero" id="welcomeHero">
                <div class="mp-welcome-badge">
                    <div class="mp-welcome-avatar" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                            <circle cx="12" cy="5" r="2"></circle>
                            <path d="M12 7v4"></path>
                            <line x1="8" y1="16" x2="8" y2="16"></line>
                            <line x1="16" y1="16" x2="16" y2="16"></line>
                        </svg>
                    </div>
                    <div>
                        <h2>Meet Nelson</h2>
                        <p>Your grounded AI betting analyst. Powered by live fixture probabilities, Poisson &amp; Dixon-Coles goal rates, and published track records without guesswork.</p>
                    </div>
                </div>

                <!-- Categorized Prompts Grid -->
                <div class="mp-welcome-grid">
                    <!-- Category 1: Accumulator & Slip Builder -->
                    <div class="mp-welcome-card">
                        <div class="mp-welcome-card-header">
                            <div class="mp-card-icon mp-icon-emerald" aria-hidden="true">🎯</div>
                            <h3>Slip &amp; Acca Builder</h3>
                        </div>
                        <p>Build disciplined slips with custom odds targets and balanced markets.</p>
                        <div class="mp-welcome-card-chips">
                            <button type="button" class="mp-chat-chip" data-chat-prompt="Give me 10 of the best BTTS predictions">Top 10 BTTS picks</button>
                            <button type="button" class="mp-chat-chip" data-chat-prompt="Give me a mixture of btts, over 2.5 and straight win">Mix BTTS, Over &amp; Straight Win</button>
                            <button type="button" class="mp-chat-chip" data-chat-prompt="Build a 5-leg accumulator for today with good balance">Build 5-leg accumulator</button>
                        </div>
                    </div>

                    <!-- Category 2: Value & Edge Hunter -->
                    <div class="mp-welcome-card">
                        <div class="mp-welcome-card-header">
                            <div class="mp-card-icon mp-icon-cyan" aria-hidden="true">💎</div>
                            <h3>Value &amp; Edge Finder</h3>
                        </div>
                        <p>Find matches where the algorithmic probability outprices bookmakers.</p>
                        <div class="mp-welcome-card-chips">
                            <button type="button" class="mp-chat-chip" data-chat-prompt="Which draw games would you recommend?">Recommended Draw games</button>
                            <button type="button" class="mp-chat-chip" data-chat-prompt="Which match is riskiest?">Riskiest matches to avoid</button>
                            <button type="button" class="mp-chat-chip" data-chat-prompt="Which matches offer the highest statistical edge today?">Highest edge picks today</button>
                        </div>
                    </div>

                    <!-- Category 3: Tactical Reads & Explanations -->
                    <div class="mp-welcome-card">
                        <div class="mp-welcome-card-header">
                            <div class="mp-card-icon mp-icon-amber" aria-hidden="true">🧠</div>
                            <h3>Tactical Explanations</h3>
                        </div>
                        <p>Understand the mathematics, suppression filters, and model health.</p>
                        <div class="mp-welcome-card-chips">
                            <button type="button" class="mp-chat-chip" data-chat-prompt="Why isn't this in value bets?">Why a game misses Value bar</button>
                            <button type="button" class="mp-chat-chip" data-chat-prompt="What does reliability mean?">What reliability score means</button>
                            <button type="button" class="mp-chat-chip" data-chat-prompt="Explain how Poisson and Dixon-Coles models predict goals">How goal models work</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Floating Scroll to Bottom Button -->
        <button type="button" class="mp-chat-scroll-bottom" id="scrollBottomBtn" aria-label="Scroll to newest message" style="display: none;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
        </button>

        <!-- Pinned Bottom Composer Dock -->
        <div class="mp-chat-dock">
            <div class="mp-chat-composer" id="composerContainer">
                <textarea id="chatInput" class="mp-chat-textarea"
                          placeholder="Ask Nelson about today's picks, accumulator combinations, or match stats..."
                          rows="1"
                          aria-label="Type your message"
                          autocomplete="off"></textarea>
                <div class="mp-chat-composer-actions">
                    <span class="mp-chat-kbd-hint" aria-hidden="true">Enter ↵</span>
                    <button type="button" id="chatSendBtn" class="mp-chat-send-circle" onclick="sendChatMessage()" aria-label="Send message">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="mp-chat-dock-footer">
                <span>Press Enter to send &bull; Shift+Enter for new line</span>
                <span>MatchPredictor AI &bull; Grounded statistics</span>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    const chatMessages = document.getElementById('chatMessages');
    const chatInput = document.getElementById('chatInput');
    const chatSendBtn = document.getElementById('chatSendBtn');
    const scrollBottomBtn = document.getElementById('scrollBottomBtn');

    // Auto-resizing textarea & keyboard submission
    if (chatInput && chatSendBtn) {
        chatInput.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 160) + 'px';
        });

        chatInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendChatMessage();
            }
        });
    }

    // Scroll-to-bottom visibility listener
    if (chatMessages && scrollBottomBtn) {
        chatMessages.addEventListener('scroll', () => {
            const distanceFromBottom = chatMessages.scrollHeight - chatMessages.scrollTop - chatMessages.clientHeight;
            scrollBottomBtn.style.display = distanceFromBottom > 150 ? 'flex' : 'none';
        });

        scrollBottomBtn.addEventListener('click', () => {
            chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });
        });
    }

    function createSvgAvatar(role) {
        const avatar = document.createElement('div');
        avatar.className = `mp-chat-avatar mp-avatar-${role}`;
        avatar.setAttribute('aria-hidden', 'true');

        if (role === 'ai') {
            avatar.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"></rect><circle cx="12" cy="5" r="2"></circle><path d="M12 7v4"></path><line x1="8" y1="16" x2="8" y2="16"></line><line x1="16" y1="16" x2="16" y2="16"></line></svg>`;
        } else {
            avatar.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>`;
        }
        return avatar;
    }

    function appendTextMessage(role, text) {
        const div = document.createElement('div');
        div.className = `mp-chat-message mp-chat-${role}`;

        const avatar = createSvgAvatar(role);

        const bubble = document.createElement('div');
        bubble.className = 'mp-chat-bubble';
        bubble.innerHTML = formatMessageHtml(text);

        if (role === 'ai') {
            attachMessageToolbar(bubble, text);
        }

        div.appendChild(avatar);
        div.appendChild(bubble);
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function attachMessageToolbar(bubble, textToCopy) {
        const toolbar = document.createElement('div');
        toolbar.className = 'mp-msg-toolbar';

        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'mp-msg-copy-btn';
        copyBtn.title = 'Copy response to clipboard';
        copyBtn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copy</span>`;

        copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(textToCopy).then(() => {
                const span = copyBtn.querySelector('span');
                if (span) span.textContent = 'Copied!';
                copyBtn.style.color = '#34d399';
                setTimeout(() => {
                    if (span) span.textContent = 'Copy';
                    copyBtn.style.color = '';
                }, 2000);
            });
        });

        toolbar.appendChild(copyBtn);
        bubble.appendChild(toolbar);
    }

    function appendAiResponse(response) {
        const div = document.createElement('div');
        div.className = 'mp-chat-message mp-chat-ai';

        const avatar = createSvgAvatar('ai');

        const bubble = document.createElement('div');
        bubble.className = 'mp-chat-bubble';

        const message = document.createElement('div');
        message.innerHTML = formatMessageHtml(response.message || '');
        bubble.appendChild(message);

        if (response.workingSlipSummary) {
            bubble.appendChild(buildWorkingSlipSummary(response.workingSlipSummary));
        }

        if (Array.isArray(response.warnings) && response.warnings.length > 0) {
            const warnings = document.createElement('div');
            warnings.className = 'mp-chat-warnings';
            warnings.innerHTML = response.warnings
                .map(warning => `<div>${escapeHtml(warning)}</div>`)
                .join('');
            bubble.appendChild(warnings);
        }

        if (Array.isArray(response.knowledgeCards) && response.knowledgeCards.length > 0) {
            bubble.appendChild(buildKnowledgeCards(response.knowledgeCards));
        }

        if (Array.isArray(response.actions) && response.actions.length > 0) {
            const actions = document.createElement('div');
            actions.className = 'mp-chat-action-list';
            response.actions.forEach(action => actions.appendChild(buildActionCard(action)));
            bubble.appendChild(actions);
        }

        if (response.showBookAll && Array.isArray(response.actions) && response.actions.length > 0) {
            const footer = document.createElement('div');
            footer.className = 'mp-chat-book-footer';

            const btn = document.createElement('button');
            btn.className = 'mp-book-btn';
            btn.textContent = response.actions.length === 1
                ? 'Add & Open Slip'
                : 'Add All & Open Slip';
            btn.addEventListener('click', () => addAllAndBook(btn));

            footer.appendChild(btn);
            bubble.appendChild(footer);
        }

        if (Array.isArray(response.suggestedPrompts) && response.suggestedPrompts.length > 0) {
            bubble.appendChild(buildSuggestedPromptChips(response.suggestedPrompts));
        }

        attachMessageToolbar(bubble, response.message || '');

        div.appendChild(avatar);
        div.appendChild(bubble);
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;

        if (response.autoBook) {
            const bookBtn = bubble.querySelector('.mp-book-btn');
            if (bookBtn) {
                addAllAndBook(bookBtn);
            } else {
                addAllAndBookFromBubble(bubble);
            }
        }
    }

    function normalizeAction(action) {
        if (!action) return action;
        return {
            type: action.type || action.Type || 'add_bet',
            actionKey: action.actionKey || action.ActionKey || '',
            predictionId: action.predictionId || action.PredictionId || 0,
            homeTeam: action.homeTeam || action.HomeTeam || '',
            awayTeam: action.awayTeam || action.AwayTeam || '',
            league: action.league || action.League || '',
            matchDateLabel: action.matchDateLabel || action.MatchDateLabel || 'Today',
            kickoffTime: action.kickoffTime || action.KickoffTime || '',
            matchDateTimeUtc: action.matchDateTimeUtc || action.MatchDateTimeUtc || null,
            status: action.status || action.Status || 'Upcoming',
            actualScore: action.actualScore || action.ActualScore || null,
            market: action.market || action.Market || '',
            prediction: action.prediction || action.Prediction || '',
            explanation: action.explanation || action.Explanation || '',
            modelProbability: action.modelProbability !== undefined ? action.modelProbability : action.ModelProbability,
            marketProbability: action.marketProbability !== undefined ? action.marketProbability : action.MarketProbability,
            edgePoints: action.edgePoints !== undefined ? action.edgePoints : action.EdgePoints,
            estimatedOdds: action.estimatedOdds !== undefined ? action.estimatedOdds : action.EstimatedOdds,
            analysisSummary: action.analysisSummary || action.AnalysisSummary || null,
            analysisConfidence: action.analysisConfidence || action.AnalysisConfidence || null,
            insightBullets: action.insightBullets || action.InsightBullets || [],
            insightSource: action.insightSource || action.InsightSource || null,
            canBook: action.canBook !== undefined ? action.canBook : (action.CanBook !== undefined ? action.CanBook : true)
        };
    }

    function buildActionCard(rawAction) {
        const action = normalizeAction(rawAction);
        const card = document.createElement('div');
        card.className = 'mp-chat-action';

        // Header with teams and odds pill
        const header = document.createElement('div');
        header.className = 'mp-action-card-header';

        const teams = document.createElement('div');
        teams.className = 'mp-action-teams';
        teams.textContent = `${action.homeTeam} vs ${action.awayTeam}`;
        header.appendChild(teams);

        const pills = document.createElement('div');
        pills.className = 'mp-action-pills';

        if (action.status === 'Live') {
            const livePill = document.createElement('span');
            livePill.className = 'mp-pill-live';
            livePill.style.cssText = 'background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.4); font-weight: 700; padding: 2px 8px; border-radius: 9999px; font-size: 11px; display: inline-flex; align-items: center; gap: 4px;';
            livePill.innerHTML = '<span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:#ef4444; box-shadow: 0 0 6px #ef4444;"></span> LIVE';
            pills.appendChild(livePill);

            if (action.matchDateLabel && (action.matchDateLabel.includes('🎯') || action.matchDateLabel.includes('💎') || action.matchDateLabel.includes('🛡️'))) {
                const tierPill = document.createElement('span');
                const isValue = action.matchDateLabel.includes('💎');
                const isSafety = action.matchDateLabel.includes('🛡️');
                const tierColor = isValue ? '#f59e0b' : isSafety ? '#10b981' : '#38bdf8';
                const tierBg = isValue ? 'rgba(245, 158, 11, 0.15)' : isSafety ? 'rgba(16, 185, 129, 0.15)' : 'rgba(56, 189, 248, 0.15)';
                const tierBorder = isValue ? 'rgba(245, 158, 11, 0.3)' : isSafety ? 'rgba(16, 185, 129, 0.3)' : 'rgba(56, 189, 248, 0.3)';
                tierPill.style.cssText = `background: ${tierBg}; color: ${tierColor}; border: 1px solid ${tierBorder}; font-weight: 600; padding: 2px 8px; border-radius: 9999px; font-size: 11px;`;
                tierPill.textContent = action.matchDateLabel;
                pills.appendChild(tierPill);
            }
        }

        if (Number.isFinite(Number(action.estimatedOdds))) {
            const oddsPill = document.createElement('span');
            oddsPill.className = 'mp-pill-odds';
            oddsPill.textContent = `~${Number(action.estimatedOdds).toFixed(2)} odds`;
            pills.appendChild(oddsPill);
        }

        if (Number.isFinite(Number(action.edgePoints))) {
            const edgeVal = Number(action.edgePoints);
            const edgePill = document.createElement('span');
            edgePill.className = 'mp-pill-edge';
            edgePill.textContent = `${edgeVal >= 0 ? '+' : ''}${edgeVal.toFixed(1)} pts edge`;
            pills.appendChild(edgePill);
        }

        header.appendChild(pills);
        card.appendChild(header);

        // Metadata bar (date, league, market, pick, kickoff, status)
        const metaBar = document.createElement('div');
        metaBar.className = 'mp-action-meta-bar';

        const metaParts = [
            action.matchDateLabel || 'Today',
            action.league || 'Card',
            action.market || 'Market',
            action.prediction || 'Pick'
        ];
        if (action.kickoffTime) metaParts.push(action.kickoffTime);
        if (action.status) metaParts.push(action.status);

        metaBar.textContent = metaParts.join(' • ');
        card.appendChild(metaBar);

        // Statistical Probability Grid (if available)
        const hasModel = Number.isFinite(Number(action.modelProbability));
        const hasMarket = Number.isFinite(Number(action.marketProbability));
        if (hasModel || hasMarket) {
            const probGrid = document.createElement('div');
            probGrid.className = 'mp-action-prob-grid';

            if (hasModel) {
                const item = document.createElement('div');
                item.className = 'mp-prob-item';
                item.innerHTML = `<span class="mp-prob-label">Model Prob</span><span class="mp-prob-val" style="color:#38bdf8;">${(Number(action.modelProbability) * 100).toFixed(1)}%</span>`;
                probGrid.appendChild(item);
            }

            if (hasMarket) {
                const item = document.createElement('div');
                item.className = 'mp-prob-item';
                item.innerHTML = `<span class="mp-prob-label">Market Prob</span><span class="mp-prob-val" style="color:#94a3b8;">${(Number(action.marketProbability) * 100).toFixed(1)}%</span>`;
                probGrid.appendChild(item);
            }

            card.appendChild(probGrid);
        }

        // Explanation text
        if (action.explanation) {
            const explanation = document.createElement('div');
            explanation.className = 'mp-chat-action-explanation';
            explanation.innerHTML = formatMessageHtml(action.explanation);
            card.appendChild(explanation);
        }

        // Football Read / Insight section
        if (action.analysisSummary || (Array.isArray(action.insightBullets) && action.insightBullets.length > 0) || action.analysisConfidence || action.insightSource) {
            const insightPanel = document.createElement('div');
            insightPanel.className = 'mp-chat-insight';

            const insightHeader = document.createElement('div');
            insightHeader.className = 'mp-chat-insight-header';

            const insightTitle = document.createElement('div');
            insightTitle.className = 'mp-chat-insight-title';
            insightTitle.textContent = action.status === 'Live' ? '⚡ Live In-Play Research & Contrast' : 'Football Read';
            insightHeader.appendChild(insightTitle);

            if (action.analysisConfidence) {
                const confidenceChip = document.createElement('span');
                confidenceChip.className = 'mp-chat-insight-chip';
                confidenceChip.textContent = `${action.analysisConfidence} sample`;
                insightHeader.appendChild(confidenceChip);
            }

            if (action.insightSource) {
                const source = document.createElement('span');
                source.className = 'mp-chat-insight-source';
                source.textContent = action.insightSource;
                insightHeader.appendChild(source);
            }

            insightPanel.appendChild(insightHeader);

            if (action.analysisSummary) {
                const summary = document.createElement('div');
                summary.className = 'mp-chat-insight-summary';
                summary.innerHTML = formatMessageHtml(action.analysisSummary);
                insightPanel.appendChild(summary);
            }

            if (Array.isArray(action.insightBullets) && action.insightBullets.length > 0) {
                const bulletList = document.createElement('div');
                bulletList.className = 'mp-chat-insight-bullets';

                action.insightBullets.forEach(item => {
                    const bullet = document.createElement('div');
                    bullet.className = 'mp-chat-insight-bullet';
                    bullet.innerHTML = `• ${formatMessageHtml(item)}`;
                    bulletList.appendChild(bullet);
                });

                insightPanel.appendChild(bulletList);
            }

            card.appendChild(insightPanel);
        }

        if (action.actualScore) {
            const scoreDiv = document.createElement('div');
            scoreDiv.className = 'mp-chat-action-score';
            if (action.status === 'Live') {
                scoreDiv.style.cssText = 'color: #ef4444; font-weight: 600; display: flex; align-items: center; gap: 6px;';
                scoreDiv.innerHTML = `<span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:#ef4444; box-shadow: 0 0 6px #ef4444;"></span> Live Score: <strong>${action.actualScore}</strong>`;
            } else {
                scoreDiv.textContent = `Final score: ${action.actualScore}`;
            }
            card.appendChild(scoreDiv);
        }

        // Interactive "+ Add Market" button with animated checkmark feedback
        if (action.canBook !== false) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'mp-add-cart-btn mp-btn-sm';
            btn.textContent = `+ Add ${action.market}`;
            btn.dataset.home = action.homeTeam || '';
            btn.dataset.away = action.awayTeam || '';
            btn.dataset.league = action.league || '';
            btn.dataset.market = action.market || '';
            btn.dataset.prediction = action.prediction || '';
            btn.dataset.predictionId = action.predictionId ? String(action.predictionId) : '';
            btn.dataset.matchDatetimeUtc = action.matchDateTimeUtc || '';

            btn.addEventListener('click', () => {
                if (typeof addToCart === 'function') {
                    addToCart({
                        homeTeam: btn.dataset.home || '',
                        awayTeam: btn.dataset.away || '',
                        league: btn.dataset.league || '',
                        market: btn.dataset.market || '',
                        prediction: btn.dataset.prediction || '',
                        predictionId: btn.dataset.predictionId ? Number(btn.dataset.predictionId) : null,
                        matchDateTimeUtc: btn.dataset.matchDatetimeUtc || null
                    });
                }
                btn.textContent = '✓ Added to Slip';
                btn.classList.add('mp-btn-added');
                setTimeout(() => {
                    btn.textContent = `+ Add ${action.market}`;
                    btn.classList.remove('mp-btn-added');
                }, 2500);
            });

            card.appendChild(btn);
        } else if (action.status === 'Live') {
            const inplayBadge = document.createElement('div');
            inplayBadge.style.cssText = 'margin-top: 8px; padding: 6px 12px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 6px; color: #fca5a5; font-size: 12px; font-weight: 500; text-align: center;';
            inplayBadge.innerHTML = '⚡ <strong>Live In-Play</strong> • Bet live directly on bookmaker';
            card.appendChild(inplayBadge);
        }

        return card;
    }

    function buildWorkingSlipSummary(summary) {
        const shell = document.createElement('div');
        shell.className = 'mp-chat-working-slip';

        const title = document.createElement('div');
        title.className = 'mp-chat-working-slip-title';
        title.textContent = 'Working Slip';
        shell.appendChild(title);

        const stats = document.createElement('div');
        stats.className = 'mp-chat-working-slip-stats';
        const statParts = [
            `${Number(summary.count || 0)} leg${Number(summary.count || 0) === 1 ? '' : 's'}`,
            `${Number(summary.bookableCount || 0)} bookable`
        ];
        if (Array.isArray(summary.markets) && summary.markets.length > 0) {
            statParts.push(summary.markets.join(', '));
        }
        if (Number.isFinite(Number(summary.estimatedCombinedOdds))) {
            statParts.push(`~${Number(summary.estimatedCombinedOdds).toFixed(2)} combined odds`);
        }
        stats.textContent = statParts.join(' • ');
        shell.appendChild(stats);

        const bookingCode = summary.bookingCode || summary.BookingCode;
        if (bookingCode) {
            const codeEl = document.createElement('div');
            codeEl.className = 'mp-chat-booking-code';
            codeEl.style.cssText = 'margin-top: 6px; font-size: 0.85rem; display: flex; align-items: center; gap: 6px; color: var(--text-secondary);';
            codeEl.innerHTML = `📋 Code: <code class="mp-copyable-code" title="Click to copy">${escapeHtml(bookingCode)}</code>`;
            shell.appendChild(codeEl);
        }

        return shell;
    }

    function buildKnowledgeCards(cards) {
        const shell = document.createElement('div');
        shell.className = 'mp-chat-knowledge-list';

        cards.forEach(card => {
            const article = document.createElement('div');
            article.className = 'mp-chat-knowledge';

            const header = document.createElement('div');
            header.className = 'mp-chat-knowledge-header';

            const title = document.createElement('div');
            title.className = 'mp-chat-knowledge-title';
            title.textContent = card.title || 'Knowledge';
            header.appendChild(title);

            if (card.kind) {
                const kind = document.createElement('span');
                kind.className = 'mp-chat-knowledge-kind';
                kind.textContent = card.kind;
                header.appendChild(kind);
            }

            article.appendChild(header);

            const body = document.createElement('div');
            body.className = 'mp-chat-knowledge-body';
            body.innerHTML = formatMessageHtml(card.body || '');
            article.appendChild(body);

            shell.appendChild(article);
        });

        return shell;
    }

    function buildSuggestedPromptChips(prompts) {
        const shell = document.createElement('div');
        shell.className = 'mp-chat-chip-row';

        prompts.forEach(prompt => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'mp-chat-chip';
            button.textContent = prompt;
            button.addEventListener('click', () => sendSuggestedPrompt(prompt));
            shell.appendChild(button);
        });

        return shell;
    }

    function buildActionGrid(actions) {
        const container = document.createElement('div');
        container.className = 'mp-chat-action-list';
        (actions || []).forEach(action => container.appendChild(buildActionCard(action)));
        return container;
    }

    function buildKnowledgeCardList(cards) {
        return buildKnowledgeCards(cards);
    }

    function escapeHtml(text) {
        return String(text ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function formatMessageHtml(text) {
        if (!text) return '';
        const lines = text.split('\n');
        const outputLines = [];
        let inQuote = false;
        let quoteLines = [];

        function flushQuote() {
            if (quoteLines.length > 0) {
                outputLines.push(`<blockquote class="mp-chat-quote">${quoteLines.join('<br>')}</blockquote>`);
                quoteLines = [];
                inQuote = false;
            }
        }

        for (let line of lines) {
            const trimmed = line.trim();
            if (trimmed.startsWith('&gt;') || trimmed.startsWith('>')) {
                inQuote = true;
                const clean = trimmed.replace(/^(&gt;|>)\s?/, '');
                quoteLines.push(formatInline(clean));
            } else {
                flushQuote();
                outputLines.push(formatInline(line));
            }
        }
        flushQuote();

        return outputLines.join('<br>');
    }

    function formatInline(str) {
        const escaped = escapeHtml(str);
        return escaped
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/`(.*?)`/g, '<code class="mp-copyable-code" title="Click to copy" onclick="navigator.clipboard.writeText(\'$1\'); this.classList.add(\'copied\'); setTimeout(()=>this.classList.remove(\'copied\'), 1500);">$1</code>');
    }

    function addAllAndBook(btn) {
        const bubble = btn.closest('.mp-chat-bubble');
        if (!bubble) return;

        const addedCount = addAllAndBookFromBubble(bubble);
        if (addedCount <= 0) return;

        btn.textContent = `✓ Added ${addedCount} picks to slip!`;
        btn.disabled = true;
    }

    function addAllAndBookFromBubble(bubble) {
        const betBtns = bubble.querySelectorAll('.mp-add-cart-btn');
        if (betBtns.length === 0) return 0;

        let addedCount = 0;
        betBtns.forEach(b => {
            if (typeof addToCart === 'function') {
                addToCart({
                    homeTeam: b.dataset.home || '',
                    awayTeam: b.dataset.away || '',
                    league: b.dataset.league || '',
                    market: b.dataset.market || '',
                    prediction: b.dataset.prediction || '',
                    predictionId: b.dataset.predictionId ? Number(b.dataset.predictionId) : null,
                    matchDateTimeUtc: b.dataset.matchDatetimeUtc || null
                });
                addedCount++;
            }
        });

        if (addedCount > 0 && typeof openCartModal === 'function') {
            openCartModal();
        }

        return addedCount;
    }

    function showTypingIndicator() {
        const div = document.createElement('div');
        div.className = 'mp-chat-message mp-chat-ai mp-chat-typing';
        div.id = 'typingIndicator';

        const avatar = createSvgAvatar('ai');
        const bubble = document.createElement('div');
        bubble.className = 'mp-chat-bubble';
        bubble.innerHTML = `
            <div class="mp-typing-dots">
                <span></span><span></span><span></span>
            </div>
        `;

        div.appendChild(avatar);
        div.appendChild(bubble);
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function removeTypingIndicator() {
        const indicator = document.getElementById('typingIndicator');
        if (indicator) indicator.remove();
    }

    function sendSuggestedPrompt(prompt) {
        if (!chatInput || !chatSendBtn) return;
        chatInput.value = prompt;
        chatInput.style.height = 'auto';
        sendChatMessage();
    }

    function resetChatConversation() {
        if (!chatMessages) return;
        const welcome = document.getElementById('welcomeHero');
        chatMessages.innerHTML = '';
        if (welcome) {
            chatMessages.appendChild(welcome);
        } else {
            location.reload();
            return;
        }
        if (chatInput) {
            chatInput.value = '';
            chatInput.style.height = 'auto';
            chatInput.focus();
        }
    }

    async function sendChatMessage() {
        const message = chatInput.value.trim();
        if (!message) return;

        // Display user message in chat
        appendTextMessage('user', message);
        chatInput.value = '';
        chatInput.style.height = 'auto';
        chatSendBtn.disabled = true;

        showTypingIndicator();

        try {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 60000);

            const response = await fetch('/api/ai/chat/stream', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message }),
                signal: controller.signal
            });

            clearTimeout(timeoutId);
            removeTypingIndicator();

            if (!response.ok || !response.body) {
                const fallbackRes = await fetch('/api/ai/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message })
                });
                if (fallbackRes.ok) {
                    const data = await fallbackRes.json();
                    appendAiResponse(data);
                } else {
                    const errorData = await fallbackRes.json().catch(() => null);
                    const errorMsg = errorData?.message || 'Something went wrong. Please try again.';
                    appendAiResponse({ message: `❌ ${errorMsg}`, actions: [], showBookAll: false, warnings: [] });
                }
                return;
            }

            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let buffer = '';

            const messageDiv = document.createElement('div');
            messageDiv.className = 'mp-chat-message mp-chat-ai';
            const avatar = createSvgAvatar('ai');

            const bubble = document.createElement('div');
            bubble.className = 'mp-chat-bubble';

            const thinkingDiv = document.createElement('div');
            thinkingDiv.className = 'mp-chat-thinking';
            thinkingDiv.style.display = 'none';
            thinkingDiv.innerHTML = '<span class="mp-typing-dots" style="display:inline-flex;margin-right:6px"><span></span><span></span><span></span></span> <span class="thinking-text">Thinking...</span>';

            const textDiv = document.createElement('div');
            textDiv.className = 'mp-chat-text';

            bubble.appendChild(thinkingDiv);
            bubble.appendChild(textDiv);
            messageDiv.appendChild(avatar);
            messageDiv.appendChild(bubble);
            chatMessages.appendChild(messageDiv);

            let accumulatedText = '';
            const accumulatedCards = [];
            const accumulatedActions = [];

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n');
                buffer = lines.pop();

                for (const line of lines) {
                    const trimmed = line.trim();
                    if (!trimmed || !trimmed.startsWith('data: ')) continue;
                    const jsonStr = trimmed.slice(6);
                    try {
                        const chunk = JSON.parse(jsonStr);
                        const eventType = chunk.EventType || chunk.eventType;
                        if (eventType === 'thinking') {
                            thinkingDiv.style.display = 'flex';
                            thinkingDiv.querySelector('.thinking-text').textContent = chunk.Content || chunk.content || 'Analyzing live data...';
                            chatMessages.scrollTop = chatMessages.scrollHeight;
                        } else if (eventType === 'text') {
                            thinkingDiv.style.display = 'none';
                            accumulatedText += chunk.Content || chunk.content || '';
                            textDiv.innerHTML = formatMessageHtml(accumulatedText);
                            chatMessages.scrollTop = chatMessages.scrollHeight;
                        } else if (eventType === 'card' && (chunk.Card || chunk.card)) {
                            accumulatedCards.push(chunk.Card || chunk.card);
                        } else if (eventType === 'action' && (chunk.Action || chunk.action)) {
                            accumulatedActions.push(normalizeAction(chunk.Action || chunk.action));
                        } else if (eventType === 'metadata') {
                            const slipSummary = chunk.WorkingSlipSummary || chunk.workingSlipSummary;
                            if (slipSummary) {
                                bubble.appendChild(buildWorkingSlipSummary(slipSummary));
                            }

                            const warnings = chunk.Warnings || chunk.warnings;
                            if (Array.isArray(warnings) && warnings.length > 0) {
                                const warningsDiv = document.createElement('div');
                                warningsDiv.className = 'mp-chat-warnings';
                                warningsDiv.innerHTML = warnings
                                    .map(warning => `<div>${escapeHtml(warning)}</div>`)
                                    .join('');
                                bubble.appendChild(warningsDiv);
                            }

                            if (accumulatedCards.length > 0) {
                                bubble.appendChild(buildKnowledgeCards(accumulatedCards));
                            }

                            if (accumulatedActions.length > 0) {
                                const actionsDiv = document.createElement('div');
                                actionsDiv.className = 'mp-chat-action-list';
                                accumulatedActions.forEach(action => actionsDiv.appendChild(buildActionCard(action)));
                                bubble.appendChild(actionsDiv);
                            }

                            const showBookAll = chunk.ShowBookAll ?? chunk.showBookAll;
                            if (showBookAll && accumulatedActions.length > 0) {
                                const footer = document.createElement('div');
                                footer.className = 'mp-chat-book-footer';

                                const btn = document.createElement('button');
                                btn.className = 'mp-book-btn';
                                btn.textContent = accumulatedActions.length === 1
                                    ? 'Add & Open Slip'
                                    : 'Add All & Open Slip';
                                btn.addEventListener('click', () => addAllAndBook(btn));

                                footer.appendChild(btn);
                                bubble.appendChild(footer);
                            }

                            const suggestedPrompts = chunk.SuggestedPrompts || chunk.suggestedPrompts;
                            if (Array.isArray(suggestedPrompts) && suggestedPrompts.length > 0) {
                                bubble.appendChild(buildSuggestedPromptChips(suggestedPrompts));
                            }

                            const autoBook = chunk.AutoBook ?? chunk.autoBook;
                            if (autoBook) {
                                const bookBtn = bubble.querySelector('.mp-book-btn');
                                if (bookBtn) {
                                    addAllAndBook(bookBtn);
                                } else {
                                    addAllAndBookFromBubble(bubble);
                                }
                            }

                            chatMessages.scrollTop = chatMessages.scrollHeight;
                        }
                    } catch (parseErr) {
                        // ignore malformed chunks
                    }
                }
            }

            thinkingDiv.remove();
            attachMessageToolbar(bubble, accumulatedText);

        } catch (err) {
            removeTypingIndicator();
            if (err.name === 'AbortError') {
                appendAiResponse({ message: '⏳ Request timed out. The AI service may be busy — please try again in a moment.', actions: [], showBookAll: false, warnings: [] });
            } else {
                appendAiResponse({ message: '❌ Network error. Please check your connection and try again.', actions: [], showBookAll: false, warnings: [] });
            }
        } finally {
            chatSendBtn.disabled = false;
            chatInput.focus();
        }
    }

    document.querySelectorAll('[data-chat-prompt]').forEach(button => {
        button.addEventListener('click', () => sendSuggestedPrompt(button.getAttribute('data-chat-prompt')));
    });
</script>
}
