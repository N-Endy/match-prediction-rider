@page
@model MatchPredictor.Web.Pages.AiChatModel

@{
    ViewData["Title"] = "AI Chat";
}

<div class="mp-container">
    <div class="mp-page-header">
        <div>
            <p class="mp-page-kicker">Companion</p>
            <div class="mp-page-title">
                <div class="mp-page-title-icon mp-chat-title-icon" aria-hidden="true">🤖</div>
                <h1>AI Betting Companion</h1>
            </div>
        </div>
        @if (Model.ShowLogout)
        {
            <form method="post" asp-page-handler="Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="mp-book-btn mp-chat-logout">
                    Log Out
                </button>
            </form>
        }
    </div>

@if (!Model.IsAuthenticated)
{
    <div class="mp-chat-auth">
        <h2 class="mp-chat-auth-title">Access restricted</h2>
        <p class="mp-chat-auth-copy">
            Enter the password to open the AI prediction advisor.
        </p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mp-chat-auth-error" role="alert">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" class="mp-chat-auth-form">
            @Html.AntiForgeryToken()
            <label class="mp-chat-auth-label" asp-for="Password">Password</label>
            <input type="password" asp-for="Password"
                   class="mp-chat-input"
                   autocomplete="current-password"
                   required autofocus />
            <button type="submit" class="mp-book-btn mp-chat-auth-submit">
                Unlock Chat
            </button>
        </form>
    </div>
}
else
{
    <div class="mp-chat-container" id="chatContainer">
        <div class="mp-chat-messages" id="chatMessages">
            <div class="mp-chat-message mp-chat-ai">
                <div class="mp-chat-avatar" aria-hidden="true">🤖</div>
                <div class="mp-chat-bubble">
                    <p>Hello! I'm Nelson, your grounded betting companion. I work from MatchPredictor's live card, recent published history, and the app's public analytics logic, so I can help you build slips, refine them, and explain what the app is showing without guessing.</p>
                    <p class="mp-chat-hint">Try asking</p>
                    <div class="mp-chat-chip-row">
                        <button type="button" class="mp-chat-chip" data-chat-prompt="Give me 10 of the best BTTS predictions">Give me 10 of the best BTTS predictions</button>
                        <button type="button" class="mp-chat-chip" data-chat-prompt="Give me a mixture of btts, over 2.5 and straight win">Give me a mixture of BTTS, Over 2.5 and Straight Win</button>
                        <button type="button" class="mp-chat-chip" data-chat-prompt="Which draw games would you recommend?">Which draw games would you recommend?</button>
                        <button type="button" class="mp-chat-chip" data-chat-prompt="Which is riskiest?">Which is riskiest?</button>
                        <button type="button" class="mp-chat-chip" data-chat-prompt="Why isn't this in value bets?">Why isn't this in value bets?</button>
                        <button type="button" class="mp-chat-chip" data-chat-prompt="What does reliability mean?">What does reliability mean?</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="mp-chat-input-area">
            <div class="mp-chat-composer">
                <input type="text" id="chatInput" class="mp-chat-input"
                       placeholder="Ask about today's picks or a recent settled match..."
                       autocomplete="off" />
                <button type="button" id="chatSendBtn" class="mp-chat-send-btn" onclick="sendChatMessage()">
                    Send
                </button>
            </div>
        </div>
    </div>
}
</div>

@section Scripts {
<script>
    const chatMessages = document.getElementById('chatMessages');
    const chatInput = document.getElementById('chatInput');
    const chatSendBtn = document.getElementById('chatSendBtn');
    if (chatInput && chatSendBtn) {
        chatInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendChatMessage();
            }
        });
    }

    function appendTextMessage(role, text) {
        const div = document.createElement('div');
        div.className = `mp-chat-message mp-chat-${role}`;

        const avatar = document.createElement('div');
        avatar.className = 'mp-chat-avatar';
        avatar.textContent = role === 'ai' ? '🤖' : '👤';

        const bubble = document.createElement('div');
        bubble.className = 'mp-chat-bubble';
        bubble.innerHTML = formatMessageHtml(text);

        div.appendChild(avatar);
        div.appendChild(bubble);
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function appendAiResponse(response) {
        const div = document.createElement('div');
        div.className = 'mp-chat-message mp-chat-ai';

        const avatar = document.createElement('div');
        avatar.className = 'mp-chat-avatar';
        avatar.textContent = '🤖';

        const bubble = document.createElement('div');
        bubble.className = 'mp-chat-bubble';

        const message = document.createElement('div');
        message.innerHTML = formatMessageHtml(response.message || '');
        bubble.appendChild(message);

        if (response.workingSlipSummary) {
            bubble.appendChild(buildWorkingSlipSummary(response.workingSlipSummary));
        }

        if (Array.isArray(response.warnings) && response.warnings.length > 0) {
            const warnings = document.createElement('div');
            warnings.className = 'mp-chat-warnings';
            warnings.innerHTML = response.warnings
                .map(warning => `<div>${escapeHtml(warning)}</div>`)
                .join('');
            bubble.appendChild(warnings);
        }

        if (Array.isArray(response.knowledgeCards) && response.knowledgeCards.length > 0) {
            bubble.appendChild(buildKnowledgeCards(response.knowledgeCards));
        }

        if (Array.isArray(response.actions) && response.actions.length > 0) {
            const actions = document.createElement('div');
            actions.className = 'mp-chat-action-list';
            response.actions.forEach(action => actions.appendChild(buildActionCard(action)));
            bubble.appendChild(actions);
        }

        if (response.showBookAll && Array.isArray(response.actions) && response.actions.length > 0) {
            const footer = document.createElement('div');
            footer.className = 'mp-chat-book-footer';

            const btn = document.createElement('button');
            btn.className = 'mp-book-btn';
            btn.textContent = response.actions.length === 1
                ? 'Add & Open Slip'
                : 'Add All & Open Slip';
            btn.addEventListener('click', () => addAllAndBook(btn));

            footer.appendChild(btn);
            bubble.appendChild(footer);
        }

        if (Array.isArray(response.suggestedPrompts) && response.suggestedPrompts.length > 0) {
            bubble.appendChild(buildSuggestedPromptChips(response.suggestedPrompts));
        }

        div.appendChild(avatar);
        div.appendChild(bubble);
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;

        if (response.autoBook) {
            const bookBtn = bubble.querySelector('.mp-book-btn');
            if (bookBtn) {
                addAllAndBook(bookBtn);
            } else {
                addAllAndBookFromBubble(bubble);
            }
        }
    }

    function buildActionCard(action) {
        const card = document.createElement('div');
        card.className = 'mp-chat-action';

        const title = document.createElement('div');
        title.className = 'mp-chat-action-title';
        title.textContent = `${action.homeTeam} vs ${action.awayTeam}`;
        card.appendChild(title);

        const meta = document.createElement('div');
        meta.className = 'mp-chat-action-meta';
        const metaParts = [
            action.matchDateLabel || 'Today',
            action.league || 'Card',
            action.market || 'Market',
            action.prediction || 'Pick'
        ];
        if (action.kickoffTime) {
            metaParts.push(action.kickoffTime);
        }
        if (action.status) {
            metaParts.push(action.status);
        }
        if (Number.isFinite(Number(action.estimatedOdds))) {
            metaParts.push(`~${Number(action.estimatedOdds).toFixed(2)} odds`);
        }
        meta.textContent = metaParts.join(' • ');
        card.appendChild(meta);

        const statParts = [];
        if (Number.isFinite(Number(action.modelProbability))) {
            statParts.push(`Model ${(Number(action.modelProbability) * 100).toFixed(1)}%`);
        }
        if (Number.isFinite(Number(action.marketProbability))) {
            statParts.push(`Market ${(Number(action.marketProbability) * 100).toFixed(1)}%`);
        }
        if (Number.isFinite(Number(action.edgePoints))) {
            const edge = Number(action.edgePoints);
            statParts.push(`Edge ${edge >= 0 ? '+' : ''}${edge.toFixed(1)} pts`);
        }

        if (statParts.length > 0) {
            const stats = document.createElement('div');
            stats.className = 'mp-chat-action-stats';
            stats.textContent = statParts.join(' • ');
            card.appendChild(stats);
        }

        if (action.explanation) {
            const explanation = document.createElement('div');
            explanation.className = 'mp-chat-action-explanation';
            explanation.innerHTML = formatMessageHtml(action.explanation);
            card.appendChild(explanation);
        }

        if (action.analysisSummary || (Array.isArray(action.insightBullets) && action.insightBullets.length > 0) || action.analysisConfidence || action.insightSource) {
            const insightPanel = document.createElement('div');
            insightPanel.className = 'mp-chat-insight';

            const insightHeader = document.createElement('div');
            insightHeader.className = 'mp-chat-insight-header';

            const insightTitle = document.createElement('div');
            insightTitle.className = 'mp-chat-insight-title';
            insightTitle.textContent = 'Football Read';
            insightHeader.appendChild(insightTitle);

            if (action.analysisConfidence) {
                const confidenceChip = document.createElement('span');
                confidenceChip.className = 'mp-chat-insight-chip';
                confidenceChip.textContent = `${action.analysisConfidence} sample`;
                insightHeader.appendChild(confidenceChip);
            }

            if (action.insightSource) {
                const source = document.createElement('span');
                source.className = 'mp-chat-insight-source';
                source.textContent = action.insightSource;
                insightHeader.appendChild(source);
            }

            insightPanel.appendChild(insightHeader);

            if (action.analysisSummary) {
                const summary = document.createElement('div');
                summary.className = 'mp-chat-insight-summary';
                summary.innerHTML = formatMessageHtml(action.analysisSummary);
                insightPanel.appendChild(summary);
            }

            if (Array.isArray(action.insightBullets) && action.insightBullets.length > 0) {
                const bulletList = document.createElement('div');
                bulletList.className = 'mp-chat-insight-bullets';

                action.insightBullets.forEach(item => {
                    const bullet = document.createElement('div');
                    bullet.className = 'mp-chat-insight-bullet';
                    bullet.innerHTML = `• ${formatMessageHtml(item)}`;
                    bulletList.appendChild(bullet);
                });

                insightPanel.appendChild(bulletList);
            }

            card.appendChild(insightPanel);
        }

        if (action.actualScore) {
            const settledScore = document.createElement('div');
            settledScore.className = 'mp-chat-action-score';
            settledScore.textContent = `Final score: ${action.actualScore}`;
            card.appendChild(settledScore);
        }

        if (action.canBook !== false) {
            const btn = document.createElement('button');
            btn.className = 'mp-add-cart-btn mp-btn-sm';
            btn.textContent = `+ Add ${action.market}`;
            btn.dataset.home = action.homeTeam || '';
            btn.dataset.away = action.awayTeam || '';
            btn.dataset.league = action.league || '';
            btn.dataset.market = action.market || '';
            btn.dataset.prediction = action.prediction || '';
            btn.dataset.predictionId = action.predictionId ? String(action.predictionId) : '';
            btn.dataset.matchDatetimeUtc = action.matchDateTimeUtc || '';
            card.appendChild(btn);
        }

        return card;
    }

    function buildWorkingSlipSummary(summary) {
        const shell = document.createElement('div');
        shell.className = 'mp-chat-working-slip';

        const title = document.createElement('div');
        title.className = 'mp-chat-working-slip-title';
        title.textContent = 'Working Slip';
        shell.appendChild(title);

        const stats = document.createElement('div');
        stats.className = 'mp-chat-working-slip-stats';
        const statParts = [
            `${Number(summary.count || 0)} leg${Number(summary.count || 0) === 1 ? '' : 's'}`,
            `${Number(summary.bookableCount || 0)} bookable`
        ];
        if (Array.isArray(summary.markets) && summary.markets.length > 0) {
            statParts.push(summary.markets.join(', '));
        }
        if (Number.isFinite(Number(summary.estimatedCombinedOdds))) {
            statParts.push(`~${Number(summary.estimatedCombinedOdds).toFixed(2)} combined odds`);
        }
        stats.textContent = statParts.join(' • ');
        shell.appendChild(stats);

        return shell;
    }

    function buildKnowledgeCards(cards) {
        const shell = document.createElement('div');
        shell.className = 'mp-chat-knowledge-list';

        cards.forEach(card => {
            const article = document.createElement('div');
            article.className = 'mp-chat-knowledge';

            const header = document.createElement('div');
            header.className = 'mp-chat-knowledge-header';

            const title = document.createElement('div');
            title.className = 'mp-chat-knowledge-title';
            title.textContent = card.title || 'Knowledge';
            header.appendChild(title);

            if (card.kind) {
                const kind = document.createElement('span');
                kind.className = 'mp-chat-knowledge-kind';
                kind.textContent = card.kind;
                header.appendChild(kind);
            }

            article.appendChild(header);

            const body = document.createElement('div');
            body.className = 'mp-chat-knowledge-body';
            body.innerHTML = formatMessageHtml(card.body || '');
            article.appendChild(body);

            shell.appendChild(article);
        });

        return shell;
    }

    function buildSuggestedPromptChips(prompts) {
        const shell = document.createElement('div');
        shell.className = 'mp-chat-chip-row';

        prompts.forEach(prompt => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'mp-chat-chip';
            button.textContent = prompt;
            button.addEventListener('click', () => sendSuggestedPrompt(prompt));
            shell.appendChild(button);
        });

        return shell;
    }

    function escapeHtml(text) {
        return String(text ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function formatMessageHtml(text) {
        const escaped = escapeHtml(text);
        return escaped
            .replace(/\n/g, '<br>')
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/`(.*?)`/g, '<code>$1</code>');
    }

    // Agentic UI Action
    function addAllAndBook(btn) {
        const bubble = btn.closest('.mp-chat-bubble');
        if (!bubble) return;

        const addedCount = addAllAndBookFromBubble(bubble);
        if (addedCount <= 0) return;

        btn.textContent = `Added ${addedCount} picks!`;
        btn.disabled = true;
    }

    function addAllAndBookFromBubble(bubble) {
        const betBtns = bubble.querySelectorAll('.mp-add-cart-btn');
        if (betBtns.length === 0) return 0;

        let addedCount = 0;
        betBtns.forEach(b => {
            if (typeof addToCart === 'function') {
                addToCart({
                    homeTeam: b.dataset.home || '',
                    awayTeam: b.dataset.away || '',
                    league: b.dataset.league || '',
                    market: b.dataset.market || '',
                    prediction: b.dataset.prediction || '',
                    predictionId: b.dataset.predictionId ? Number(b.dataset.predictionId) : null,
                    matchDateTimeUtc: b.dataset.matchDatetimeUtc || null
                });
                addedCount++;
            }
        });

        if (addedCount > 0 && typeof openCartModal === 'function') {
            openCartModal();
        }

        return addedCount;
    }

    function showTypingIndicator() {
        const div = document.createElement('div');
        div.className = 'mp-chat-message mp-chat-ai mp-chat-typing';
        div.id = 'typingIndicator';
        div.innerHTML = `
            <div class="mp-chat-avatar">🤖</div>
            <div class="mp-chat-bubble">
                <div class="mp-typing-dots">
                    <span></span><span></span><span></span>
                </div>
            </div>
        `;
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function removeTypingIndicator() {
        const indicator = document.getElementById('typingIndicator');
        if (indicator) indicator.remove();
    }

    function sendSuggestedPrompt(prompt) {
        if (!chatInput || !chatSendBtn) return;
        chatInput.value = prompt;
        sendChatMessage();
    }

    async function sendChatMessage() {
        const message = chatInput.value.trim();
        if (!message) return;

        // Show user message
        appendTextMessage('user', message);
        chatInput.value = '';
        chatSendBtn.disabled = true;

        showTypingIndicator();

        try {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 30000);

            const response = await fetch('/api/ai/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message }),
                signal: controller.signal
            });

            clearTimeout(timeoutId);
            removeTypingIndicator();

            if (response.ok) {
                const data = await response.json();
                appendAiResponse(data);
            } else {
                const errorData = await response.json().catch(() => null);
                const errorMsg = errorData?.message || 'Something went wrong. Please try again.';
                appendAiResponse({ message: `❌ ${errorMsg}`, actions: [], showBookAll: false, warnings: [] });
            }
        } catch (err) {
            removeTypingIndicator();
            if (err.name === 'AbortError') {
                appendAiResponse({ message: '⏳ Request timed out. The AI service may be busy — please try again in a moment.', actions: [], showBookAll: false, warnings: [] });
            } else {
                appendAiResponse({ message: '❌ Network error. Please check your connection and try again.', actions: [], showBookAll: false, warnings: [] });
            }
        } finally {
            chatSendBtn.disabled = false;
            chatInput.focus();
        }
    }

    document.querySelectorAll('[data-chat-prompt]').forEach(button => {
        button.addEventListener('click', () => sendSuggestedPrompt(button.getAttribute('data-chat-prompt')));
    });
</script>
}
