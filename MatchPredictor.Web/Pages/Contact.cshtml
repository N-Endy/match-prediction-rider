@page
@model ContactModel
@{
    ViewData["Title"] = "Contact";
    ViewData["Description"] = "Contact MatchPredictor at hello@matchpredictor.dev for score corrections, privacy questions, press, or general feedback.";
}

<div class="mp-container mp-legal">
    <div class="mp-page-header">
        <div>
            <p class="mp-page-kicker">Contact</p>
            <div class="mp-page-title">
                <h1>Contact MatchPredictor</h1>
            </div>
        </div>
    </div>

    <p class="mp-legal-meta">
        Email: <a href="mailto:hello@matchpredictor.dev">hello@matchpredictor.dev</a>
    </p>

    <section class="mp-legal-section">
        <h2>How to reach us</h2>
        <p>
            There is no public registration form and we do not operate user accounts. The best way
            to contact the site operator is by email:
        </p>
        <p>
            <a href="mailto:hello@matchpredictor.dev"><strong>hello@matchpredictor.dev</strong></a>
        </p>
        <p>
            We read every message. Response times vary; please allow a few business days for a reply.
        </p>
    </section>

    <section class="mp-legal-section">
        <h2>What to include</h2>
        <ul>
            <li><strong>Score or settlement correction</strong> — fixture names, kickoff date, market, and what looks wrong.</li>
            <li><strong>Privacy or data request</strong> — describe the request; see also the <a href="/Privacy">Privacy Policy</a>.</li>
            <li><strong>Press or partnership</strong> — who you are and what you need.</li>
            <li><strong>General feedback</strong> — product ideas, accessibility issues, or broken links.</li>
        </ul>
    </section>

    <section class="mp-legal-section">
        <h2>Related pages</h2>
        <ul>
            <li><a href="/about">About MatchPredictor</a></li>
            <li><a href="/faq">Frequently asked questions</a></li>
            <li><a href="/methodology">Prediction methodology</a></li>
            <li><a href="/terms">Terms of Use</a></li>
            <li><a href="/Privacy">Privacy Policy</a></li>
            <li><a href="/Privacy#responsible-use">Responsible use</a></li>
        </ul>
    </section>
</div>
