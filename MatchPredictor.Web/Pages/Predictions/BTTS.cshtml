@page
@model MatchPredictor.Web.Pages.Predictions.BTTS

@{
    ViewData["Title"] = "Both Teams to Score";
    var today = MatchPredictor.Infrastructure.Utils.DateTimeProvider.GetLocalTime().ToString("dd MMM yyyy");
}

<div class="mp-container">
    <div class="mp-page-header">
        <div>
            <p class="mp-page-kicker">Today’s card</p>
            <div class="mp-page-title">
                <div class="mp-page-title-icon mp-icon-btts">⚽</div>
                <h1>Both Teams to Score</h1>
            </div>
            <p class="mp-page-subtext">Filter the BTTS card by league, kickoff, status, and confidence before adding picks to the slip.</p>
        </div>
        <div class="mp-date-badge">@today</div>
    </div>

    <partial name="_PredictionPageFilters" model="Model" />

    @if (Model.VisibleMatchCount > 0)
    {
        <div class="mp-predictions-list">
            @{ int adIndex = 0; }
            @foreach (var match in Model.FilteredMatches)
            {
                if (adIndex > 0 && adIndex % 5 == 0)
                {
                    <partial name="_AdBanner" />
                }

                <partial name="_PredictionCard" model="match" />
                adIndex++;
            }
        </div>
    }
    else
    {
        <div class="mp-empty-state">
            <div class="mp-empty-state-icon">⚽</div>
            <p>@(Model.TotalMatchCount > 0 ? "No BTTS predictions match the current filters." : "No BTTS predictions available for today yet.")</p>
            <p class="mp-empty-state-hint">
                @(Model.TotalMatchCount > 0 ? "Try widening the confidence, league, or kickoff filters." : "Predictions are updated daily. Check back soon!")
            </p>
        </div>
    }
</div>
