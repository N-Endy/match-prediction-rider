@page
@model MatchPredictor.Web.Pages.Predictions.Draw

@{
    ViewData["Title"] = "Draw Predictions";
    var today = MatchPredictor.Infrastructure.Utils.DateTimeProvider.GetLocalTime().ToString("dd MMM yyyy");
}

<div class="mp-container">
    <div class="mp-page-header">
        <div class="mp-page-title">
            <div class="mp-page-title-icon" style="background: rgba(245, 158, 11, 0.1);">🤝</div>
            <div>
                <h1>Draw Predictions</h1>
                <p class="mp-page-subtext">Track the low-separation fixtures where the model still finds enough confidence for a published draw angle.</p>
            </div>
        </div>
        <div class="mp-date-badge">📅 @today</div>
    </div>

    <partial name="_PredictionPageFilters" model="Model" />

    @if (Model.VisibleMatchCount > 0)
    {
        <div class="mp-predictions-list">
            @{ int adIndex = 0; }
            @foreach (var match in Model.FilteredMatches)
            {
                if (adIndex > 0 && adIndex % 5 == 0)
                {
                    <partial name="_AdBanner" />
                }

                <partial name="_PredictionCard" model="match" />
                adIndex++;
            }
        </div>
    }
    else
    {
        <div class="mp-empty-state">
            <div class="mp-empty-state-icon">🤝</div>
            <p>@(Model.TotalMatchCount > 0 ? "No draw predictions match the current filters." : "No draw predictions available for today yet.")</p>
            <p style="font-size: 0.85rem; margin-top: 0.5rem;">
                @(Model.TotalMatchCount > 0 ? "Try widening the kickoff or confidence filters." : "Predictions are updated daily. Check back soon!")
            </p>
        </div>
    }
</div>

