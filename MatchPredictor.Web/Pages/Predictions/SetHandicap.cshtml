@page "/predictions/set-handicap"
@model MatchPredictor.Web.Pages.Predictions.SetHandicap

@{
    ViewData["Title"] = "Set Handicap";
    var today = MatchPredictor.Infrastructure.Utils.DateTimeProvider.GetLocalTime().ToString("dd MMM yyyy");
}

<div class="mp-container">
    <div class="mp-page-header">
        <div class="mp-page-title">
            <div class="mp-page-title-icon" style="background: rgba(245, 158, 11, 0.12);">🧮</div>
            <div>
                <h1>Set Handicap</h1>
                <p class="mp-page-subtext">Published handicap sides built from the worksheet’s configured set lines and calibrated thresholds.</p>
            </div>
        </div>
        <div class="mp-date-badge">📅 @today</div>
    </div>

    <partial name="_PredictionPageFilters" model="Model" />

    @if (Model.VisibleMatchCount > 0)
    {
        <div class="mp-predictions-list">
            @foreach (var match in Model.FilteredMatches)
            {
                <partial name="_PredictionCard" model="match" />
            }
        </div>
    }
    else
    {
        <div class="mp-empty-state">
            <div class="mp-empty-state-icon">🧮</div>
            <p>@(Model.TotalMatchCount > 0 ? "No set-handicap predictions match the current filters." : "No set-handicap predictions are available for today yet.")</p>
            <p style="font-size: 0.85rem; margin-top: 0.5rem;">
                @(Model.TotalMatchCount > 0 ? "Try widening the confidence or tournament filters." : "The tennis card refreshes daily. Check back soon.")
            </p>
        </div>
    }
</div>
