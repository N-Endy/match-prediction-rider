@page
@model MatchPredictor.Web.Pages.Predictions.StraightWin

@{
    ViewData["Title"] = "Straight Win";
    var today = MatchPredictor.Infrastructure.Utils.DateTimeProvider.GetLocalTime().ToString("dd MMM yyyy");
}

<div class="mp-container">
    <div class="mp-page-header">
        <div>
            <p class="mp-page-kicker">Today’s card</p>
            <div class="mp-page-title">
                <div class="mp-page-title-icon mp-icon-win">🏆</div>
                <h1>Straight Win</h1>
            </div>
            <p class="mp-page-subtext">Spot the side-backed picks with enough confidence to clear the published win threshold.</p>
        </div>
        <div class="mp-date-badge">@today</div>
    </div>

    <partial name="_PredictionPageFilters" model="Model" />

    @if (Model.VisibleMatchCount > 0)
    {
        <div class="mp-predictions-list">
            @{ int adIndex = 0; }
            @foreach (var match in Model.FilteredMatches)
            {
                if (adIndex > 0 && adIndex % 5 == 0)
                {
                    <partial name="_AdBanner" />
                }

                <partial name="_PredictionCard" model="match" />
                adIndex++;
            }
        </div>
    }
    else
    {
        <div class="mp-empty-state">
            <div class="mp-empty-state-icon">🏆</div>
            <p>@(Model.TotalMatchCount > 0 ? "No straight-win predictions match the current filters." : "No straight-win predictions available for today yet.")</p>
            <p class="mp-empty-state-hint">
                @(Model.TotalMatchCount > 0 ? "Try relaxing the league, confidence, or status filters." : "Predictions are updated daily. Check back soon!")
            </p>
        </div>
    }
</div>
