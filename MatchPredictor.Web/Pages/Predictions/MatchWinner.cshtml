@page "/predictions/matchwinner"
@model MatchPredictor.Web.Pages.Predictions.MatchWinner

@{
    ViewData["Title"] = "Match Winner";
    var today = MatchPredictor.Infrastructure.Utils.DateTimeProvider.GetLocalTime().ToString("dd MMM yyyy");
}

<div class="mp-container">
    <div class="mp-page-header">
        <div class="mp-page-title">
            <div class="mp-page-title-icon" style="background: rgba(13, 148, 136, 0.14);">🎾</div>
            <div>
                <h1>Match Winner</h1>
                <p class="mp-page-subtext">Published player-side picks where the calibrated winner probability clears the active gate.</p>
            </div>
        </div>
        <div class="mp-date-badge">📅 @today</div>
    </div>

    <partial name="_PredictionPageFilters" model="Model" />

    @if (Model.VisibleMatchCount > 0)
    {
        <div class="mp-predictions-list">
            @foreach (var match in Model.FilteredMatches)
            {
                <partial name="_PredictionCard" model="match" />
            }
        </div>
    }
    else
    {
        <div class="mp-empty-state">
            <div class="mp-empty-state-icon">🎾</div>
            <p>@(Model.TotalMatchCount > 0 ? "No match-winner predictions match the current filters." : "No match-winner predictions are available for today yet.")</p>
            <p style="font-size: 0.85rem; margin-top: 0.5rem;">
                @(Model.TotalMatchCount > 0 ? "Try widening the confidence, tournament, or status filters." : "The tennis card refreshes daily. Check back soon.")
            </p>
        </div>
    }
</div>
