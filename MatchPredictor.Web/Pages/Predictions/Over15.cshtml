@page
@model MatchPredictor.Web.Pages.Predictions.Over15

@{
    ViewData["Title"] = "Over 1.5 Goals";
    ViewData["Description"] = "Today’s high-frequency Over 1.5 Goals card from MatchPredictor — calibrated totals predictions for games with strong multi-goal offensive expectancy.";
    var today = MatchPredictor.Infrastructure.Utils.DateTimeProvider.GetLocalTime().ToString("dd MMM yyyy");
}

<div class="mp-container">
    <div class="mp-page-header">
        <div>
            <p class="mp-page-kicker">Today’s card</p>
            <div class="mp-page-title">
                <div class="mp-page-title-icon mp-icon-over">⚽</div>
                <h1>Over 1.5 Goals</h1>
            </div>
            <p class="mp-page-subtext">Scan for high-conviction games with at least 2 total goals, filtered by league, kickoff window, status, and confidence.</p>
        </div>
        <div class="mp-date-badge">@today</div>
    </div>

    <partial name="_PredictionPageFilters" model="Model" />

    @if (Model.VisibleMatchCount > 0)
    {
        <div class="mp-predictions-list">
            @{ int adIndex = 0; }
            @foreach (var match in Model.FilteredMatches)
            {
                if (adIndex > 0 && adIndex % 5 == 0)
                {
                    <partial name="_AdBanner" />
                }

                <partial name="_PredictionCard" model="match" />
                adIndex++;
            }
        </div>
    }
    else
    {
        <div class="mp-empty-state">
            <div class="mp-empty-state-icon">⚽</div>
            <p>@(Model.TotalMatchCount > 0 ? "No Over 1.5 predictions match the current filters." : "No Over 1.5 goals predictions available for today yet.")</p>
            <p class="mp-empty-state-hint">
                @(Model.TotalMatchCount > 0 ? "Try widening the filters or checking another kickoff window." : "Predictions are updated daily. Check back soon!")
            </p>
        </div>
    }
</div>
