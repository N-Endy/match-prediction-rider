@page
@model MatchPredictor.Web.Pages.Predictions.Combined

@{
    ViewData["Title"] = "Combined Predictions";
    var today = MatchPredictor.Infrastructure.Utils.DateTimeProvider.GetLocalTime().ToString("dd MMM yyyy");
}

<div class="mp-container">
    <div class="mp-page-header">
        <div class="mp-page-title">
            <div class="mp-page-title-icon" style="background: rgba(6, 182, 212, 0.1);">📊</div>
            <div>
                <h1>Combined Predictions</h1>
                <p class="mp-page-subtext">A wider mixed-market card you can search, filter, and trim before building a more intentional slip.</p>
            </div>
        </div>
        <div class="mp-date-badge">📅 @today</div>
    </div>

    <partial name="_PredictionPageFilters" model="Model" />

    @if (Model.VisibleMatchCount > 0)
    {
        <div class="mp-predictions-list">
            @{ int adIndex = 0; }
            @foreach (var match in Model.FilteredMatches)
            {
                if (adIndex > 0 && adIndex % 5 == 0)
                {
                    <partial name="_AdBanner" />
                }

                <partial name="_PredictionCard" model="match" />
                adIndex++;
            }
        </div>
    }
    else
    {
        <div class="mp-empty-state">
            <div class="mp-empty-state-icon">📊</div>
            <p>@(Model.TotalMatchCount > 0 ? "No combined predictions match the current filters." : "No combined predictions available for today yet.")</p>
            <p style="font-size: 0.85rem; margin-top: 0.5rem;">
                @(Model.TotalMatchCount > 0 ? "Try resetting the filters to bring more of the card back in." : "Predictions are updated daily. Check back soon!")
            </p>
        </div>
    }
</div>
