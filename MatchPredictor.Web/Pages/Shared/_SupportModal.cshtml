@* Support / Appreciation Modal Partial *@
<div class="mp-modal-backdrop" id="supportModal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="supportModalTitle">
    <div class="mp-modal-box mp-support-modal-box">
        <div class="mp-modal-header">
            <div class="mp-modal-title-wrap">
                <span class="mp-support-heart-icon" aria-hidden="true">💚</span>
                <h2 id="supportModalTitle" class="mp-modal-title">Support MatchPredictor</h2>
            </div>
            <button type="button" class="mp-modal-close-btn" id="closeSupportModalBtn" aria-label="Close modal">✕</button>
        </div>

        <div class="mp-modal-body">
            <p class="mp-modal-description">
                Did our statistical models or curated selection slips help you win today? You can send a token of appreciation to keep our servers running and support continued AI model training.
            </p>

            <div class="mp-support-beneficiary-tag" style="margin-bottom: 1.25rem;">
                <span class="mp-support-tag-label">Account Name:</span>
                <strong class="mp-support-tag-name">Okafor Nelson</strong>
            </div>

            <div class="mp-support-bank-grid">
                <!-- Access Bank -->
                <div class="mp-bank-card mp-bank-access">
                    <div class="mp-bank-card-top">
                        <span class="mp-bank-badge mp-badge-access">Access Bank</span>
                        <span class="mp-bank-currency">NGN</span>
                    </div>
                    <div class="mp-bank-number-row">
                        <span class="mp-bank-number" data-account="1401602266">1401602266</span>
                        <button type="button" class="mp-copy-acc-btn" data-copy-account="1401602266" aria-label="Copy Access Bank account number">
                            <svg class="mp-copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                            </svg>
                            <span class="mp-copy-text">Copy</span>
                        </button>
                    </div>
                </div>

                <!-- Kuda Bank -->
                <div class="mp-bank-card mp-bank-kuda">
                    <div class="mp-bank-card-top">
                        <span class="mp-bank-badge mp-badge-kuda">Kuda Bank</span>
                        <span class="mp-bank-currency">NGN</span>
                    </div>
                    <div class="mp-bank-number-row">
                        <span class="mp-bank-number" data-account="1100979917">1100979917</span>
                        <button type="button" class="mp-copy-acc-btn" data-copy-account="1100979917" aria-label="Copy Kuda Bank account number">
                            <svg class="mp-copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                            </svg>
                            <span class="mp-copy-text">Copy</span>
                        </button>
                    </div>
                </div>
            </div>

            <p class="mp-support-modal-note">
                ✨ Thank you for using and supporting MatchPredictor!
            </p>
        </div>
    </div>
</div>
