@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    var adClientId = Configuration["AdSense:ClientId"] ?? "ca-pub-123456789";
}

<div class="mp-ad-wrapper">
    <!-- MatchPredictor - In-article banner -->
    <ins class="adsbygoogle mp-ad-ins"
         style="display:block"
         data-ad-client="@adClientId"
         data-ad-slot="9092164564"
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>
    <script>
        (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
    <div class="mp-ad-fallback">
        <span>Advertisement</span>
    </div>
</div>