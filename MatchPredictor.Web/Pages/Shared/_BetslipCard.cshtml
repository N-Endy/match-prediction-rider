@model MatchPredictor.Domain.Models.Betslip
@using MatchPredictor.Domain.Models
@using MatchPredictor.Application.Services
@{
    var isRollover = Model.SlipNumber == BetslipGenerationService.RolloverSlipNumber
                     || Model.TierLabel.StartsWith("Rollover", StringComparison.OrdinalIgnoreCase);
    var isBanker = Model.SlipNumber == BetslipGenerationService.BankerSlipNumber
                   || Model.TierLabel.StartsWith("Banker", StringComparison.OrdinalIgnoreCase);
    var isDrawSlip = string.Equals(Model.TierLabel, "AI Draws (5)", StringComparison.Ordinal);
    var isMega = Model.TierLabel.StartsWith("Mega", StringComparison.OrdinalIgnoreCase);
    var isPayoutBand = !isBanker && !isRollover && !isDrawSlip && Model.CombinedDecimalOdds is > 1;
    var referenceStake = ViewData["ReferenceStakeNaira"] as decimal? ?? 100m;
    var estimatedReturn = isPayoutBand
        ? referenceStake * (decimal)Model.CombinedDecimalOdds!.Value
        : (decimal?)null;
    var statusClass = Model.BookingStatus switch
    {
        BetslipBookingStatuses.Booked => "mp-betslip-status-booked",
        BetslipBookingStatuses.Partial => "mp-betslip-status-partial",
        _ => "mp-betslip-status-failed"
    };
    var bookedCount = Model.Selections.Count(s => s.WasBooked);
    var cardClass = isRollover
        ? "mp-betslip-card mp-betslip-card-rollover"
        : isBanker
            ? "mp-betslip-card mp-betslip-card-banker"
            : isDrawSlip
                ? "mp-betslip-card mp-betslip-card-ai"
                : isMega
                    ? "mp-betslip-card mp-betslip-card-mega"
                    : "mp-betslip-card";

    static string FormatNaira(decimal amount)
    {
        if (amount >= 1_000_000m)
        {
            return $"₦{(amount / 1_000_000m):0.##}M";
        }

        if (amount >= 1000m)
        {
            return $"₦{(amount / 1000m):0.##}k";
        }

        return $"₦{amount:0.##}";
    }
}

<article class="@cardClass">
    <header class="mp-betslip-card-header">
        <div>
            <span class="mp-betslip-tier">@Model.TierLabel</span>
            <h2 class="mp-betslip-title">@Model.Title</h2>
        </div>
        <span class="mp-betslip-status @statusClass">@Model.BookingStatus</span>
    </header>

    @if ((isBanker || isRollover) && Model.CombinedDecimalOdds is > 1)
    {
        <div class="@(isRollover ? "mp-betslip-rollover-odds" : "mp-betslip-banker-odds")">
            <span class="@(isRollover ? "mp-betslip-rollover-odds-value" : "mp-betslip-banker-odds-value")">@Model.CombinedDecimalOdds.Value.ToString("0.00")x</span>
            <span class="@(isRollover ? "mp-betslip-rollover-odds-label" : "mp-betslip-banker-odds-label")">@(isRollover ? "single-leg odds" : "total odds")</span>
        </div>
    }

    @if (isPayoutBand)
    {
        <div class="mp-betslip-payout-strip">
            <div>
                <span class="mp-betslip-metric-label">Combined odds</span>
                <strong>@Model.CombinedDecimalOdds!.Value.ToString("0.00")x</strong>
            </div>
            <div>
                <span class="mp-betslip-metric-label">Est. return @FormatNaira(referenceStake)</span>
                <strong>@FormatNaira(estimatedReturn!.Value)</strong>
            </div>
        </div>
    }

    <div class="mp-betslip-metrics">
        <div>
            <span class="mp-betslip-metric-label">Picks</span>
            <strong>@Model.SelectionCount</strong>
            @if (!isBanker && !isRollover && !isPayoutBand)
            {
                <span class="mp-betslip-metric-hint">target @Model.TargetMinSelections–@Model.TargetMaxSelections</span>
            }
            else if (isPayoutBand)
            {
                <span class="mp-betslip-metric-hint">max @Model.TargetMaxSelections</span>
            }
        </div>
        <div>
            <span class="mp-betslip-metric-label">Booked</span>
            <strong>@bookedCount</strong>
        </div>
        @if (!isBanker && !isRollover && !isPayoutBand && Model.CombinedDecimalOdds is > 1)
        {
            <div>
                <span class="mp-betslip-metric-label">Est. odds</span>
                <strong>@Model.CombinedDecimalOdds.Value.ToString("0.00")</strong>
            </div>
        }
    </div>

    @if (isRollover)
    {
        <p class="mp-betslip-rollover-disclaimer">
            Single stack-it-all pick. The whole bankroll from this bet rolls into the next one. Odds verified against live SportyBet at generation time.
        </p>
    }

    @if (isBanker)
    {
        <p class="mp-betslip-banker-disclaimer">
            High-stakes banker. Odds verified against live SportyBet at generation time; lines may drift before kickoff.
        </p>
    }

    @if (isMega)
    {
        <p class="mp-betslip-mega-disclaimer">
            Long-shot / lottery-tier ticket. Built from analysed picks, but hit rate is low by design.
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(Model.AiSummary))
    {
        <p class="mp-betslip-ai-summary">@Model.AiSummary</p>
    }

    @if (!string.IsNullOrWhiteSpace(Model.BookingCode))
    {
        <div class="mp-betslip-code-row">
            <code class="mp-betslip-code" id="betslip-code-@Model.Id">@Model.BookingCode</code>
            <div class="mp-betslip-code-actions">
                <button type="button"
                        class="mp-betslip-copy-btn"
                        data-copy-target="betslip-code-@Model.Id">
                    Copy
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.BookingUrl))
                {
                    <a class="mp-book-btn"
                       href="@Model.BookingUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        Open in SportyBet
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <p class="mp-betslip-warning">Booking code unavailable; retrying next run.</p>
    }

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <p class="mp-betslip-status-message">@Model.StatusMessage</p>
    }

    <details class="mp-betslip-details"@(isBanker || isRollover ? " open" : "")>
        <summary>View @Model.SelectionCount selections</summary>
        <ul class="mp-betslip-selection-list">
            @foreach (var selection in Model.Selections
                .OrderBy(s => s.MatchDateTimeUtc ?? DateTime.MaxValue)
                .ThenBy(s => s.League)
                .ThenBy(s => s.HomeTeam))
            {
                <li class="@(selection.WasBooked ? "" : "mp-betslip-selection-skipped")">
                    <div class="mp-betslip-selection-main">
                        <span class="mp-betslip-selection-fixture">@selection.HomeTeam vs @selection.AwayTeam</span>
                        <span class="mp-prediction-badge mp-badge-@(selection.Market.ToLowerInvariant() switch {
                            "btts" => "btts",
                            "over2.5" => "over",
                            "under2.5" => "under",
                            "1x2" => "draw",
                            _ => "win"
                        })">@selection.PredictedOutcome</span>
                    </div>
                    <div class="mp-betslip-selection-meta">
                        <span>@selection.League</span>
                        @if (selection.ConfidenceScore.HasValue)
                        {
                            <span>@((selection.ConfidenceScore.Value * 100m).ToString("0.0"))%</span>
                        }
                        @if (selection.DecimalOdds is > 1)
                        {
                            <span>@selection.DecimalOdds.Value.ToString("0.00")</span>
                        }
                        @if (!selection.WasBooked)
                        {
                            <span>not booked</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(selection.AiNote))
                    {
                        <p class="mp-betslip-selection-note">@selection.AiNote</p>
                    }
                </li>
            }
        </ul>
    </details>
</article>
