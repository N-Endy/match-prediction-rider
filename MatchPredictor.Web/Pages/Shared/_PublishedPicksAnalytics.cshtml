@model MatchPredictor.Domain.Models.PublishedPicksAnalyticsViewModel

@{
    var backtest = Model.BacktestStats;
    var current = Model.CurrentRevisionStats;
    var primary = current.TotalPredictions > 0 ? current : backtest;
    var isUsingCurrent = current.TotalPredictions > 0;

    var primaryAccClass = primary.OverallAccuracy >= 0.70 ? "acc-high" :
                          primary.OverallAccuracy >= 0.50 ? "acc-med" : "acc-low";

    static string FormatCategoryName(string category) => category switch
    {
        "MatchWinner" => "Match Winner",
        "OverUnderSets" => "Over / Under Sets",
        "SetHandicap" => "Set Handicap",
        _ => category
    };
}

<div class="mp-stat-grid">
    <div class="mp-stat-card">
        <div class="mp-stat-label">Published Picks</div>
        <div class="mp-stat-value mp-stat-figure">@primary.TotalPredictions</div>
    </div>
    <div class="mp-stat-card">
        <div class="mp-stat-label">Settled Picks</div>
        <div class="mp-stat-value mp-stat-figure">@primary.CompletedPredictions</div>
    </div>
    <div class="mp-stat-card">
        <div class="mp-stat-label">Correct Picks</div>
        <div class="mp-stat-value mp-stat-figure">@primary.CorrectPredictions</div>
    </div>
    <div class="mp-stat-card">
        <div class="mp-stat-label">Win Rate</div>
        <div class="mp-stat-value mp-stat-figure @primaryAccClass">
            @(primary.CompletedPredictions > 0 ? (primary.OverallAccuracy * 100).ToString("F1") + "%" : "0.0%")
        </div>
    </div>
</div>

<div class="mp-analytics-note">
    @if (isUsingCurrent)
    {
        <strong>Visible revision stats:</strong> <text>this is the single live snapshot shown on the analytics page, using the latest published revisions currently displayed across the prediction pages.</text>
    }
    else
    {
        <strong>Published backtest:</strong> <text>this measures the last pre-kickoff published revision for each fixture and market, and it is used here because no newer visible-revision snapshot is available yet.</text>
    }
</div>

@if (primary.CategoryStats.Any())
{
    <div class="mp-category-stats">
        <h3 style="margin-bottom: 1.5rem; font-size: 1.1rem; color: white;">Performance by Concept</h3>

        @foreach (var cat in primary.CategoryStats.Values.OrderByDescending(c => c.Total))
        {
            var catAccClass = cat.Accuracy >= 0.70 ? "acc-high" :
                              cat.Accuracy >= 0.50 ? "acc-med" : "acc-low";
            var fillWidth = cat.Total > 0 ? (cat.Accuracy * 100).ToString("F1") + "%" : "0%";

            <div class="mp-category-row">
                <div class="mp-cat-header">
                    <span class="mp-cat-name">@FormatCategoryName(cat.Category)</span>
                    <span class="mp-cat-details @catAccClass">
                        <span class="mp-cat-metric"><strong>@fillWidth</strong></span>
                        <span class="mp-cat-metric">(@cat.Correct / @cat.Total)</span>
                        <span class="mp-cat-metric">Brier @cat.BrierScore.ToString("F3")</span>
                    </span>
                </div>
                <div class="mp-progress-track">
                    <div class="mp-progress-fill @catAccClass" style="width: @fillWidth"></div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="mp-market-empty">
        No published pick performance is available in this range yet.
    </div>
}
