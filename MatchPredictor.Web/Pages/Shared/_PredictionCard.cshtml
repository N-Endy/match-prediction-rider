@model MatchPredictor.Domain.Models.Prediction
@using System.Text.Json
@using MatchPredictor.Domain.Models

@{
    var nowUtc = DateTime.UtcNow;
    var badgeClass = MatchPredictor.Web.Helpers.PredictionDisplayHelper.GetPredictionBadgeClass(Model);
    var badgeText = MatchPredictor.Web.Helpers.PredictionDisplayHelper.GetPredictionBadgeText(Model);
    var cartMarket = MatchPredictor.Web.Helpers.PredictionDisplayHelper.GetCartMarket(Model);
    var isActuallyLive = MatchPredictor.Web.Helpers.PredictionDisplayHelper.IsActuallyLive(Model, nowUtc);
    var statusLabel = MatchPredictor.Web.Helpers.PredictionDisplayHelper.GetStatusLabel(Model, nowUtc);
    var isAdminOperator = ViewData["IsAdminOperator"] as bool? == true;
    ScoreNearMissHintSet? scoreHintSet = null;
    if (isAdminOperator &&
        string.IsNullOrEmpty(Model.ActualScore) &&
        ViewData["ScoreNearMissHints"] is System.Collections.Generic.IReadOnlyDictionary<int, ScoreNearMissHintSet> hints)
    {
        hints.TryGetValue(Model.Id, out scoreHintSet);
    }

    var scoreHintCandidates = scoreHintSet?.Candidates ?? [];
    var scoreHintJson = scoreHintCandidates.Count == 0
        ? "[]"
        : JsonSerializer.Serialize(
            scoreHintCandidates,
            new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<div class="mp-prediction-card mp-prediction-card-rich" data-prediction-id="@Model.Id">
    <div class="mp-match-info">
        <div class="mp-match-league">
            @Model.League
            <span class="mp-time">@MatchPredictor.Web.Helpers.PredictionDisplayHelper.FormatWatTime(Model)</span>
            <span class="mp-state-pill mp-state-@statusLabel.ToLowerInvariant()">@statusLabel</span>
        </div>
        <div class="mp-match-teams">
            @Model.HomeTeam
            <span class="mp-vs">vs</span>
            @Model.AwayTeam
        </div>
        <div class="mp-prediction-insights">
            <span class="mp-insight-chip">@MatchPredictor.Web.Helpers.PredictionDisplayHelper.GetConfidenceChip(Model)</span>
            <span class="mp-insight-chip">@MatchPredictor.Web.Helpers.PredictionDisplayHelper.GetThresholdChip(Model)</span>
            <span class="mp-insight-chip">@MatchPredictor.Web.Helpers.PredictionDisplayHelper.GetSourceChip(Model)</span>
        </div>
        <p class="mp-prediction-reason">@MatchPredictor.Web.Helpers.PredictionDisplayHelper.BuildPredictionReason(Model)</p>
    </div>

    <div class="mp-card-badges">
        @if (!string.IsNullOrEmpty(Model.ActualScore))
        {
            var scoreClass = MatchPredictor.Web.Helpers.PredictionDisplayHelper.GetScoreClass(Model, nowUtc);

            if (isActuallyLive)
            {
                <span class="mp-score @scoreClass mp-score-value" data-prediction-id="@Model.Id"><span class="mp-live-indicator"></span>@Model.ActualScore</span>
            }
            else
            {
                <span class="mp-score @scoreClass mp-score-value" data-prediction-id="@Model.Id">
                    @Model.ActualScore
                </span>
            }
        }
        else if (scoreHintCandidates.Count > 0)
        {
            <button type="button"
                    class="mp-score-near-miss"
                    title="Possible scraped score — click to choose a match"
                    data-prediction-id="@Model.Id"
                    data-home="@Model.HomeTeam"
                    data-away="@Model.AwayTeam"
                    data-candidates="@scoreHintJson">
                !
            </button>
        }

        <span class="mp-prediction-badge @badgeClass">@badgeText</span>
        <button class="mp-add-cart-btn" title="Add Bet"
                data-home="@Model.HomeTeam"
                data-away="@Model.AwayTeam"
                data-league="@Model.League"
                data-market="@cartMarket"
                data-prediction="@badgeText"
                data-prediction-id="@Model.Id"
                data-match-datetime-utc="@(Model.MatchDateTime?.ToString("O") ?? string.Empty)">
            Add Bet
        </button>
        @if (isActuallyLive)
        {
            <button class="btn-watch-stream d-none" title="Watch Live Stream"
                    data-home="@Model.HomeTeam"
                    data-away="@Model.AwayTeam">
                <i class="fas fa-play-circle stream-pulse-icon"></i> Watch Live
            </button>
        }
    </div>
</div>
