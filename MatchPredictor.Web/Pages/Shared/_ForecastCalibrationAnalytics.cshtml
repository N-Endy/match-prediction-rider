@model MatchPredictor.Domain.Models.AnalyticsStats

@{
    var overallRead = GetCalibrationRead(Model.SettledForecasts, Model.BrierScore, Model.LogLoss);
}

<div class="mp-stat-grid">
    <div class="mp-stat-card">
        <div class="mp-stat-label">Settled Forecasts</div>
        <div class="mp-stat-value mp-stat-figure">@Model.SettledForecasts</div>
    </div>
    <div class="mp-stat-card">
        <div class="mp-stat-label">Raw Brier</div>
        <div class="mp-stat-value mp-stat-figure mp-stat-value-compact">
            @(Model.SettledForecasts > 0 ? Model.RawBrierScore.ToString("F3") : "0.000")
        </div>
    </div>
    <div class="mp-stat-card">
        <div class="mp-stat-label">Calibrated Brier</div>
        <div class="mp-stat-value mp-stat-figure mp-stat-value-compact">
            @(Model.SettledForecasts > 0 ? Model.BrierScore.ToString("F3") : "0.000")
        </div>
    </div>
    <div class="mp-stat-card">
        <div class="mp-stat-label">Log Loss</div>
        <div class="mp-stat-value mp-stat-figure mp-stat-value-compact">
            @(Model.SettledForecasts > 0 ? Model.LogLoss.ToString("F3") : "0.000")
        </div>
    </div>
    <div class="mp-stat-card">
        <div class="mp-stat-label">Precision</div>
        <div class="mp-stat-value mp-stat-figure mp-stat-value-compact">
            @(Model.SettledForecasts > 0 ? $"{Model.Precision * 100:F1}%" : "0.0%")
        </div>
    </div>
    <div class="mp-stat-card">
        <div class="mp-stat-label">Recall</div>
        <div class="mp-stat-value mp-stat-figure mp-stat-value-compact">
            @(Model.SettledForecasts > 0 ? $"{Model.Recall * 100:F1}%" : "0.0%")
        </div>
    </div>
    <div class="mp-stat-card">
        <div class="mp-stat-label">F1 Score</div>
        <div class="mp-stat-value mp-stat-figure mp-stat-value-compact">
            @(Model.SettledForecasts > 0 ? Model.F1Score.ToString("F3") : "0.000")
        </div>
    </div>
</div>

<div class="mp-analytics-note mp-note-with-read">
    <div>
        <strong>Probability quality view.</strong> Lower Brier and Log Loss are better, and curves closer to the diagonal are better calibrated.
    </div>
    <div class="mp-note-read">
        <span class="mp-read-badge @overallRead.CssClass">@overallRead.Label</span>
        <span class="mp-note-caption">@overallRead.Detail</span>
    </div>
</div>

<div class="mp-market-analytics">
    @if (Model.ForecastMarketStats.Any())
    {
        <div class="mp-market-grid">
            @foreach (var market in Model.ForecastMarketStats)
            {
                var marketRead = GetCalibrationRead(market.SettledCount, market.CalibratedBrierScore, market.LogLoss);
                <article class="mp-market-card">
                    <div class="mp-market-header">
                        <div>
                            <h4>@market.MarketName</h4>
                            <p>@market.SettledCount settled forecasts</p>
                        </div>
                        <div class="mp-market-briers">
                            <span>Raw @market.RawBrierScore.ToString("F3")</span>
                            <span>Cal @market.CalibratedBrierScore.ToString("F3")</span>
                        </div>
                    </div>

                    <div class="mp-read-strip">
                        <span class="mp-read-badge @marketRead.CssClass">@marketRead.Label</span>
                        <span class="mp-read-detail">@marketRead.Detail</span>
                    </div>

                    <div class="mp-market-metrics">
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Hit Rate</span>
                            <strong>@((market.HitRate * 100).ToString("F1"))%</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Log Loss</span>
                            <strong>@market.LogLoss.ToString("F3")</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Precision</span>
                            <strong>@((market.Precision * 100).ToString("F1"))%</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Recall</span>
                            <strong>@((market.Recall * 100).ToString("F1"))%</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">F1</span>
                            <strong>@market.F1Score.ToString("F3")</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Raw REL</span>
                            <strong>@market.RawDecomposition.Reliability.ToString("F3")</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Raw RES</span>
                            <strong>@market.RawDecomposition.Resolution.ToString("F3")</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Raw UNC</span>
                            <strong>@market.RawDecomposition.Uncertainty.ToString("F3")</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Cal REL</span>
                            <strong>@market.CalibratedDecomposition.Reliability.ToString("F3")</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Cal RES</span>
                            <strong>@market.CalibratedDecomposition.Resolution.ToString("F3")</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Cal UNC</span>
                            <strong>@market.CalibratedDecomposition.Uncertainty.ToString("F3")</strong>
                        </div>
                    </div>

                    <div class="mp-era-grid">
                        <section class="mp-era-card">
                            <div class="mp-market-beta-header">
                                <span>Calibrator Eras</span>
                            </div>
                            @if (market.CalibratorEraStats.Any())
                            {
                                <div class="mp-era-row mp-era-row-head">
                                    <span class="mp-era-name">Era</span>
                                    <span class="mp-era-metric">Count</span>
                                    <span class="mp-era-metric">Hit</span>
                                    <span class="mp-era-metric">Brier</span>
                                </div>
                                foreach (var era in market.CalibratorEraStats)
                                {
                                    <div class="mp-era-row">
                                        <span class="mp-era-name">@era.Era</span>
                                        <span class="mp-era-metric">@era.Count</span>
                                        <span class="mp-era-metric">@((era.HitRate * 100).ToString("F1"))%</span>
                                        <span class="mp-era-metric">@era.BrierScore.ToString("F3")</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="mp-market-beta-empty">No settled calibrator-era data yet.</p>
                            }
                        </section>

                        <section class="mp-era-card">
                            <div class="mp-market-beta-header">
                                <span>Threshold Eras</span>
                            </div>
                            @if (market.ThresholdEraStats.Any())
                            {
                                <div class="mp-era-row mp-era-row-head">
                                    <span class="mp-era-name">Era</span>
                                    <span class="mp-era-metric">Count</span>
                                    <span class="mp-era-metric">Hit</span>
                                    <span class="mp-era-metric">Brier</span>
                                </div>
                                foreach (var era in market.ThresholdEraStats)
                                {
                                    <div class="mp-era-row">
                                        <span class="mp-era-name">@era.Era</span>
                                        <span class="mp-era-metric">@era.Count</span>
                                        <span class="mp-era-metric">@((era.HitRate * 100).ToString("F1"))%</span>
                                        <span class="mp-era-metric">@era.BrierScore.ToString("F3")</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="mp-market-beta-empty">No published threshold-era data yet.</p>
                            }
                        </section>
                    </div>

                    @if (market.RawReliabilityCurve.Any() || market.CalibratedReliabilityCurve.Any())
                    {
                        <div class="mp-reliability-shell">
                            <div class="mp-reliability-chart">
                                <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-label="Reliability curve for @market.MarketName">
                                    <line x1="0" y1="100" x2="100" y2="0" class="mp-reliability-diagonal"></line>

                                    @if (market.RawReliabilityCurve.Count == 1)
                                    {
                                        var point = market.RawReliabilityCurve[0];
                                        <circle cx="@MatchPredictor.Web.Pages.AnalyticsModel.CurveX(point).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                cy="@MatchPredictor.Web.Pages.AnalyticsModel.CurveY(point).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                r="2.2"
                                                class="mp-curve-point raw"></circle>
                                    }
                                    else if (market.RawReliabilityCurve.Count > 1)
                                    {
                                        <polyline points="@MatchPredictor.Web.Pages.AnalyticsModel.BuildCurvePoints(market.RawReliabilityCurve)" class="mp-reliability-line raw"></polyline>
                                    }

                                    @if (market.CalibratedReliabilityCurve.Count == 1)
                                    {
                                        var point = market.CalibratedReliabilityCurve[0];
                                        <circle cx="@MatchPredictor.Web.Pages.AnalyticsModel.CurveX(point).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                cy="@MatchPredictor.Web.Pages.AnalyticsModel.CurveY(point).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                r="2.2"
                                                class="mp-curve-point calibrated"></circle>
                                    }
                                    else if (market.CalibratedReliabilityCurve.Count > 1)
                                    {
                                        <polyline points="@MatchPredictor.Web.Pages.AnalyticsModel.BuildCurvePoints(market.CalibratedReliabilityCurve)" class="mp-reliability-line calibrated"></polyline>
                                    }
                                </svg>
                            </div>
                            <div class="mp-reliability-legend">
                                <span><i class="mp-legend-swatch raw"></i> Raw</span>
                                <span><i class="mp-legend-swatch calibrated"></i> Calibrated</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mp-market-empty">
                            Reliability points for this market will appear after enough settled forecasts are available in this range.
                        </div>
                    }
                </article>
            }
        </div>
    }
    else
    {
        <div class="mp-market-empty">
            No settled forecast data is available for this date range yet, so the calibration view cannot be drawn.
        </div>
    }
</div>

<div class="mp-analytics-note" style="margin-top: 2rem;">
    Confidence bands help check whether 60-70% calls are really landing like 60-70% calls. Segment views help isolate drift by league and by the stored calibrator/source tag.
</div>

@if (Model.ConfidenceBandStats.Any())
{
    <div class="mp-category-stats" style="margin-top: 2rem;">
        <h3 style="margin-bottom: 1.5rem; font-size: 1.1rem; color: white;">Confidence Bands</h3>
        <div class="mp-market-grid">
            @foreach (var band in Model.ConfidenceBandStats)
            {
                <article class="mp-market-card">
                    <div class="mp-market-header">
                        <div>
                            <h4>@($"{band.MinProbability * 100:F0}-{band.MaxProbability * 100:F0}%")</h4>
                            <p>@band.SampleCount settled forecasts</p>
                        </div>
                        <div class="mp-market-briers">
                            <span>Avg @((band.AverageProbability * 100).ToString("F1"))%</span>
                            <span>Hit @((band.HitRate * 100).ToString("F1"))%</span>
                        </div>
                    </div>
                    <div class="mp-market-metrics">
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Samples</span>
                            <strong>@band.SampleCount</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Avg Prob</span>
                            <strong>@((band.AverageProbability * 100).ToString("F1"))%</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Hit Rate</span>
                            <strong>@((band.HitRate * 100).ToString("F1"))%</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Brier</span>
                            <strong>@band.BrierScore.ToString("F3")</strong>
                        </div>
                        <div class="mp-market-metric-block">
                            <span class="mp-market-metric-label">Log Loss</span>
                            <strong>@band.LogLoss.ToString("F3")</strong>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
}

<div class="mp-market-grid" style="margin-top: 2rem;">
    <article class="mp-market-card">
        <div class="mp-market-header">
            <div>
                <h4>League Segments</h4>
                <p>Where calibration is strongest or weakest by competition.</p>
            </div>
        </div>
        @if (Model.LeagueSegmentStats.Any())
        {
            <div class="mp-segment-table">
                <div class="mp-segment-row mp-segment-row-head">
                    <span class="mp-segment-name">League</span>
                    <span class="mp-segment-metric">Read</span>
                    <span class="mp-segment-metric">Count</span>
                    <span class="mp-segment-metric">Hit</span>
                    <span class="mp-segment-metric">Brier</span>
                    <span class="mp-segment-metric">Log</span>
                </div>
                @foreach (var stat in Model.LeagueSegmentStats)
                {
                    var read = GetCalibrationRead(stat.SampleCount, stat.BrierScore, stat.LogLoss);
                    <div class="mp-segment-row">
                        <div class="mp-segment-name">
                            <span class="mp-segment-title">@stat.League</span>
                            <span class="mp-segment-subtitle">@read.Detail</span>
                        </div>
                        <span class="mp-read-badge @read.CssClass">@read.Label</span>
                        <span class="mp-segment-metric">@stat.SampleCount</span>
                        <span class="mp-segment-metric">@((stat.HitRate * 100).ToString("F1"))%</span>
                        <span class="mp-segment-metric">@stat.BrierScore.ToString("F3")</span>
                        <span class="mp-segment-metric">@stat.LogLoss.ToString("F3")</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mp-market-empty">
                League segment stats will appear once enough settled forecasts are available.
            </div>
        }
    </article>

    <article class="mp-market-card">
        <div class="mp-market-header">
            <div>
                <h4>Calibrator Segments</h4>
                <p>Grouped by the stored model/calibrator tag on each forecast.</p>
            </div>
        </div>
        @if (Model.SourceSegmentStats.Any())
        {
            <div class="mp-segment-table">
                <div class="mp-segment-row mp-segment-row-head">
                    <span class="mp-segment-name">Tag</span>
                    <span class="mp-segment-metric">Read</span>
                    <span class="mp-segment-metric">Count</span>
                    <span class="mp-segment-metric">Hit</span>
                    <span class="mp-segment-metric">Brier</span>
                    <span class="mp-segment-metric">Log</span>
                </div>
                @foreach (var stat in Model.SourceSegmentStats)
                {
                    var read = GetCalibrationRead(stat.SampleCount, stat.BrierScore, stat.LogLoss);
                    <div class="mp-segment-row">
                        <div class="mp-segment-name">
                            <span class="mp-segment-title">@stat.SourceName</span>
                            <span class="mp-segment-subtitle">@read.Detail</span>
                        </div>
                        <span class="mp-read-badge @read.CssClass">@read.Label</span>
                        <span class="mp-segment-metric">@stat.SampleCount</span>
                        <span class="mp-segment-metric">@((stat.HitRate * 100).ToString("F1"))%</span>
                        <span class="mp-segment-metric">@stat.BrierScore.ToString("F3")</span>
                        <span class="mp-segment-metric">@stat.LogLoss.ToString("F3")</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mp-market-empty">
                Calibrator segment stats will appear once enough settled forecasts are available.
            </div>
        }
    </article>
</div>

@functions {
    private sealed class CalibrationRead
    {
        public CalibrationRead(string label, string cssClass, string detail)
        {
            Label = label;
            CssClass = cssClass;
            Detail = detail;
        }

        public string Label { get; }
        public string CssClass { get; }
        public string Detail { get; }
    }

    private static CalibrationRead GetCalibrationRead(int sampleCount, double brierScore, double logLoss)
    {
        if (sampleCount < 10)
        {
            return new CalibrationRead("Avoid", "mp-read-badge-avoid", "Too little settled history to trust this segment on its own yet.");
        }

        if (sampleCount < 30)
        {
            return new CalibrationRead("Caution", "mp-read-badge-caution", "Signal is starting to form, but the sample is still light.");
        }

        if (brierScore >= 0.24 || logLoss >= 0.70)
        {
            return new CalibrationRead("Avoid", "mp-read-badge-avoid", "Forecast quality is currently too loose for normal staking.");
        }

        if (sampleCount >= 60 && brierScore <= 0.20 && logLoss <= 0.60)
        {
            return new CalibrationRead("Strong", "mp-read-badge-strong", "Large sample with efficient, stable calibration.");
        }

        if (sampleCount >= 35 && brierScore <= 0.22 && logLoss <= 0.64)
        {
            return new CalibrationRead("Strong", "mp-read-badge-strong", "Healthy sample and clean enough probability quality to lean on.");
        }

        return new CalibrationRead("Caution", "mp-read-badge-caution", "Playable, but keep stake size measured until the edge looks cleaner.");
    }
}
