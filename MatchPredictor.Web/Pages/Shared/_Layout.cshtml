@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    var currentPath = Context.Request.Path.Value ?? "/";
    var reviewSafePublicUi = Configuration.GetValue("AdSense:ReviewSafePublicUi", true);
    string NavClass(string href)
    {
        var isHome = href == "/";
        var active = isHome
            ? string.Equals(currentPath, "/", StringComparison.OrdinalIgnoreCase)
            : currentPath.StartsWith(href, StringComparison.OrdinalIgnoreCase);
        return active ? "mp-nav-link active" : "mp-nav-link";
    }

    var request = Context.Request;
    var origin = $"{request.Scheme}://{request.Host.Value}";
    var canonicalPath = string.IsNullOrEmpty(currentPath) ? "/" : currentPath;
    var canonicalUrl = $"{origin}{canonicalPath}{request.QueryString.Value}";
    var pageTitle = ViewData["Title"] as string;
    var ogTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "MatchPredictor – Daily AI Football Predictions"
        : $"{pageTitle} – MatchPredictor";
    var defaultDescription = "Predict before kickoff. Results after the final whistle. Daily AI football predictions and betslips.";
    var ogDescription = ViewData["Description"] as string ?? defaultDescription;
    var ogImageUrl = $"{origin}/og-preview.png";
    var logoUrl = $"{origin}/img/logo.png";
    var jsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Organization",
        ["name"] = "MatchPredictor",
        ["url"] = origin,
        ["logo"] = logoUrl,
        ["description"] = defaultDescription
    });
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MatchPredictor</title>

    <meta name="description" content="@ogDescription">
    <meta name="keywords" content="football predictions, btts, over 2.5, betting tips, match predictor, AI football tips">
    <meta name="author" content="MatchPredictor">
    @if (!string.IsNullOrWhiteSpace(Configuration["AdSense:ClientId"]))
    {
        <meta name="google-adsense-account" content="@Configuration["AdSense:ClientId"]">
    }
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="MatchPredictor">
    <meta property="og:url" content="@canonicalUrl">
    <meta property="og:title" content="@ogTitle">
    <meta property="og:description" content="@ogDescription">
    <meta property="og:image" content="@ogImageUrl">
    <meta property="og:image:secure_url" content="@ogImageUrl">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="MatchPredictor – Predict before kickoff. Results after the final whistle.">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="@canonicalUrl">
    <meta name="twitter:title" content="@ogTitle">
    <meta name="twitter:description" content="@ogDescription">
    <meta name="twitter:image" content="@ogImageUrl">
    <meta name="twitter:image:alt" content="MatchPredictor – Predict before kickoff. Results after the final whistle.">
    @if (!string.IsNullOrWhiteSpace(Configuration["Social:TwitterHandle"]))
    {
        <meta name="twitter:site" content="@Configuration["Social:TwitterHandle"]">
        <meta name="twitter:creator" content="@Configuration["Social:TwitterHandle"]">
    }

    <script type="application/ld+json">
    @Html.Raw(jsonLd)
    </script>

    <!-- Google Consent Mode defaults (must run before gtag.js loads) -->
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            wait_for_update: 500
        });
    </script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ET4NE2RTGC"></script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true" />
    <meta name="theme-color" content="#0a0e17" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="MatchPredictor" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Google AdSense (non-personalized only — set before script load) -->
    <script>
        window.adsbygoogle = window.adsbygoogle || [];
        window.adsbygoogle.requestNonPersonalizedAds = 1;
    </script>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=@(Configuration["AdSense:ClientId"] ?? "ca-pub-123456789")"
         crossorigin="anonymous"></script>
</head>
<body data-max-booking-selections="@(Configuration.GetValue("SportyBet:MaxBookingSelections", 50))"
      data-review-safe-public-ui="@(reviewSafePublicUi ? "true" : "false")">

<!-- Navbar -->
<nav class="mp-navbar">
    <div class="mp-navbar-inner">
        <a class="mp-logo" asp-page="/Index" aria-label="MatchPredictor">
            <picture>
                <source media="(min-width: 769px)" srcset="~/img/logo-mark-nav.png" asp-append-version="true" />
                <img class="mp-logo-icon" src="~/img/logo-mark-nav.png" width="56" height="56" alt="" aria-hidden="true" asp-append-version="true" />
            </picture>
            <span class="mp-logo-text" aria-hidden="true">
                <span class="mp-logo-match">MATCH</span><span class="mp-logo-predictor">PREDICTOR</span>
            </span>
        </a>

        <button class="mp-menu-toggle" id="menuToggle" aria-label="Toggle navigation">
            ☰
        </button>

        <ul class="mp-nav-links" id="navLinks">
            <li><a class="@NavClass("/")" asp-page="/Index">Home</a></li>
            <li><a class="@NavClass("/betslips")" href="/betslips">Betslips</a></li>
            <li><a class="@NavClass("/predictions/btts")" href="/predictions/btts">BTTS</a></li>
            <li><a class="@NavClass("/predictions/straightwin")" href="/predictions/straightwin">Straight Win</a></li>
            <li><a class="@NavClass("/predictions/draw")" href="/predictions/draw">Draw</a></li>
            <li><a class="@NavClass("/predictions/over2")" href="/predictions/over2">Over 2.5</a></li>
            <li><a class="@NavClass("/predictions/under2")" href="/predictions/under2">Under 2.5</a></li>
            <li><a class="@NavClass("/aichat")" href="/aichat">AI Chat</a></li>
            @if (Context.IsAdminOperator())
            {
                <li><a class="@NavClass("/analytics")" href="/analytics">Analytics</a></li>
            }
        </ul>
    </div>
</nav>

<!-- Main Content -->
<main>
    @RenderBody()
</main>

@if (ViewData["HideAds"] as bool? != true)
{
    <div class="mp-container mp-layout-ad">
        <partial name="_AdBanner" />
    </div>
}

<!-- Footer -->
<footer class="mp-footer">
    <div>
        <a href="/betslips">Betslips</a> ·
        <a href="/predictions/btts">BTTS</a> ·
        <a href="/predictions/straightwin">Straight Win</a> ·
        <a href="/predictions/draw">Draw</a> ·
        <a href="/predictions/over2">Over 2.5</a> ·
        <a href="/predictions/under2">Under 2.5</a> ·
        <a href="/Privacy">Privacy</a> ·
        <a href="/Privacy#responsible-use">Responsible use</a>
    </div>
    <p class="mp-footer-copy">&copy; @DateTime.Now.Year MatchPredictor · AI-Powered Football Predictions</p>
</footer>

<!-- Scroll to Top -->
<button class="mp-scroll-top" id="scrollTopBtn" aria-label="Scroll to top">↑</button>

<script src="~/js/site.js" asp-append-version="true"></script>

<!-- Floating Cart Button -->
<button class="mp-cart-fab" id="cartFab" data-cart-action="open" aria-label="Open cart">
    🛒
    <span class="mp-cart-badge" id="cartBadge" style="display:none;">0</span>
</button>

<!-- Cart Modal -->
<div class="mp-cart-modal" id="cartModal">
    <div class="mp-cart-overlay" data-cart-action="close"></div>
    <div class="mp-cart-drawer">
        <div class="mp-cart-header">
            <h2>🛒 Your selections</h2>
            <button class="mp-cart-close" data-cart-action="close">✕</button>
        </div>
        <div class="mp-cart-items" id="cartItemsList"></div>
        <div class="mp-cart-empty" id="cartEmpty" style="display:none;">
            <p>No games selected yet.</p>
            <p style="font-size:0.85rem;">Click "+" on any prediction to add it here.</p>
        </div>
        <div id="bookingResult" style="display:none;"></div>
        <div class="mp-cart-footer" id="cartFooter" style="display:none;">
            <button class="mp-clear-cart-btn" data-cart-action="clear">Clear All</button>
            <button class="mp-book-btn" id="bookGamesBtn" data-cart-action="book">@(reviewSafePublicUi ? "Show Games" : "🎫 Book Games")</button>
        </div>
    </div>
</div>

<script src="~/js/cart.js" asp-append-version="true"></script>
<script src="~/js/score-confirm.js" asp-append-version="true"></script>

<partial name="_StreamModal" />
<script src="~/js/livestream.js" asp-append-version="true"></script>

<!-- PWA Install Banner -->
<div id="pwaInstallBanner" class="mp-pwa-install-banner" style="display: none;" hidden>
    <div class="mp-pwa-install-content">
        <p>Install MatchPredictor for quick access from your home screen.</p>
        <div class="mp-pwa-install-actions">
            <button id="pwaInstallBtn" type="button" class="mp-cookie-btn mp-cookie-accept">Install</button>
            <button id="pwaInstallDismissBtn" type="button" class="mp-cookie-btn mp-cookie-decline">Not now</button>
        </div>
    </div>
</div>

<!-- Cookie Consent Banner -->
<div id="cookieConsentBanner" class="mp-cookie-banner" style="display: none;">
    <div class="mp-cookie-content">
        <p>
            We use cookies to personalize content, serve targeted ads, and analyze our traffic.
            By clicking "Accept", you consent to our use of cookies in accordance with our <a href="/Privacy">Privacy Policy</a>.
        </p>
        <div class="mp-cookie-actions">
            <button id="acceptCookiesBtn" class="mp-cookie-btn mp-cookie-accept">Accept</button>
            <button id="declineCookiesBtn" class="mp-cookie-btn mp-cookie-decline">Decline</button>
        </div>
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
