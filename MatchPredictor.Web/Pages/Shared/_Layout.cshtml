<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TennisPredictor</title>

    <meta name="description" content="Daily tennis predictions, value bets, and settlement tracking built from a dedicated tennis analysis pipeline." />
    <meta name="keywords" content="tennis predictions, tennis value bets, match winner, set handicap, over under sets" />
    <meta name="author" content="TennisPredictor" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
</head>
<body>
<nav class="mp-navbar">
    <div class="mp-navbar-inner">
        <a class="mp-logo" asp-page="/Index">
            <span class="mp-logo-icon">🎾</span>
            TennisPredictor
        </a>

        <button class="mp-menu-toggle" id="menuToggle" aria-label="Toggle navigation">☰</button>

        <ul class="mp-nav-links" id="navLinks">
            <li><a class="mp-nav-link" asp-page="/Index">Home</a></li>
            <li><a class="mp-nav-link" href="/valuebets">Value Bets</a></li>
            <li><a class="mp-nav-link" href="/predictions/matchwinner">Match Winner</a></li>
            <li><a class="mp-nav-link" href="/predictions/over-under-sets">Over / Under Sets</a></li>
            <li><a class="mp-nav-link" href="/predictions/set-handicap">Set Handicap</a></li>
            <li><a class="mp-nav-link" href="/predictions/combined">Combined</a></li>
            <li><a class="mp-nav-link" href="/analytics">Analytics</a></li>
            <li><a class="mp-nav-link" href="/ops/health">Health</a></li>
        </ul>
    </div>
</nav>

<main>
    @RenderBody()
</main>

<footer class="mp-footer">
    <div>
        <a href="/valuebets">Value Bets</a> ·
        <a href="/predictions/matchwinner">Match Winner</a> ·
        <a href="/predictions/over-under-sets">Over / Under Sets</a> ·
        <a href="/predictions/set-handicap">Set Handicap</a> ·
        <a href="/predictions/combined">Combined</a> ·
        <a href="/ops/health">System Health</a>
    </div>
    <p style="margin-top: 0.75rem;">&copy; @DateTime.Now.Year TennisPredictor · AI-Assisted Tennis Analysis</p>
</footer>

<button class="mp-scroll-top" id="scrollTopBtn" aria-label="Scroll to top">↑</button>

<script>
    document.getElementById('menuToggle')?.addEventListener('click', function () {
        document.getElementById('navLinks')?.classList.toggle('show');
    });

    const currentPath = window.location.pathname.toLowerCase();
    document.querySelectorAll('.mp-nav-link').forEach(link => {
        const href = (link.getAttribute('href') || '').toLowerCase();
        if (href && href === currentPath) {
            link.classList.add('active');
        }
    });

    const scrollBtn = document.getElementById('scrollTopBtn');
    window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
            scrollBtn?.classList.add('visible');
        } else {
            scrollBtn?.classList.remove('visible');
        }
    });

    scrollBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    window.matchPredictorTracking = {
        track() {
        }
    };
</script>

<button class="mp-cart-fab" id="cartFab" onclick="openCartModal()" aria-label="Open cart">
    🛒
    <span class="mp-cart-badge" id="cartBadge" style="display:none;">0</span>
</button>

<div class="mp-cart-modal" id="cartModal">
    <div class="mp-cart-overlay" onclick="closeCartModal()"></div>
    <div class="mp-cart-drawer">
        <div class="mp-cart-header">
            <h2>🛒 Your Betslip</h2>
            <button class="mp-cart-close" onclick="closeCartModal()">✕</button>
        </div>
        <div class="mp-cart-items" id="cartItemsList"></div>
        <div class="mp-cart-empty" id="cartEmpty" style="display:none;">
            <p>No selections in your betslip yet.</p>
            <p style="font-size:0.85rem;">You can save all tennis picks here, but SportyBet booking is still match-winner only in v1.</p>
        </div>
        <div id="bookingResult" style="display:none;"></div>
        <div class="mp-cart-footer" id="cartFooter" style="display:none;">
            <button class="mp-clear-cart-btn" onclick="clearCart()">Clear All</button>
            <button class="mp-book-btn" id="bookGamesBtn" onclick="bookGames()">🎫 Book Games</button>
        </div>
    </div>
</div>

<script src="~/js/cart.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
