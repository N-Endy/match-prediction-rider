@model MatchPredictor.Web.Pages.BetslipRecordCardViewModel
@using MatchPredictor.Application.Services
@using MatchPredictor.Domain.Models
@{
    var slip = Model.Slip;
    var isRollover = slip.SlipNumber == BetslipGenerationService.RolloverSlipNumber
                     || slip.TierLabel.StartsWith("Rollover", StringComparison.OrdinalIgnoreCase);
    var isBanker = slip.SlipNumber == BetslipGenerationService.BankerSlipNumber
                   || slip.TierLabel.StartsWith("Banker", StringComparison.OrdinalIgnoreCase);
    var isDrawSlip = string.Equals(slip.TierLabel, "AI Draws (5)", StringComparison.Ordinal);
    var isMega = slip.TierLabel.StartsWith("Mega", StringComparison.OrdinalIgnoreCase);
    var isPayoutBand = !isBanker && !isRollover && !isDrawSlip && slip.CombinedDecimalOdds is > 1;
    var referenceStake = ViewData["ReferenceStakeNaira"] as decimal? ?? 100m;
    var estimatedReturn = isPayoutBand
        ? referenceStake * (decimal)slip.CombinedDecimalOdds!.Value
        : (decimal?)null;
    var statusClass = slip.BookingStatus switch
    {
        BetslipBookingStatuses.Booked => "mp-betslip-status-booked",
        BetslipBookingStatuses.Partial => "mp-betslip-status-partial",
        _ => "mp-betslip-status-failed"
    };
    var bookedCount = slip.Selections.Count(s => s.WasBooked);
    var cardClass = isRollover
        ? "mp-betslip-card mp-betslip-card-rollover"
        : isBanker
            ? "mp-betslip-card mp-betslip-card-banker"
            : isDrawSlip
                ? "mp-betslip-card mp-betslip-card-ai"
                : isMega
                    ? "mp-betslip-card mp-betslip-card-mega"
                    : "mp-betslip-card";

    static string FormatNaira(decimal amount)
    {
        if (amount >= 1_000_000m)
        {
            return $"₦{(amount / 1_000_000m):0.##}M";
        }

        if (amount >= 1000m)
        {
            return $"₦{(amount / 1000m):0.##}k";
        }

        return $"₦{amount:0.##}";
    }

    static string HitClass(BetslipSelectionHitStatus status) =>
        status switch
        {
            BetslipSelectionHitStatus.Won => "mp-score-correct",
            BetslipSelectionHitStatus.Lost => "mp-score-incorrect",
            BetslipSelectionHitStatus.Live => "mp-score-live",
            _ => "mp-betslip-hit-pending"
        };

    static string HitTitle(BetslipSelectionHitStatus status) =>
        status switch
        {
            BetslipSelectionHitStatus.Won => "Won",
            BetslipSelectionHitStatus.Lost => "Lost",
            BetslipSelectionHitStatus.Live => "Live",
            _ => "Pending"
        };
}

<article class="@cardClass">
    <header class="mp-betslip-card-header">
        <div>
            <span class="mp-betslip-tier">@slip.TierLabel</span>
            <h2 class="mp-betslip-title">@slip.Title</h2>
        </div>
        <span class="mp-betslip-status @statusClass">@slip.BookingStatus</span>
    </header>

    @if ((isBanker || isRollover) && slip.CombinedDecimalOdds is > 1)
    {
        <div class="@(isRollover ? "mp-betslip-rollover-odds" : "mp-betslip-banker-odds")">
            <span class="@(isRollover ? "mp-betslip-rollover-odds-value" : "mp-betslip-banker-odds-value")">@slip.CombinedDecimalOdds.Value.ToString("0.00")x</span>
            <span class="@(isRollover ? "mp-betslip-rollover-odds-label" : "mp-betslip-banker-odds-label")">@(isRollover ? "single-leg odds" : "total odds")</span>
        </div>
    }

    @if (isPayoutBand)
    {
        <div class="mp-betslip-payout-strip">
            <div>
                <span class="mp-betslip-metric-label">Combined odds</span>
                <strong>@slip.CombinedDecimalOdds!.Value.ToString("0.00")x</strong>
            </div>
            <div>
                <span class="mp-betslip-metric-label">Est. return @FormatNaira(referenceStake)</span>
                <strong>@FormatNaira(estimatedReturn!.Value)</strong>
            </div>
        </div>
    }

    <div class="mp-betslip-metrics">
        <div>
            <span class="mp-betslip-metric-label">Picks</span>
            <strong>@slip.SelectionCount</strong>
        </div>
        <div>
            <span class="mp-betslip-metric-label">Booked</span>
            <strong>@bookedCount</strong>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(slip.AiSummary))
    {
        <p class="mp-betslip-ai-summary">@slip.AiSummary</p>
    }

    @if (!string.IsNullOrWhiteSpace(slip.BookingCode))
    {
        <div class="mp-betslip-code-row">
            <code class="mp-betslip-code" id="record-betslip-code-@slip.Id">@slip.BookingCode</code>
            <button type="button"
                    class="mp-betslip-copy-btn"
                    data-copy-target="record-betslip-code-@slip.Id">
                Copy
            </button>
            @if (!string.IsNullOrWhiteSpace(slip.BookingUrl))
            {
                <a class="mp-book-btn"
                   href="@slip.BookingUrl"
                   target="_blank"
                   rel="noopener noreferrer">
                    Open in SportyBet
                </a>
            }
        </div>
    }

    <details class="mp-betslip-details" open>
        <summary>View @slip.SelectionCount selections</summary>
        <ul class="mp-betslip-selection-list">
            @foreach (var selection in slip.Selections
                .OrderBy(s => s.MatchDateTimeUtc ?? DateTime.MaxValue)
                .ThenBy(s => s.League)
                .ThenBy(s => s.HomeTeam))
            {
                var hitStatus = Model.HitStatusBySelectionId.TryGetValue(selection.Id, out var mapped)
                    ? mapped
                    : BetslipSelectionHitStatus.Pending;
                <li class="@(selection.WasBooked ? "" : "mp-betslip-selection-skipped")">
                    <div class="mp-betslip-selection-main">
                        <span class="mp-betslip-selection-fixture-row">
                            <span class="mp-betslip-hit @HitClass(hitStatus)" title="@HitTitle(hitStatus)">
                                @if (hitStatus == BetslipSelectionHitStatus.Won)
                                {
                                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                                }
                                else if (hitStatus == BetslipSelectionHitStatus.Lost)
                                {
                                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                }
                                else if (hitStatus == BetslipSelectionHitStatus.Live)
                                {
                                    <span>LIVE</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </span>
                            <span class="mp-betslip-selection-fixture">@selection.HomeTeam vs @selection.AwayTeam</span>
                        </span>
                        <span class="mp-prediction-badge mp-badge-@(selection.Market.ToLowerInvariant() switch {
                            "btts" => "btts",
                            "over2.5" => "over",
                            "under2.5" => "under",
                            "1x2" => "draw",
                            _ => "win"
                        })">@selection.PredictedOutcome</span>
                    </div>
                    <div class="mp-betslip-selection-meta">
                        <span>@selection.League</span>
                        @if (selection.ConfidenceScore.HasValue)
                        {
                            <span>@((selection.ConfidenceScore.Value * 100m).ToString("0.0"))%</span>
                        }
                        @if (selection.DecimalOdds is > 1)
                        {
                            <span>@selection.DecimalOdds.Value.ToString("0.00")</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(selection.AiNote))
                    {
                        <p class="mp-betslip-selection-note">@selection.AiNote</p>
                    }
                </li>
            }
        </ul>
    </details>
</article>
