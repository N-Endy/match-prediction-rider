<script>
// ─── Bankroll Live Calculator & Persistence ───
(function() {
    var LS_BANKROLL = 'mp_op_bankroll';
    var LS_CURRENCY = 'mp_op_currency';
    var LS_RISK = 'mp_op_risk_pct';

    var bankrollInput = document.getElementById('bankrollInput');
    var currencySelect = document.getElementById('currencySelect');
    var dailyRiskSelect = document.getElementById('dailyRiskSelect');
    var currencyPrefix = document.getElementById('currencyPrefix');

    var summaryTotalBudget = document.getElementById('summaryTotalBudget');
    var summaryActiveCapital = document.getElementById('summaryActiveCapital');
    var summaryUnitValue = document.getElementById('summaryUnitValue');

    if (!bankrollInput || !currencySelect || !dailyRiskSelect) return;

    // Load saved preferences
    var savedBankroll = localStorage.getItem(LS_BANKROLL);
    if (savedBankroll) bankrollInput.value = savedBankroll;

    var savedCurrency = localStorage.getItem(LS_CURRENCY);
    if (savedCurrency) currencySelect.value = savedCurrency;

    var savedRisk = localStorage.getItem(LS_RISK);
    if (savedRisk) dailyRiskSelect.value = savedRisk;

    function formatMoney(amount, currency) {
        return currency + Math.round(amount).toLocaleString('en-US');
    }

    function recalculate() {
        var currency = currencySelect.value;
        var bankroll = parseFloat(bankrollInput.value) || 0;
        var riskPct = parseFloat(dailyRiskSelect.value) || 5.0;

        if (currencyPrefix) currencyPrefix.innerText = currency;

        // Save preferences
        localStorage.setItem(LS_BANKROLL, bankroll);
        localStorage.setItem(LS_CURRENCY, currency);
        localStorage.setItem(LS_RISK, riskPct);

        var totalDailyRiskBudget = bankroll * (riskPct / 100);
        var unitValue = bankroll * 0.01; // 1 unit = 1% of total bankroll

        if (summaryTotalBudget) summaryTotalBudget.innerText = formatMoney(totalDailyRiskBudget, currency);
        if (summaryUnitValue) summaryUnitValue.innerText = formatMoney(unitValue, currency);

        var activeCommitted = 0;

        // Iterate ticket cards
        var cards = document.querySelectorAll('.mp-op-card');
        cards.forEach(function(card) {
            var isPreserved = card.getAttribute('data-preserved') === 'true';
            var allocation = parseFloat(card.getAttribute('data-allocation')) || 0;
            var odds = parseFloat(card.getAttribute('data-odds')) || 1.0;

            var stakeDisplay = card.querySelector('.mp-op-stake-display');
            var returnDisplay = card.querySelector('.mp-op-return-display');
            var profitDisplay = card.querySelector('.mp-op-profit-display');
            var unitsDisplay = card.querySelector('.mp-op-units-display');

            if (isPreserved || allocation <= 0) {
                if (stakeDisplay) stakeDisplay.innerText = formatMoney(0, currency);
                if (returnDisplay) returnDisplay.innerText = formatMoney(0, currency);
                if (profitDisplay) profitDisplay.innerText = formatMoney(0, currency);
                return;
            }

            var ticketStake = totalDailyRiskBudget * (allocation / 100);
            var potentialReturn = ticketStake * odds;
            var netProfit = potentialReturn - ticketStake;
            var units = (ticketStake / unitValue);

            activeCommitted += ticketStake;

            if (stakeDisplay) stakeDisplay.innerText = formatMoney(ticketStake, currency);
            if (returnDisplay) returnDisplay.innerText = formatMoney(potentialReturn, currency);
            if (profitDisplay) profitDisplay.innerText = '+' + formatMoney(netProfit, currency);
            if (unitsDisplay) unitsDisplay.innerText = units.toFixed(1) + ' Units (' + allocation + '% of daily risk)';
        });

        if (summaryActiveCapital) summaryActiveCapital.innerText = formatMoney(activeCommitted, currency);
    }

    bankrollInput.addEventListener('input', recalculate);
    currencySelect.addEventListener('change', function() {
        // Adjust default bankroll sensible for foreign currency if still on 100,000 NGN default
        if (currencySelect.value !== '₦' && bankrollInput.value === '100000') {
            bankrollInput.value = '500';
        } else if (currencySelect.value === '₦' && bankrollInput.value === '500') {
            bankrollInput.value = '100000';
        }
        recalculate();
    });
    dailyRiskSelect.addEventListener('change', recalculate);

    // Initial run
    recalculate();
})();

// ─── Copy Code Utility ───
function copyOperationsCode(code, btn) {
    if (!navigator.clipboard) {
        var textArea = document.createElement("textarea");
        textArea.value = code;
        document.body.appendChild(textArea);
        textArea.select();
        try {
            document.execCommand('copy');
            showCopiedOp(btn);
        } catch (err) {}
        document.body.removeChild(textArea);
        return;
    }
    navigator.clipboard.writeText(code).then(function() {
        showCopiedOp(btn);
    });
}

function showCopiedOp(btn) {
    var span = btn.querySelector('span');
    var original = span ? span.innerText : 'Copy';
    if (span) span.innerText = 'Copied!';
    btn.style.borderColor = '#10b981';
    btn.style.color = '#34d399';
    setTimeout(function() {
        if (span) span.innerText = original;
        btn.style.borderColor = '';
        btn.style.color = '';
    }, 2000);
}
</script>
