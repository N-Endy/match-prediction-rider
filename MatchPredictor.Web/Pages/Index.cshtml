@page
@model MatchPredictor.Web.Pages.IndexModel

@{
    ViewData["Title"] = "Smart Daily Football Predictions";
    ViewData["Description"] = "MatchPredictor publishes calibrated daily football picks, selection lists, and an honest settled-results track record — an informational statistics tool, not a bookmaker.";
}

<section class="mp-hero">
    <div class="mp-hero-badge">
        <span class="mp-live-dot"></span>
        Updated daily
    </div>
    <h1>Smart Football<br>Predictions</h1>
    <p>Today’s BTTS, Over 2.5, Under 2.5, Straight Win, and Draw card — analysed, threshold-gated, and published twice a day.</p>
    <div class="mp-hero-actions">
        <a href="/predictions/btts" class="mp-hero-cta">
            Open today’s card
        </a>
        <a href="/results" class="mp-hero-cta mp-hero-cta-secondary">
            Settled results
        </a>
    </div>
</section>

<div class="mp-container">
    <h2 class="mp-section-heading">Today’s Predictions</h2>
    <p class="mp-section-subtitle">Pick a market to see the published card</p>

    <div class="mp-category-grid">
        <a href="/predictions/btts" class="mp-category-card">
            <div class="mp-category-icon mp-icon-btts">⚽</div>
            <div class="mp-category-info">
                <h3>Both Teams to Score</h3>
                <p>Matches where both teams are likely to score</p>
            </div>
        </a>
        <a href="/predictions/over2" class="mp-category-card">
            <div class="mp-category-icon mp-icon-over">🎯</div>
            <div class="mp-category-info">
                <h3>Over 2.5 Goals</h3>
                <p>Matches likely to have 3 or more total goals</p>
            </div>
        </a>
        <a href="/predictions/straightwin" class="mp-category-card">
            <div class="mp-category-icon mp-icon-win">🏆</div>
            <div class="mp-category-info">
                <h3>Straight Win</h3>
                <p>Strong home or away win predictions</p>
            </div>
        </a>
        <a href="/predictions/draw" class="mp-category-card">
            <div class="mp-category-icon mp-icon-draw">🤝</div>
            <div class="mp-category-info">
                <h3>Draw</h3>
                <p>Low-separation fixtures where the model sees draw value</p>
            </div>
        </a>
        <a href="/predictions/under2" class="mp-category-card">
            <div class="mp-category-icon mp-icon-under">🧊</div>
            <div class="mp-category-info">
                <h3>Under 2.5 Goals</h3>
                <p>Matches likely to stay at two goals or fewer</p>
            </div>
        </a>
    </div>

    <div class="mp-home-block">
        <h2 class="mp-section-heading">How It Works</h2>
        <p class="mp-section-subtitle">From market inputs to a settled track record</p>

        <div class="mp-features">
            <div class="mp-feature-card">
                <div class="mp-feature-icon mp-icon-over">📥</div>
                <h3>Collect market &amp; model inputs</h3>
                <p>We combine bookmaker prices (margin removed), statistical goals models, and checked third-party probability feeds for each fixture.</p>
            </div>
            <div class="mp-feature-card">
                <div class="mp-feature-icon mp-icon-btts">🧠</div>
                <h3>Blend, calibrate &amp; threshold</h3>
                <p>Signals are blended into one probability, calibrated for honesty, and published only when they clear a market-specific gate.</p>
            </div>
            <div class="mp-feature-card">
                <div class="mp-feature-icon mp-icon-cyan">📊</div>
                <h3>Settle &amp; learn</h3>
                <p>Finished matches update the public <a href="/results">results</a> record and feed overnight recalibration — past performance is not a guarantee.</p>
            </div>
        </div>

        <p class="mp-section-subtitle" style="margin-top: 1.5rem;">
            Read the full pipeline on <a href="/methodology">Methodology</a> ·
            Who we are on <a href="/about">About</a> ·
            Common questions in the <a href="/faq">FAQ</a>
        </p>
    </div>

    <div class="mp-home-ad">
        <partial name="_AdBanner" />
    </div>

    <div class="mp-home-cta">
        <a href="/betslips" class="mp-hero-cta">
            View today’s selection lists
        </a>
        <a href="/results" class="mp-hero-cta mp-hero-cta-secondary" style="margin-left: 0.75rem;">
            View settled results
        </a>
    </div>
</div>
