{
  "SportyBet": {
    "BaseUrl": "https://www.sportybet.com",
    "TennisSportId": "sr:sport:5",
    "MatchWinnerMarketId": "1"
  },
  "HealthDashboard": {
    "Username": "(set via environment variable or reuse Hangfire credentials)",
    "Password": "(set via environment variable or reuse Hangfire credentials)"
  },
  "Hangfire": {
    "Username": "(set via environment variable)",
    "Password": "(set via environment variable)"
  },
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "YourNamespace": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/prod/logfile-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ScrapingValues": {
    "ScrapingWebsite": "https://www.sports-ai.dev/predictions",
    "ScoresWebsite": "https://www.flashscore.mobi/tennis",
    "ScoresDayOffset": 0,
    "TennisScoresWebsite": "https://tennisscores.mobi",
    "TennisScoresResultsLookbackDays": 2,
    "ScrapingMaxWaitTime": 60,
    "ScrapingMaxWaitInterval": 1000,
    "PredictionsButtonSelector": "//*[@id=\"__next\"]/div/div[2]/main/div[1]/div[2]/div[2]/div[2]/div[1]/div/button",
    "PredictionsFileName": "predictions.xlsx",
    "TennisWorksheetName": "tennis",
    "AiScoreWebsite": "https://m.aiscore.com/tennis"
  },
  "EPPlus": {
    "ExcelPackage": {
      "License": "(set via environment variable)"
    }
  },
  "GroqApiKey": "(set via environment variable)",
  "GroqModel": "llama-3.3-70b-versatile",
  "AiChatAuth": {
    "Hours": 12
  },
  "ConnectionStrings": {
    "DefaultConnection": "Use env var ConnectionStrings__DefaultConnection for TennisPredictor Postgres"
  }
}
