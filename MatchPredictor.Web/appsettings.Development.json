{
  "AiLlm": {
    "Provider": "openai",
    "ApiKey": "(stored in user-secrets)",
    "Model": "gpt-5.6-luna",
    "BaseUrl": "https://api.openai.com/v1/",
    "TimeoutSeconds": 60,
    "Fallback": {
      "Provider": "gemini",
      "ApiKey": "(stored in user-secrets)",
      "Model": "gemini-3.5-flash",
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/"
    }
  },
  "GroqApiKey": "(stored in user-secrets)",
  "GroqModel": "openai/gpt-oss-120b",
  "ApiFootball": {
    "ApiKey": "(stored in user-secrets)",
    "BaseUrl": "https://v3.football.api-sports.io"
  },
  "SportyBet": {
    "BaseUrl": "https://www.sportybet.com",
    "SoccerSportId": "sr:sport:1",
    "Market1X2": "1",
    "MaxBookingSelections": 50
  },
  "Betslips": {
    "MaxSelectionsPerSlip": 50,
    "MaxSlipsPerPrediction": 3,
    "MinMinutesBeforeKickoff": 20,
    "OverProvisionFactor": 1.2,
    "MaxSingleMarketShare": 0.4,
    "BookingDelayMilliseconds": 750,
    "OverlapPenalty": 0.08,
    "DrawCandidatePoolSize": 12,
    "DrawSlipSize": 5,
    "BankerMinOdds": 5.0,
    "BankerMaxOdds": 10.0,
    "BankerFallbackMinOdds": 4.0,
    "BankerFallbackMaxOdds": 12.0,
    "BankerMinConfidence": 0.65,
    "BankerShortlistSize": 20,
    "BankerMaxPicks": 8
  },
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "YourNamespace": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/dev/logfile-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ScrapingValues": {
    "ScrapingWebsite": "https://www.sports-ai.dev/predictions",
    "PredictionsFileDownloadUrl": "https://www.sports-ai.dev/api/generate-excel",
    "ScoresWebsite": "https://www.flashscore.mobi",
    "ScrapingMaxWaitTime": 60,
    "ScrapingMaxWaitInterval": 1000,
    "PredictionsButtonSelector": "//*[@id=\"__next\"]/div/div[2]/main/div[1]/div[2]/div[2]/div[2]/div[1]/div/button",
    "PredictionsFileName": "predictions.xlsx",
    "AiScoreWebsite": "https://m.aiscore.com"
  },
  "EPPlus": {
    "ExcelPackage": {
      "License": "NonCommercialPersonal:MatchPredictor Development"
    }
  }
}
