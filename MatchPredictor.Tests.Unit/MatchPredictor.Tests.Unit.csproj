<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Coverage configuration for the math/ML + sourcing core. Activated by passing
    /p:CollectCoverage=true (CI does this). Coverage is scoped to the deterministic
    statistical core so the enforced line threshold stays meaningful; the build fails
    if coverage of these namespaces drops below the floor.
  -->
  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <Include>[MatchPredictor.Infrastructure]MatchPredictor.Infrastructure.Statistics.*,[MatchPredictor.Domain]MatchPredictor.Domain.Helpers.TeamNameNormalizer,[MatchPredictor.Domain]MatchPredictor.Domain.Sourcing.*,[MatchPredictor.Infrastructure]MatchPredictor.Infrastructure.Services.FlashScoreSourceHealthTracker</Include>
    <Threshold>80</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MatchPredictor.Application\MatchPredictor.Application.csproj" />
    <ProjectReference Include="..\MatchPredictor.Infrastructure\MatchPredictor.Infrastructure.csproj" />
    <ProjectReference Include="..\MatchPredictor.Domain\MatchPredictor.Domain.csproj" />
  </ItemGroup>

</Project>
